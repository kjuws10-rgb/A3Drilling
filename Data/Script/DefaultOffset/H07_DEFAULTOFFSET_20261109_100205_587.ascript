// Machining=Cross, CrossFullSize=0.1 mm, Vision=MarkFindSettingSingle
GalvoLaserOutput(GX_7, GalvoLaser.Off)
IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)
GalvoConfigureLaserOutputPeriod(GX_7, 0)
GalvoConfigureLaser1PulseWidth(GX_7, 0)
GalvoConfigureLaserMode(GX_7, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
PsoReset (GX_7)
GalvoConfigureLaserOutputPeriod(GX_7, 5)
MoveDelay([GX_7,GY_7], 1)
AnalogOutputSet(GX_7, 0, 10)
GalvoConfigureLaser1PulseWidth(GX_7, 5)
SetupAxisSpeed(GX_7, 1500)
SetupAxisSpeed(GY_7, 1500)
SetupCoordinatedSpeed(1500)
GalvoLaserOutput(GX_7, GalvoLaser.Off)
MoveRapid([GX_7, GY_7], [0, -0.05])
WaitForMotionDone([GX_7, GY_7])
MoveDelay([GX_7,GY_7], 0.8)
GalvoLaserOutput(GX_7, GalvoLaser.On)
MoveLinear([GX_7, GY_7], [0, 0.05])
WaitForMotionDone([GX_7, GY_7])
