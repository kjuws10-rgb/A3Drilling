// Machining=Cross, CrossFullSize=0.1 mm, Vision=MarkFindSettingSingle
GalvoLaserOutput(GX_1, GalvoLaser.Off)
IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)
GalvoConfigureLaserOutputPeriod(GX_1, 0)
GalvoConfigureLaser1PulseWidth(GX_1, 0)
GalvoConfigureLaserMode(GX_1, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
PsoReset (GX_1)
GalvoConfigureLaserOutputPeriod(GX_1, 5)
MoveDelay([GX_1,GY_1], 1)
AnalogOutputSet(GX_1, 0, 10)
GalvoConfigureLaser1PulseWidth(GX_1, 5)
SetupAxisSpeed(GX_1, 1500)
SetupAxisSpeed(GY_1, 1500)
SetupCoordinatedSpeed(1500)
GalvoLaserOutput(GX_1, GalvoLaser.Off)
MoveRapid([GX_1, GY_1], [0, -0.05])
WaitForMotionDone([GX_1, GY_1])
MoveDelay([GX_1,GY_1], 0.8)
GalvoLaserOutput(GX_1, GalvoLaser.On)
MoveLinear([GX_1, GY_1], [0, 0.05])
WaitForMotionDone([GX_1, GY_1])
GalvoLaserOutput(GX_1, GalvoLaser.Off)
MoveDelay([GX_1,GY_1], 0.2)
GalvoLaserOutput(GX_1, GalvoLaser.Off)
MoveRapid([GX_1, GY_1], [-0.05, 0])
WaitForMotionDone([GX_1, GY_1])
MoveDelay([GX_1,GY_1], 0.8)
GalvoLaserOutput(GX_1, GalvoLaser.On)
MoveLinear([GX_1, GY_1], [0.05, 0])
WaitForMotionDone([GX_1, GY_1])
GalvoLaserOutput(GX_1, GalvoLaser.Off)
MoveDelay([GX_1,GY_1], 0.2)
end
