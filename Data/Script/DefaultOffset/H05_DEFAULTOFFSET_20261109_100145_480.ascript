program
// Session=e967c18a098e46b98c3bd52ff8d6004e, TestId=d42f51be500745d5b61db79efa2ca39e
// Machining=Cross, CrossFullSize=0.1 mm, Vision=MarkFindSettingSingle
GalvoLaserOutput(GX5, GalvoLaser.Off)
IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)
GalvoConfigureLaserOutputPeriod(GX5, 0)
GalvoConfigureLaser1PulseWidth(GX5, 0)
GalvoConfigureLaserMode(GX5, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
PsoReset (GX5)
GalvoConfigureLaserOutputPeriod(GX5, 5)
MoveDelay([GX5,GY5], 1)
AnalogOutputSet(GX5, 0, 10)
GalvoConfigureLaser1PulseWidth(GX5, 5)
SetupAxisSpeed(GX5, 1500)
SetupAxisSpeed(GY5, 1500)
SetupCoordinatedSpeed(1500)
GalvoLaserOutput(GX5, GalvoLaser.Off)
MoveRapid([GX5, GY5], [0, -0.05])
WaitForMotionDone([GX5, GY5])
MoveDelay([GX5,GY5], 0.8)
GalvoLaserOutput(GX5, GalvoLaser.On)
MoveLinear([GX5, GY5], [0, 0.05])
WaitForMotionDone([GX5, GY5])
GalvoLaserOutput(GX5, GalvoLaser.Off)
MoveDelay([GX5,GY5], 0.2)
GalvoLaserOutput(GX5, GalvoLaser.Off)
MoveRapid([GX5, GY5], [-0.05, 0])
WaitForMotionDone([GX5, GY5])
MoveDelay([GX5,GY5], 0.8)
GalvoLaserOutput(GX5, GalvoLaser.On)
MoveLinear([GX5, GY5], [0.05, 0])
WaitForMotionDone([GX5, GY5])
GalvoLaserOutput(GX5, GalvoLaser.Off)
MoveDelay([GX5,GY5], 0.2)
end
