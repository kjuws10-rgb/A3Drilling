program
// Session=e967c18a098e46b98c3bd52ff8d6004e, TestId=7a591051a31340abb78fb368b5720d21
// Machining=Cross, CrossFullSize=0.1 mm, Vision=MarkFindSettingSingle
GalvoLaserOutput(GX6, GalvoLaser.Off)
IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)
GalvoConfigureLaserOutputPeriod(GX6, 0)
GalvoConfigureLaser1PulseWidth(GX6, 0)
GalvoConfigureLaserMode(GX6, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
PsoReset (GX6)
GalvoConfigureLaserOutputPeriod(GX6, 5)
MoveDelay([GX6,GY_6], 1)
AnalogOutputSet(GX6, 0, 10)
GalvoConfigureLaser1PulseWidth(GX6, 5)
SetupAxisSpeed(GX6, 1500)
SetupAxisSpeed(GY_6, 1500)
SetupCoordinatedSpeed(1500)
GalvoLaserOutput(GX6, GalvoLaser.Off)
MoveRapid([GX6, GY_6], [0, -0.05])
WaitForMotionDone([GX6, GY_6])
MoveDelay([GX6,GY_6], 0.8)
GalvoLaserOutput(GX6, GalvoLaser.On)
MoveLinear([GX6, GY_6], [0, 0.05])
WaitForMotionDone([GX6, GY_6])
GalvoLaserOutput(GX6, GalvoLaser.Off)
MoveDelay([GX6,GY_6], 0.2)
GalvoLaserOutput(GX6, GalvoLaser.Off)
MoveRapid([GX6, GY_6], [-0.05, 0])
WaitForMotionDone([GX6, GY_6])
MoveDelay([GX6,GY_6], 0.8)
GalvoLaserOutput(GX6, GalvoLaser.On)
MoveLinear([GX6, GY_6], [0.05, 0])
WaitForMotionDone([GX6, GY_6])
GalvoLaserOutput(GX6, GalvoLaser.Off)
MoveDelay([GX6,GY_6], 0.2)
end
