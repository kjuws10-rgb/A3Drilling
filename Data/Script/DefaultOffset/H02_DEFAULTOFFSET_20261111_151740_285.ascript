// Machining=Cross, CrossFullSize=1 mm, Vision=MarkFindSettingSingle
GalvoLaserOutput(GX2, GalvoLaser.Off)
IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)
GalvoConfigureLaserOutputPeriod(GX2, 0)
GalvoConfigureLaser1PulseWidth(GX2, 0)
GalvoConfigureLaserMode(GX2, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
PsoReset (GX2)
GalvoConfigureLaserOutputPeriod(GX2, 5)
MoveDelay([GX2,GY2], 1)
AnalogOutputSet(GX2, 0, 10)
GalvoConfigureLaser1PulseWidth(GX2, 5)
SetupAxisSpeed(GX2, 1500)
SetupAxisSpeed(GY2, 1500)
SetupCoordinatedSpeed(1500)
GalvoLaserOutput(GX2, GalvoLaser.Off)
MoveRapid([GX2, GY2], [0, -0.5])
WaitForMotionDone([GX2, GY2])
MoveDelay([GX2,GY2], 0.8)
