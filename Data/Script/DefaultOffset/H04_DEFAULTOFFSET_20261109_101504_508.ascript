// Machining=Cross, CrossFullSize=0.1 mm, Vision=MarkFindSettingSingle
GalvoLaserOutput(GX4, GalvoLaser.Off)
IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)
GalvoConfigureLaserOutputPeriod(GX4, 0)
GalvoConfigureLaser1PulseWidth(GX4, 0)
GalvoConfigureLaserMode(GX4, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
PsoReset (GX4)
GalvoConfigureLaserOutputPeriod(GX4, 5)
MoveDelay([GX4,GY4], 1)
AnalogOutputSet(GX4, 0, 10)
GalvoConfigureLaser1PulseWidth(GX4, 5)
SetupAxisSpeed(GX4, 1500)
SetupAxisSpeed(GY4, 1500)
SetupCoordinatedSpeed(1500)
GalvoLaserOutput(GX4, GalvoLaser.Off)
MoveRapid([GX4, GY4], [0, -0.05])
WaitForMotionDone([GX4, GY4])
MoveDelay([GX4,GY4], 0.8)
GalvoLaserOutput(GX4, GalvoLaser.On)
MoveLinear([GX4, GY4], [0, 0.05])
WaitForMotionDone([GX4, GY4])
GalvoLaserOutput(GX4, GalvoLaser.Off)
MoveDelay([GX4,GY4], 0.2)
GalvoLaserOutput(GX4, GalvoLaser.Off)
MoveRapid([GX4, GY4], [-0.05, 0])
WaitForMotionDone([GX4, GY4])
MoveDelay([GX4,GY4], 0.8)
GalvoLaserOutput(GX4, GalvoLaser.On)
MoveLinear([GX4, GY4], [0.05, 0])
WaitForMotionDone([GX4, GY4])
GalvoLaserOutput(GX4, GalvoLaser.Off)
MoveDelay([GX4,GY4], 0.2)
end
