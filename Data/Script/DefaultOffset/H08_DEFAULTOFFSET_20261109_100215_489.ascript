// Machining=Cross, CrossFullSize=0.1 mm, Vision=MarkFindSettingSingle
GalvoLaserOutput(GX_8, GalvoLaser.Off)
IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)
GalvoConfigureLaserOutputPeriod(GX_8, 0)
GalvoConfigureLaser1PulseWidth(GX_8, 0)
GalvoConfigureLaserMode(GX_8, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
PsoReset (GX_8)
GalvoConfigureLaserOutputPeriod(GX_8, 5)
MoveDelay([GX_8,GY_8], 1)
AnalogOutputSet(GX_8, 0, 10)
GalvoConfigureLaser1PulseWidth(GX_8, 5)
SetupAxisSpeed(GX_8, 1500)
SetupAxisSpeed(GY_8, 1500)
SetupCoordinatedSpeed(1500)
GalvoLaserOutput(GX_8, GalvoLaser.Off)
MoveRapid([GX_8, GY_8], [0, -0.05])
WaitForMotionDone([GX_8, GY_8])
