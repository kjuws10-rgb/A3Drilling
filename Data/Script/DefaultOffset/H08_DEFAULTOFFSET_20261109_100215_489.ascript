WaitForMotionDone([GX_8, GY_8])
MoveDelay([GX_8,GY_8], 0.8)
GalvoLaserOutput(GX_8, GalvoLaser.On)
MoveLinear([GX_8, GY_8], [0.05, 0])
WaitForMotionDone([GX_8, GY_8])
