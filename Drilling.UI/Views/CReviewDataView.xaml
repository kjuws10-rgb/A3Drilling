                                        Height="36"
                                        Margin="0,0,4,0"
                                        FontSize="11"
                                         ToolTip="선택한 Shot 위치로 이동"
                                         Style="{StaticResource SecondaryButton}"
                                         menu:CButtonCommandBehavior.Command="{Binding MoveToReinspectionShotCommand}" />
                                <Button Content="MOVE &amp; INSP SHOT"
                                        Height="36"
                                        Margin="4,0,0,0"
                                        FontSize="11"
                                         ToolTip="선택한 Beam 위치로 이동 후 검사"
                                         Style="{StaticResource SecondaryButton}"
                                         menu:CButtonCommandBehavior.Command="{Binding MoveAndInspectReinspectionShotCommand}" />
                            </UniformGrid>
                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
                                <Button Content="INSP ALL SHOT"
                                        Height="36"
                                        Margin="0,0,4,0"
                                        FontSize="11"
                                         ToolTip="목록의 Shot을 선택한 Beam 번호로 순차 검사"
                                         Style="{StaticResource PrimaryButton}"
                                         menu:CButtonCommandBehavior.Command="{Binding InspectAllReinspectionShotsCommand}" />
                                <Button Content="STOP"
                                        Height="36"
                                        Margin="4,0,0,0"
                                        FontSize="11"
                                         ToolTip="진행 중인 재검사 중지"
                                        Background="{DynamicResource ButtonDangerBrush}"
                                        BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                         Style="{StaticResource PrimaryButton}"
                                         menu:CButtonCommandBehavior.Command="{Binding StopReinspectionCommand}" />
                            </UniformGrid>
                        </Grid>

                        <Button Grid.Row="5"
                                Content="SAVE RESULT"
                                Height="38"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                FontWeight="SemiBold"
                                ToolTip="BASE 검사 결과의 분류와 CSV 형식을 유지하고 재검사 완료 Shot만 갱신한 새 파일을 저장합니다."
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButton}"
                                menu:CButtonCommandBehavior.Command="{Binding SaveReinspectionResultCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResultEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="KEY IN MODE"
                                    Height="38"
                                    Margin="0,0,4,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    CommandParameter="KEY_IN"
                                    menu:CButtonCommandBehavior.Command="{Binding SelectResultEditSubModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResultEditKeyInMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="COPY MODE"
                                    Height="38"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    CommandParameter="COPY"
                                    menu:CButtonCommandBehavior.Command="{Binding SelectResultEditSubModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResultEditCopyMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <Border Grid.Row="1"
                                Padding="8,6"
                                Margin="0,0,0,8"
                                Background="{DynamicResource GridHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RESULT EDIT"
                                           Style="{StaticResource PanelTitle}"
                                           FontSize="14"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ResultEditSelectionSummary}"
                                           Foreground="#F59E0B"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResultEditKeyInMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                      Grid.Row="0"
                                      ItemsSource="{Binding ResultEditKeyInItems}"
                                      SelectedItem="{Binding SelectedResultEditKeyInItem, Mode=TwoWay}"
                                      Style="{StaticResource ReviewDataResultGrid}"
                                      IsReadOnly="False"
                                      SelectionChanged="ReviewDataResultEditKeyInGrid_SelectionChanged"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="34" IsReadOnly="True" />
                                    <DataGridTextColumn Header="SHOT" Binding="{Binding Identity}" Width="*" MinWidth="92" IsReadOnly="True" />
                                    <DataGridTextColumn Header="ORG X" Binding="{Binding OriginalXText}" Width="58" IsReadOnly="True" />
                                    <DataGridTextColumn Header="ORG Y" Binding="{Binding OriginalYText}" Width="58" IsReadOnly="True" />
                                    <DataGridTextColumn Header="ORG J" Binding="{Binding OriginalJudge}" Width="48" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="EDIT X" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding EditedXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="26" Padding="3,1" TextAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="EDIT Y" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding EditedYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="26" Padding="3,1" TextAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="EDIT J" Width="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.ResultEditJudgeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding EditedJudge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Height="26"
                                                          Padding="3,0"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                        Content="DELETE"
                                        Height="34"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource SecondaryButton}"
                                        menu:CButtonCommandBehavior.Command="{Binding RemoveResultEditKeyInCommand}" />
                                <Button Grid.Column="1"
                                        Content="CLEAR"
                                        Height="34"
                                        Margin="4,0,0,0"
                                        Foreground="White"
                                        Background="{DynamicResource ButtonDangerBrush}"
                                        BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                        Style="{StaticResource SecondaryButton}"
                                        menu:CButtonCommandBehavior.Command="{Binding ClearResultEditKeyInCommand}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResultEditCopyMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="92" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding ResultEditCopySourceRows}"
                                      Style="{StaticResource ReviewDataResultGrid}"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SOURCE SHOT" Binding="{Binding Identity}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="X" Binding="{Binding OriginalXText}" Width="70" />
                                    <DataGridTextColumn Header="Y" Binding="{Binding OriginalYText}" Width="70" />
                                    <DataGridTextColumn Header="JUDGE" Binding="{Binding OriginalJudge}" Width="62" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="1" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                        Content="DELETE"
                                        Height="34"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource SecondaryButton}"
                                        menu:CButtonCommandBehavior.Command="{Binding RemoveResultEditCopyTargetCommand}" />
                                <Button Grid.Column="1"
                                        Content="CLEAR"
                                        Height="34"
                                        Margin="4,0,0,0"
                                        Foreground="White"
                                        Background="{DynamicResource ButtonDangerBrush}"
                                        BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                        Style="{StaticResource SecondaryButton}"
                                        menu:CButtonCommandBehavior.Command="{Binding ClearResultEditCopyTargetsCommand}" />
                            </Grid>
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding ResultEditCopyTargets}"
                                      SelectedItem="{Binding SelectedResultEditCopyTarget, Mode=TwoWay}"
                                      Style="{StaticResource ReviewDataResultGrid}"
                                      SelectionChanged="ReviewDataResultEditCopyGrid_SelectionChanged"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="34" />
                                    <DataGridTextColumn Header="COPY SHOT" Binding="{Binding Identity}" Width="*" MinWidth="96" />
                                    <DataGridTextColumn Header="ORG X" Binding="{Binding OriginalXText}" Width="58" />
                                    <DataGridTextColumn Header="ORG Y" Binding="{Binding OriginalYText}" Width="58" />
                                    <DataGridTextColumn Header="ORG J" Binding="{Binding OriginalJudge}" Width="48" />
                                    <DataGridTextColumn Header="EDIT X" Binding="{Binding EditedXText}" Width="58" />
                                    <DataGridTextColumn Header="EDIT Y" Binding="{Binding EditedYText}" Width="58" />
                                    <DataGridTextColumn Header="EDIT J" Binding="{Binding EditedJudge}" Width="52" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <UniformGrid Grid.Row="3" Columns="3">
                                <Button Content="COPY X/Y"
                                        Height="36"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource SecondaryButton}"
                                        menu:CButtonCommandBehavior.Command="{Binding CopyResultEditXyCommand}" />
                                <Button Content="COPY JUDGE"
                                        Height="36"
                                        Margin="4,0"
                                        Style="{StaticResource SecondaryButton}"
                                        menu:CButtonCommandBehavior.Command="{Binding CopyResultEditJudgeCommand}" />
                                <Button Content="COPY ALL"
                                        Height="36"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        menu:CButtonCommandBehavior.Command="{Binding CopyResultEditAllCommand}" />
                            </UniformGrid>
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="0,8,0,0">
                            <Button Content="RESULT SAVE"
                                    Height="38"
                                    Margin="0"
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="{DynamicResource ButtonSuccessBrush}"
                                    BorderBrush="{DynamicResource StatusReadyBrush}"
                                    Style="{StaticResource SecondaryButton}"
                                    menu:CButtonCommandBehavior.Command="{Binding SaveResultEditCommand}" />
                        </Border>

                        <Border Grid.Row="4"
                                Padding="8,6"
                                Margin="0,8,0,0"
                                Background="{DynamicResource GridHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ResultEditStatusText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ResultEditStatusText}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDataPlaceholder}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                    <TextBlock Text="REVIEW DATA" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Button Content="DATA LOAD"
                            Width="190"
                            Height="44"
                            Margin="0,18,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            IsEnabled="{Binding CanLoadData}"
                            Style="{StaticResource PrimaryButton}"
                            menu:CButtonCommandBehavior.Command="{Binding LoadDataCommand}" />
                    <TextBlock Text="{Binding DataLoadHint}" Foreground="{Binding DataLoadHintBrush}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#D9172028" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDataLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="430" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LOADING REVIEW DATA" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <ProgressBar Value="{Binding LoadProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="16" Margin="0,16,0,8" />
                        <Grid>
                            <TextBlock Text="{Binding LoadProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding LoadProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
