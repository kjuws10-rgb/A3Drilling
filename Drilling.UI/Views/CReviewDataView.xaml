                                                Content="OFFSET APPLY"
                                                Height="38"
                                                Margin="0,0,5,0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource PrimaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding OffsetApplyCommand}" />
                                        <Button Grid.Column="1"
                                                Content="OFFSET ROLLBACK"
                                                Height="38"
                                                Margin="5,0"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Background="{DynamicResource ButtonWarningBrush}"
                                                BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                                Style="{StaticResource SecondaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding OffsetRollbackCommand}" />
                                        <Button Grid.Column="2"
                                                Content="OFFSET INIT"
                                                Height="38"
                                                Margin="5,0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Background="{DynamicResource ButtonDangerBrush}"
                                                BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                                Style="{StaticResource PrimaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding OffsetInitCommand}" />
                                        <Button Grid.Column="3"
                                                Content="CUR OFFSET VIEW"
                                                Height="38"
                                                Margin="5,0,0,0"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource SecondaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding OffsetViewCommand}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReinspectionMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                            Content="ADD"
                                            Height="38"
                                            Margin="0,0,5,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                                Style="{StaticResource PrimaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddReinspectionShotCommand}" />
                                        <Button Grid.Column="1"
                                            Content="ADD ALL SELECT"
                                            Height="38"
                                            Margin="5,0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                                Style="{StaticResource SecondaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddSelectedReinspectionShotsCommand}" />
                                        <Button Grid.Column="2"
                                            Content="ADD ALL NG"
                                            Height="38"
                                            Margin="5,0,0,0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="{DynamicResource ButtonWarningBrush}"
                                            BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                                Style="{StaticResource SecondaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddNgReinspectionShotsCommand}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsResultEditMode}" Value="True" />
                                                            <Condition Binding="{Binding IsResultEditKeyInMode}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="ADD"
                                                Height="38"
                                                Margin="0,0,5,0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource PrimaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddResultEditKeyInCommand}" />
                                        <Button Grid.Column="1"
                                                Content="ADD ALL SELECT"
                                                Height="38"
                                                Margin="5,0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource SecondaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddSelectedResultEditKeyInCommand}" />
                                        <Button Grid.Column="2"
                                                Content="ADD ALL NG"
                                                Height="38"
                                                Margin="5,0,0,0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Background="{DynamicResource ButtonWarningBrush}"
                                                BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                                Style="{StaticResource SecondaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddNgResultEditKeyInCommand}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsResultEditMode}" Value="True" />
                                                            <Condition Binding="{Binding IsResultEditCopyMode}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="SET TO SOURCE"
                                                Height="38"
                                                Margin="0,0,5,0"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Background="{DynamicResource ButtonWarningBrush}"
                                                BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                                Style="{StaticResource SecondaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddResultEditCopySourceCommand}" />
                                        <Button Grid.Column="1"
                                                Content="ADD TO COPY"
                                                Height="38"
                                                Margin="5,0,0,0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource PrimaryButton}"
                                                menu:CButtonCommandBehavior.Command="{Binding AddResultEditCopyTargetsCommand}" />
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding OffsetActionHint}"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding OffsetActionHint}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReinspectionMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsResultEditMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReinspectionMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RE-INSPECTION SHOT LIST"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="14"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ReinspectionSummary}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="DELETE"
                                    Height="34"
                                    Margin="0,0,4,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource SecondaryButton}"
                                    menu:CButtonCommandBehavior.Command="{Binding DeleteReinspectionShotCommand}" />
                            <Button Grid.Column="1"
                                    Content="CLEAR"
                                    Height="34"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                     Foreground="White"
                                    Background="{DynamicResource ButtonDangerBrush}"
                                    BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                    Style="{StaticResource SecondaryButton}"
                                    menu:CButtonCommandBehavior.Command="{Binding ClearReinspectionShotsCommand}" />
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding ReinspectionShots}"
                                  SelectedItem="{Binding SelectedReinspectionShot, Mode=OneWay}"
                                  Style="{StaticResource ReviewDataResultGrid}"
                                  IsReadOnly="False"
                                  SelectionChanged="ReviewDataReinspectionGrid_SelectionChanged"
                                  Margin="0,0,0,8">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#F6C453" />
                                            <Setter Property="Foreground" Value="#17212B" />
                                        </Trigger>
                                         <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                             <Setter Property="Background" Value="#4ADE80" />
                                             <Setter Property="Foreground" Value="#10251A" />
                                             <DataTrigger.EnterActions>
                                                 <BeginStoryboard x:Name="ReinspectionRunningPulse">
                                                     <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                         <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                          From="1.0"
                                                                          To="0.55"
                                                                          Duration="0:0:0.42" />
                                                     </Storyboard>
                                                 </BeginStoryboard>
                                             </DataTrigger.EnterActions>
                                             <DataTrigger.ExitActions>
                                                 <RemoveStoryboard BeginStoryboardName="ReinspectionRunningPulse" />
                                             </DataTrigger.ExitActions>
                                         </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="44" IsReadOnly="True" />
                                <DataGridTextColumn Header="CELL" Binding="{Binding Cell}" Width="58" IsReadOnly="True" />
                                <DataGridTextColumn Header="SHOT" Binding="{Binding ShotName}" Width="*" MinWidth="52" IsReadOnly="True" />
                                <DataGridTextColumn Header="HEAD" Binding="{Binding Head}" Width="58" IsReadOnly="True" />
