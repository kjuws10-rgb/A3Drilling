                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource PanelBorderBrush}"
                                             TextAlignment="Center" FontSize="10" />
                                    <TextBlock Grid.Column="4" Text="UNIT" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding ScatterPlotGridUnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
