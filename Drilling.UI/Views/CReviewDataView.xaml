<UserControl x:Class="Drilling.UI.Views.CReviewDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu"
             IsVisibleChanged="ReviewDataView_IsVisibleChanged"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <HierarchicalDataTemplate x:Key="ReviewResultNodeTemplate" ItemsSource="{Binding Children}">
            <Grid MinHeight="28" ToolTip="{Binding Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Width="17" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="M3,1 L11,1 L16,6 L16,19 L3,19 Z M11,1 L11,6 L16,6 M6,10 L13,10 M6,13 L13,13 M6,16 L11,16" />
                            <Setter Property="Fill" Value="{DynamicResource GridBackgroundBrush}" />
                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="StrokeThickness" Value="1.3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Data" Value="M1,3 L8,3 L10,6 L19,6 L19,17 L1,17 Z" />
                                    <Setter Property="Fill" Value="#F2CB62" />
                                    <Setter Property="Stroke" Value="#B98B22" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="11" FontWeight="SemiBold" Margin="12,0,4,0" VerticalAlignment="Center" />
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="ReviewResultTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReviewDataResultGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" MinWidth="720" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="REFRESH" Width="100" Height="34" Margin="0" FontSize="13" Style="{StaticResource SecondaryButton}" menu:CButtonCommandBehavior.Command="{Binding RefreshCommand}" />
                        <TextBlock Text="REVIEW RESULTS" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TreeView x:Name="ReviewResultsTree"
                              Grid.Row="1"
                              ItemsSource="{Binding Nodes}"
                              ItemTemplate="{StaticResource ReviewResultNodeTemplate}"
                              ItemContainerStyle="{StaticResource ReviewResultTreeItemStyle}"
                              FontSize="14"
                              Padding="6"
                              Background="{DynamicResource GridBackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource GridLineBrush}"
                              SelectedItemChanged="ReviewResultsTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </TreeView.ItemsPanel>
                    </TreeView>
                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" ToolTip="{Binding StatusText}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RESULT SUMMARY" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedStatus}" Foreground="{Binding SelectedStatusBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedDetails}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              Style="{StaticResource PlainDataGrid}"
                              FontSize="11"
                              RowHeight="25"
                              ColumnHeaderHeight="28"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="118" />
                            <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="2">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLoadedData}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" MinWidth="340" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="6*" MinWidth="430" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GLASS-CELL VIEW" Style="{StaticResource PanelTitle}" FontSize="14" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding GlassSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" Background="#4ADE80" BorderBrush="#86EFAC" BorderThickness="1" />
                                    <TextBlock Text="RESULT CELL" Margin="4,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                    <Border Width="10" Height="10" Background="#F6C453" BorderBrush="#FFF0B3" BorderThickness="1" />
                                    <TextBlock Text="SELECTED" Margin="4,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="4" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="{Binding GlassSurfaceWidth}" Height="{Binding GlassSurfaceHeight}">
                                        <Image Source="{Binding GlassPreviewImage}" Width="{Binding GlassSurfaceWidth}" Height="{Binding GlassSurfaceHeight}" Stretch="Fill" IsHitTestVisible="False" />
                                        <ItemsControl ItemsSource="{Binding CellLabels}" Width="{Binding GlassSurfaceWidth}" Height="{Binding GlassSurfaceHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding CellNo}"
                                                            Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            FontSize="9"
                                                            FontWeight="Bold"
                                                            IsEnabled="{Binding IsIncluded}"
                                                            CommandParameter="{Binding CellNo}"
                                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsIncluded}" Value="True">
                                                                        <Setter Property="Background" Value="#237A4B" />
                                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                                        <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#F6C453" />
                                                                        <Setter Property="Foreground" Value="#17212B" />
                                                                        <Setter Property="BorderBrush" Value="#FFF0B3" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SHOT VIEW" Style="{StaticResource PanelTitle}" FontSize="14" Margin="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCellTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedShotTitle}" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" HorizontalAlignment="Center" />
                                </StackPanel>
                                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#64748B" />
                                    <TextBlock Text="SHOT" Margin="3,0,7,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" VerticalAlignment="Center" />
                                    <Ellipse Width="7" Height="7" Fill="#22C55E" />
                                    <TextBlock Text="RESULT" Margin="3,0,7,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" VerticalAlignment="Center" />
                                    <Grid Width="8" Height="8">
                                        <Border Height="1.5" Background="#EF4444" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform></Border>
                                        <Border Height="1.5" Background="#EF4444" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-45" /></Border.RenderTransform></Border>
                                    </Grid>
                                    <TextBlock Text="MASKING" Margin="3,0,7,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" VerticalAlignment="Center" />
                                    <Border Width="7" Height="7" Background="#A855F7" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform></Border>
                                    <TextBlock Text="CHESS" Margin="3,0,7,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" VerticalAlignment="Center" />
                                    <Ellipse Width="8" Height="8" Fill="#F6C453" Stroke="#B7791F" StrokeThickness="1" />
                                    <TextBlock Text="SELECTED" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" VerticalAlignment="Center" />
                                </WrapPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="4" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="{Binding ShotMapSurfaceWidth}" Height="{Binding ShotMapSurfaceHeight}" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="ReviewDataShotMap_MouseLeftButtonDown">
                                        <Image Source="{Binding ShotMapImage}" Stretch="Fill" IsHitTestVisible="False" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="138" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RESULT DATA GRID" Style="{StaticResource PanelTitle}" FontSize="15" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedShotDetail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="13" Height="8" Background="#27343F" BorderBrush="#6D8192" BorderThickness="1" />
                                <TextBlock Text="RESULT ROW" Margin="4,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                <Border Width="13" Height="8" Background="#F6C453" BorderBrush="#FFF0B3" BorderThickness="1" />
                                <TextBlock Text="SELECTED SHOT" Margin="4,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,0,0,7" Padding="8,6" Background="{DynamicResource GridHeaderBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedShotTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCellTitle}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <DataGrid x:Name="ReviewDataResultGrid"
                                  Grid.Row="2"
                                  ItemsSource="{Binding Rows}"
                                  SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                                  Style="{StaticResource ReviewDataResultGrid}"
                                  SelectionChanged="ReviewDataResultGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#F6C453" />
                                            <Setter Property="Foreground" Value="#17212B" />
                                            <Setter Property="BorderBrush" Value="#FFF0B3" />
                                            <Setter Property="BorderThickness" Value="3,0,0,1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HEAD" Binding="{Binding Head}" Width="52" />
                                <DataGridTextColumn Header="CELL" Binding="{Binding Cell}" Width="62" />
                                <DataGridTextColumn Header="SHOT" Binding="{Binding ShotName}" Width="54" />
                                <DataGridTextColumn Header="BEAM" Binding="{Binding Beam}" Width="52" />
                                <DataGridTextColumn Header="RESULT X (mm)" Binding="{Binding ResultXText}" Width="*" MinWidth="138" />
                                <DataGridTextColumn Header="RESULT Y (mm)" Binding="{Binding ResultYText}" Width="*" MinWidth="138" />
                                <DataGridTextColumn Header="JUDGE" Binding="{Binding Judge}" Width="72">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding JudgeBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="4"
                                Padding="10,8"
                                Background="{DynamicResource GridBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="3">
                                    <Button Content="OFFSET APPLY"
                                            Margin="0,0,5,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource PrimaryButton}"
                                            menu:CButtonCommandBehavior.Command="{Binding OffsetApplyCommand}" />
                                    <Button Content="OFFSET ROLLBACK"
                                            Height="38"
                                            Margin="5,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Background="{DynamicResource ButtonWarningBrush}"
                                            BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                            Style="{StaticResource SecondaryButton}"
                                            menu:CButtonCommandBehavior.Command="{Binding OffsetRollbackCommand}" />
                                    <Button Content="OFFSET INIT"
                                            Height="38"
                                            Margin="5,0,0,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Background="{DynamicResource ButtonDangerBrush}"
                                            BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                            Style="{StaticResource PrimaryButton}"
                                            menu:CButtonCommandBehavior.Command="{Binding OffsetInitCommand}" />
                                </UniformGrid>
                                <Button Grid.Row="1"
                                            Content="CUR REVIEW OFFSET VIEW"
                                            Height="36"
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource SecondaryButton}"
                                            menu:CButtonCommandBehavior.Command="{Binding OffsetViewCommand}" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding OffsetActionHint}"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding OffsetActionHint}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDataPlaceholder}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                    <TextBlock Text="REVIEW DATA" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Button Content="DATA LOAD"
                            Width="190"
                            Height="44"
                            Margin="0,18,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            IsEnabled="{Binding CanLoadData}"
                            Style="{StaticResource PrimaryButton}"
                            menu:CButtonCommandBehavior.Command="{Binding LoadDataCommand}" />
                    <TextBlock Text="{Binding DataLoadHint}" Foreground="{Binding DataLoadHintBrush}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#D9172028" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDataLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="430" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LOADING REVIEW DATA" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <ProgressBar Value="{Binding LoadProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="16" Margin="0,16,0,8" />
                        <Grid>
                            <TextBlock Text="{Binding LoadProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding LoadProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
