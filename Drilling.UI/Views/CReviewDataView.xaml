                                            menu:CButtonCommandBehavior.Command="{Binding ApplyScatterPlotScaleCommand}" />
                                </Grid>
                            </Border>

                            <DataGrid x:Name="ReviewDataResultGrid"
                                      Grid.Row="2"
                                      ItemsSource="{Binding Rows}"
                                      SelectedItem="{Binding SelectedRow, Mode=OneWay}"
