                                    <TextBlock Grid.Column="2" Text="MAX" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding ScatterPlotMaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
