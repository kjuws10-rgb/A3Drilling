<UserControl x:Class="Drilling.UI.Views.CDefaultOffsetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Drilling.UI.Views">
    <UserControl.Resources>
        <Style x:Key="SetupPanel" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="SetupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SetupCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="SetupValue" TargetType="TextBlock" BasedOn="{StaticResource SetupCaption}">
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="FontSize" Value="14" /></DataTrigger></Style.Triggers>
        </Style>
        <!-- A disabled native button repaints the selected blue background gray.
             Keep the Head's bound palette while commands remain disabled. -->
        <Style x:Key="SetupHeadButton" TargetType="Button">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SetupButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="5,0" /><Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Command" Value="{Binding ActionCommand}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Height" Value="28" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SetupGridText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineHeight" Value="14" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="12" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="EmptyCoordinateCell"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SetupGridText}">
            <Setter Property="Text" Value="{Binding EmptyXY}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Text" Value="- / -" /></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style></TextBlock></DataTemplate>
<DataTemplate x:Key="MeasuredCoordinateCell"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SetupGridText}"><Setter Property="Text" Value="{Binding Measured}" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Text" Value="{Binding CompactMeasured}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
<DataTemplate x:Key="TargetCoordinateCell"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SetupGridText}"><Setter Property="Text" Value="{Binding Target}" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Text" Value="{Binding CompactTarget}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
<DataTemplate x:Key="RecommendedCoordinateCell"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SetupGridText}"><Setter Property="Text" Value="{Binding Recommended}" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Text" Value="{Binding CompactRecommended}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
<DataTemplate x:Key="DeltaCoordinateCell"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SetupGridText}"><Setter Property="Text" Value="{Binding Delta}" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Text" Value="{Binding CompactDelta}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="DefaultLayoutRoot">
        <Grid.RowDefinitions><RowDefinition x:Name="RecipeRow" Height="48" /><RowDefinition Height="*" /><RowDefinition x:Name="ProgressRow" Height="62" /></Grid.RowDefinitions>
        <Border Style="{StaticResource SetupPanel}" Padding="12,4" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="CURRENT RECIPE" Style="{StaticResource SetupCaption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" x:Name="DefaultRecipeName" Text="{Binding RecipeName}" Style="{StaticResource SetupValue}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Background="#FFF2CB" Padding="15,3" CornerRadius="3" Margin="8,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding State}" Foreground="#795600" FontWeight="Bold" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border x:Name="DefaultPreviewPanel" Style="{StaticResource SetupPanel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="40" /><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="HEAD / GLASS PREVIEW" Style="{StaticResource SetupTitle}" />
                    <ItemsControl x:Name="DefaultHeadSelector" Grid.Row="1" ItemsSource="{Binding Heads}" Margin="0,5,0,3">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource SetupHeadButton}" Content="{Binding Name}" Background="{Binding Background}" Foreground="{Binding Foreground}" BorderBrush="#7C99B3"
                                    Margin="2,0" Padding="0" FontWeight="Bold" FontSize="12"
                                    Command="{Binding DataContext.SelectHeadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding HeadNo}" ToolTip="{Binding Detail}" />
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedHeadTitle}" Style="{StaticResource SetupValue}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding MachiningPositionText}" Foreground="{Binding MachiningPositionBrush}" ToolTip="{Binding MachiningPositionDetail}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="58*" /></Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="GLASS VIEW" Style="{StaticResource SetupTitle}" />
                                <TextBlock Grid.Column="1" Text="● 예상 가공점" FontSize="10" Foreground="{DynamicResource ButtonPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                <Viewbox x:Name="DefaultGlassPreview" Stretch="Uniform">
                                    <Grid Width="240" Height="400">
                                        <Image Source="{Binding GlassImage}" />
                                        <views:CReviewCameraOverlay DataContext="{Binding Camera}" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="MACHINING DETAIL" Style="{StaticResource SetupTitle}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                <Image x:Name="DefaultBeamPreview" Source="{Binding BeamImage}" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="{Binding GeometryText}" Style="{StaticResource SetupCaption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GeometryText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                    <Border Width="9" Height="9" Background="White" BorderBrush="#8092A3" BorderThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Text="가공 형상" Style="{StaticResource SetupCaption}" Margin="4,0,12,0" />
                                    <TextBlock Text="＋" Foreground="#4682B4" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="기준 중심" Style="{StaticResource SetupCaption}" Margin="3,0,12,0" />
                                    <Ellipse Width="9" Height="9" Fill="#2E8B57" VerticalAlignment="Center" />
                                    <TextBlock Text="실측 위치" Style="{StaticResource SetupCaption}" Margin="4,0,0,0" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BeamSummary}" Style="{StaticResource SetupCaption}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding PatternCaption}" Style="{StaticResource SetupCaption}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="실측 중심 (mm)" Style="{StaticResource SetupCaption}" /><TextBlock Text="{Binding MeasuredCenter}" Style="{StaticResource SetupCaption}" FontWeight="Bold" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="중심 오차 (mm)" Style="{StaticResource SetupCaption}" /><TextBlock Text="{Binding CenterError}" Style="{StaticResource SetupCaption}" FontWeight="Bold" /></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition x:Name="PositionRow" Height="94" /><RowDefinition x:Name="ActionRow" Height="118" /><RowDefinition Height="*" /><RowDefinition x:Name="ApplyRow" Height="62" /></Grid.RowDefinitions>
                <Border Style="{StaticResource SetupPanel}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="REFERENCE / POSITION" Style="{StaticResource SetupTitle}" />
                            <Border Background="{Binding ModeBrush}" HorizontalAlignment="Right" Padding="10,2" CornerRadius="2">
                                <TextBlock Text="{Binding Mode}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center" Margin="0,6,0,0">
                            <StackPanel><TextBlock Text="기판 중앙 X (mm)" Style="{StaticResource SetupCaption}" /><TextBlock Text="{Binding BoardReference}" Style="{StaticResource SetupValue}" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="Stage Y 현재 (mm)" Style="{StaticResource SetupCaption}" /><TextBlock Text="{Binding StageY}" Style="{StaticResource SetupValue}" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="Review X 현재 (mm)" Style="{StaticResource SetupCaption}" /><TextBlock Text="{Binding ReviewX}" Style="{StaticResource SetupValue}" Margin="0,3,0,0" /></StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" x:Name="DefaultActionPanel" Style="{StaticResource SetupPanel}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ACTION" Style="{StaticResource SetupTitle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="실행 방식" Margin="8,0" VerticalAlignment="Center" FontWeight="Bold" />
                            <ComboBox x:Name="DefaultExecutionMode" Grid.Column="2" ItemsSource="{Binding ExecutionModes}" SelectedItem="{Binding ExecutionMode, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Height="24" FontSize="12" VerticalContentAlignment="Center" />
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="3" Margin="-3,0,-3,0">
                            <Button Content="측정 조건 설정" CommandParameter="CONDITIONS" Style="{StaticResource SetupButton}" Height="Auto" />
                            <Button Content="선택 Head 가공" CommandParameter="FIRE" Style="{StaticResource SetupButton}" Height="Auto" />
                            <Button Content="선택 Head 측정" CommandParameter="MEASURE" Style="{StaticResource SetupButton}" Height="Auto" />
                        </UniformGrid>
                        <UniformGrid Grid.Row="3" Columns="2" Margin="-3,0,-3,0">
                            <Button Content="USE Head 실행" CommandParameter="ALL" Style="{StaticResource SetupButton}" Height="Auto" Background="{DynamicResource ButtonPrimaryBrush}" Foreground="White" />
                            <Button Content="STOP" CommandParameter="STOP" Style="{StaticResource SetupButton}" Height="Auto" Background="{DynamicResource ButtonDangerBrush}" Foreground="White" />
                        </UniformGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" x:Name="DefaultResultPanel" Style="{StaticResource SetupPanel}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition x:Name="ResultTitleRow" Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="12,0">
                            <TextBlock Text="HEAD RESULT" Style="{StaticResource SetupTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HeadMeasurementSummary}" Style="{StaticResource SetupCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <DataGrid x:Name="DefaultHeadResults" Grid.Row="1" ItemsSource="{Binding Heads}" SelectedItem="{Binding SelectedHead, Mode=TwoWay}"
                                  Style="{StaticResource PlainDataGrid}" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" RowHeight="38" ColumnHeaderHeight="38"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}"><Setter Property="Padding" Value="2,0" /></Style></DataGrid.CellStyle>
                            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" /><Setter Property="Foreground" Value="White" />
                                <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style></DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle><Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Detail}" /><Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDEDFB" /><Setter Property="Foreground" Value="#142F48" /></Trigger></Style.Triggers>
                            </Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Head" Width="0.6*" Binding="{Binding Name}" ElementStyle="{StaticResource SetupGridText}" />
                                <DataGridTemplateColumn Header="상태" Width="0.8*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" Style="{StaticResource SetupGridText}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.1*" CellTemplate="{StaticResource TargetCoordinateCell}"><DataGridTemplateColumn.Header><TextBlock Text="목표 중심&#10;X / Y (mm)" TextAlignment="Center" ToolTip="글래스 중심과 Head Gap 기준의 Review X / Stage Y 위치" /></DataGridTemplateColumn.Header></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.1*" CellTemplate="{StaticResource MeasuredCoordinateCell}"><DataGridTemplateColumn.Header><TextBlock Text="실측 중심&#10;X / Y (mm)" TextAlignment="Center" ToolTip="Vision 결과와 촬영 시 실제 위치로 구한 Review X / Stage Y 위치" /></DataGridTemplateColumn.Header></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.2*"><DataGridTemplateColumn.Header><TextBlock Text="현재 Default&#10;X / Y (mm)" TextAlignment="Center" /></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SetupGridText}">
                                    <Setter Property="Text" Value="{Binding Current}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Text" Value="{Binding CompactCurrent}" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.2*" CellTemplate="{StaticResource RecommendedCoordinateCell}"><DataGridTemplateColumn.Header><TextBlock Text="추천 Default&#10;X / Y (mm)" TextAlignment="Center" /></DataGridTemplateColumn.Header></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.1*" CellTemplate="{StaticResource DeltaCoordinateCell}"><DataGridTemplateColumn.Header><TextBlock Text="증감&#10;X / Y (mm)" TextAlignment="Center" /></DataGridTemplateColumn.Header></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource SetupPanel}" Margin="0,8,0,0" Padding="8,6">
                    <UniformGrid Columns="4">
                        <Button Content="추천 계산" CommandParameter="RECOMMEND" Style="{StaticResource SetupButton}" />
                        <Button Content="적용" CommandParameter="APPLY" Style="{StaticResource SetupButton}" Background="{DynamicResource ButtonSuccessBrush}" Foreground="White" />
                        <Button Content="새 가공 검증" CommandParameter="VERIFY" Style="{StaticResource SetupButton}" />
                        <Button Content="이전값 복원" CommandParameter="ROLLBACK" Style="{StaticResource SetupButton}" />
                    </UniformGrid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="18" /></Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{Binding Background}" CornerRadius="3" Padding="8,3" Margin="0,0,5,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Order}" FontWeight="Bold" Foreground="{Binding Foreground}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding Foreground}" FontSize="12" Margin="7,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding Foreground}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Style="{StaticResource SetupCaption}" FontSize="11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
