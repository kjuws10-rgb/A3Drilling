<UserControl x:Class="Drilling.UI.Views.CMainRunOptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu">
    <UserControl.Resources>
        <Style x:Key="RunChoiceButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="4,0"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <Border x:Name="ZeroLineOptionsBorder" Margin="0,0,10,0" Padding="12" MinHeight="218"
                BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="0선방어" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Row="1" Text="0선방어" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ItemsControl x:Name="ZeroLineChoices" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ZeroLineChoices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Style="{StaticResource RunChoiceButton}" Background="{Binding Background}" Foreground="{Binding Foreground}" CommandParameter="{Binding Value}"
                        menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectZeroLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="2" Text="현재그룹 / 전체그룹" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="CurrentGroupText" Grid.Row="2" Grid.Column="1" Text="{Binding GroupText}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}"/>
                <Button Grid.Row="2" Grid.Column="2" Content="INIT" Style="{StaticResource RunChoiceButton}" Background="{DynamicResource ButtonSecondaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                        menu:CButtonCommandBehavior.Command="{Binding InitGroupCommand}"/>
                <TextBlock Grid.Row="3" Text="후속 1줄검사" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ItemsControl x:Name="FollowUpChoices" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding FollowUpChoices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Style="{StaticResource RunChoiceButton}" Background="{Binding Background}" Foreground="{Binding Foreground}" CommandParameter="{Binding Value}"
                        menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectFollowUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <Border x:Name="ReviewOptionsBorder" Grid.Column="1" Padding="12" MinHeight="218" BorderThickness="1" IsEnabled="{Binding CanEditReview}"
                BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
                <DataTrigger Binding="{Binding CanEditReview}" Value="False"><Setter Property="Opacity" Value="0.55"/></DataTrigger>
            </Style.Triggers></Style></Border.Style>
            <StackPanel>
                <TextBlock Text="리뷰" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ItemsControl x:Name="ReviewMethodChoices" ItemsSource="{Binding ReviewMethodChoices}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Style="{StaticResource RunChoiceButton}" Background="{Binding Background}" Foreground="{Binding Foreground}" CommandParameter="{Binding Value}"
                        menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectReviewMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="ReviewLineChoices" ItemsSource="{Binding ReviewLineChoices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Style="{StaticResource RunChoiceButton}" Background="{Binding Background}" Foreground="{Binding Foreground}" CommandParameter="{Binding Value}"
                        menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectReviewLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ReviewInfoText}" FontSize="11" Margin="3,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Margin="3,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="즉시 재시도" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl x:Name="ReviewImmediateRetryChoices" Grid.Column="1" ItemsSource="{Binding ReviewImmediateRetryChoices}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Style="{StaticResource RunChoiceButton}" Height="28" FontSize="13"
                            Background="{Binding Background}" Foreground="{Binding Foreground}" CommandParameter="{Binding Value}"
                            menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectReviewImmediateRetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Grid Margin="3,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="재시도 횟수" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl x:Name="ReviewRetryChoices" Grid.Column="1" ItemsSource="{Binding ReviewRetryChoices}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Style="{StaticResource RunChoiceButton}" Height="28" FontSize="13"
                            Background="{Binding Background}" Foreground="{Binding Foreground}" CommandParameter="{Binding Value}"
                            menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectReviewRetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
