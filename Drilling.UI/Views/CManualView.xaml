                                        <TextBlock Text="REL" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />

                                        <ItemsControl ItemsSource="{Binding Axes}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Height="36" IsEnabled="{Binding CanMove}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AxisName, StringFormat=REL {0}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AxisName}" />
                                                <TextBox Grid.Column="1" Text="{Binding Relative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Double" ToolTip="REL (mm)" PreviewMouseLeftButtonDown="OpenTextInput" Style="{StaticResource ManualInput}" Height="32" Margin="4,0" FontSize="14" Padding="6,3" />
                                                <Button Grid.Column="2" Content="MOVE" Command="{Binding RelativeCommand}" Style="{StaticResource ManualCommandButton}" Height="34" FontSize="14" Margin="4,0,0,0" />
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,8,0">
