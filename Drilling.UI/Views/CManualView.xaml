<UserControl x:Class="Drilling.UI.Views.CManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu"
             xmlns:views="clr-namespace:Drilling.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ManualSmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ManualValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ManualInput" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ManualInputButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource HeaderNavPressedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualHeadButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualCommandButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualMofShiftOffsetButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualMofAlignStatusBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ToolTip" Value="{Binding Message}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonSuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonSuccessBorderBrush}" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualMofAlignStateText" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="불가능">
                    <Setter Property="Foreground" Value="Red" />
                </Trigger>
                <Trigger Property="Text" Value="미완료">
                    <Setter Property="Foreground" Value="Red" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualWorkspaceButton"
               TargetType="Button"
               BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="LaserActionButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ManualCreateButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
        </Style>

        <Style x:Key="ManualControllerResetButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBrush}" />
        </Style>

        <Style x:Key="ManualControllerAllHomeButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
        </Style>

        <Style x:Key="ManualResetSequenceButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
        </Style>

        <Style x:Key="ManualDeleteButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBrush}" />
        </Style>

        <Style x:Key="ManualRenameButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource ButtonWarningBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonWarningBorderBrush}" />
        </Style>

        <Style x:Key="ManualSaveButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource ButtonSuccessBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusReadyBrush}" />
        </Style>

        <Style x:Key="ManualComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ManualComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource GridBackgroundBrush}"
                                                BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,36,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                                  TextElement.FontSize="14"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="10"
                                                      Height="5"
                                                      Stretch="Fill"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource GridBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingListText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding CurrentScreen.IsManualLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="52" />
            <RowDefinition Height="130" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MANUAL / CONTROL"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="Scanner, stage and vision manual operation"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="SCANNER"
                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.SelectManualWorkspaceCommand}"
                    CommandParameter="SCANNER"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen.Manual.IsScannerWorkspace}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="1"
                    Content="VISION"
                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.SelectManualWorkspaceCommand}"
                    CommandParameter="STAGE_VISION">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen.Manual.IsStageVisionWorkspace}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="ManualReviewTab" Grid.Column="2" Content="REVIEW" Margin="8,0,0,0"
                    Command="{Binding CurrentScreen.Manual.SelectManualWorkspaceCommand}" CommandParameter="REVIEW">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen.Manual.IsReviewWorkspace}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="3"
                    Content="RESET SEQUENCE"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Visibility="{Binding CurrentScreen.Manual.IsScannerWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"
                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.ShowResetSequenceCommand}"
                    Style="{StaticResource ManualResetSequenceButton}" />
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource PanelBorder}"
                Padding="14,10"
                Visibility="{Binding CurrentScreen.Manual.IsScannerWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Text="Head Select (Multiple selection)" Style="{StaticResource PanelTitle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel.Resources>
                            <Style x:Key="HeadSelectionButton" TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                                <Setter Property="Width" Value="64" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Margin" Value="6,0,0,0" />
                            </Style>
                        </StackPanel.Resources>
                        <Button Content="ALL" Style="{StaticResource HeadSelectionButton}" Command="{Binding CurrentScreen.Manual.SelectManualHeadsCommand}" CommandParameter="ALL" />
                        <Button Content="홀수" Style="{StaticResource HeadSelectionButton}" Command="{Binding CurrentScreen.Manual.SelectManualHeadsCommand}" CommandParameter="ODD" />
                        <Button Content="짝수" Style="{StaticResource HeadSelectionButton}" Command="{Binding CurrentScreen.Manual.SelectManualHeadsCommand}" CommandParameter="EVEN" />
                        <Button Content="CLEAR" Style="{StaticResource HeadSelectionButton}" Command="{Binding CurrentScreen.Manual.SelectManualHeadsCommand}" CommandParameter="CLEAR" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding CurrentScreen.Manual.HeadGroups}"
                              Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,0"
                                    Padding="4"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource ManualSmallText}"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding Heads}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Manual.SelectHeadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding HeadNo}"
                                                        Style="{StaticResource ManualHeadButton}">
                                                    <Border Margin="3,0"
                                                            Padding="8,6"
                                                            MinHeight="40"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="26" />
                                                            </Grid.RowDefinitions>

                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="17"
                                                                         Height="17"
                                                                         RadiusX="2" RadiusY="2"
                                                                         Stroke="{DynamicResource TextPrimaryBrush}"
                                                                         StrokeThickness="2"
                                                                         VerticalAlignment="Center">
                                                                    <Rectangle.Style>
                                                                        <Style TargetType="Rectangle">
                                                                            <Setter Property="Fill" Value="Transparent" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Rectangle.Style>
                                                                </Rectangle>
                                                                <TextBlock Text="{Binding HeadName}"
                                                                           Margin="8,0,0,0"
                                                                           Foreground="{Binding TextBrush}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0"
              Visibility="{Binding CurrentScreen.Manual.IsScannerWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Controller" Width="180" Margin="0,0,8,0"
                        Command="{Binding CurrentScreen.Manual.SelectManualControlTabCommand}" CommandParameter="CONTROLLER">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentScreen.Manual.IsManualControllerTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Motion" Width="180" Margin="0,0,8,0"
                        Command="{Binding CurrentScreen.Manual.SelectManualControlTabCommand}" CommandParameter="MOTION">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentScreen.Manual.IsManualMotionTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Scan" Width="180" Margin="0,0,8,0"
                        Command="{Binding CurrentScreen.Manual.SelectManualControlTabCommand}" CommandParameter="SCAN">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentScreen.Manual.IsManualScanTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="PowerMeasure" Width="180" Margin="0,0,8,0"
                        Command="{Binding CurrentScreen.Manual.SelectManualControlTabCommand}" CommandParameter="POWERMEASURE">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentScreen.Manual.IsManualPowerMeasureTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="MOF" Width="180" Margin="0,0,8,0"
                        Command="{Binding CurrentScreen.Manual.SelectManualControlTabCommand}" CommandParameter="MOF">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ManualWorkspaceButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentScreen.Manual.IsManualMofTab}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" Visibility="{Binding CurrentScreen.Manual.IsManualMofTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <views:CManualMofView Margin="0,0,0,8" DataContext="{Binding CurrentScreen.Manual.MofPreview}" />
                    <Border x:Name="ManualMofAutomationStatusPanel" Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="8">
                        <views:CAutomationControllerStatusView IsCompact="True" TaskColumns="1"
                            DataContext="{Binding CurrentScreen.Manual.AutomationControllerStatusItems}" />
                    </Border>
                </Grid>
                <Border x:Name="ManualMofActionPanel" Grid.Column="1"
                        Margin="0,0,4,0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Action" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <Grid Grid.Row="1" x:Name="ManualMofActionBody">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="19*" />
                                <RowDefinition Height="43*" />
                                <RowDefinition Height="38*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="8,4">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="1. Stage Align" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Grid Grid.Row="1" DataContext="{Binding CurrentScreen.Manual.MofAlign}" Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" MinHeight="30" />
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="*" MinHeight="30" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ManualMofAlignAvailableBox" DataContext="{Binding Availability}"
                                                Style="{StaticResource ManualMofAlignStatusBox}">
                                            <DockPanel>
                                                <TextBlock Text="ALIGN 가능 상태" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource ManualMofAlignStateText}" FontSize="15" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="ManualMofAlignCompleteBox" Grid.Column="2" DataContext="{Binding Completion}"
                                                Style="{StaticResource ManualMofAlignStatusBox}">
                                            <DockPanel>
                                                <TextBlock Text="ALIGN 완료 상태" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource ManualMofAlignStateText}" FontSize="15" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="ManualMofAlignRequestBox" Grid.Row="2" DataContext="{Binding Request}"
                                                Style="{StaticResource ManualMofAlignStatusBox}">
                                            <DockPanel>
                                                <TextBlock Text="ALIGN 요청 상태" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <Grid Grid.Row="2" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ManualMofAlignRequestButton" Content="ALIGN REQUEST"
                                                    Command="{Binding RequestCommand}" Style="{StaticResource ManualCommandButton}" FontSize="13" />
                                            <Button x:Name="ManualMofAlignCancelButton" Grid.Column="2" Content="REQUEST CANCEL"
                                                    Command="{Binding CancelRequestCommand}" Style="{StaticResource ManualCommandButton}" FontSize="13"
                                                    Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBorderBrush}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="ManualMofReadyMoveSection" Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="8,4">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="2. Stage Ready Pos Move" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <views:CManualMofStageView Grid.Row="1" Margin="0,4,0,0"
                                                              DataContext="{Binding CurrentScreen.Manual.MofStage}" />
                                </Grid>
                            </Border>
                            <Border x:Name="ManualMofRunSection" Grid.Row="2" BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="8,4">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="3*" MinHeight="68" /><RowDefinition Height="4*" MinHeight="88" /></Grid.RowDefinitions>
                                    <TextBlock Text="3. MOF" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Grid Grid.Row="1" DataContext="{Binding CurrentScreen.Manual.MofRun}" Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="7*" MinHeight="28" /><RowDefinition Height="4" /><RowDefinition Height="9*" MinHeight="36" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.7*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.ColumnSpan="5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border x:Name="ManualMofInterlockState" Background="{Binding StateBackground}" CornerRadius="3" Padding="8,3"
                                                    ToolTip="{Binding SelectionText}">
                                                <DockPanel TextElement.Foreground="White">
                                                    <TextBlock Text="InterLock" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding State}" FontSize="14" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <Button x:Name="ManualMofInterlockListButton" Grid.Column="2" Content="InterLock List"
                                                    Command="{Binding InterlockListCommand}" Style="{StaticResource ManualCommandButton}" FontSize="13"
                                                    ToolTip="{Binding SelectionText}" />
                                        </Grid>
                                        <Button x:Name="ManualMofRunButton" Grid.Row="2" Grid.Column="2" Content="MOF RUN"
                                                Command="{Binding RunCommand}" Style="{StaticResource ManualCommandButton}" FontSize="14" ToolTip="{Binding ScriptDirectory}" />
                                        <Button x:Name="ManualMofStopButton" Grid.Row="2" Grid.Column="4" Content="MOF STOP"
                                                Command="{Binding StopCommand}" Style="{StaticResource ManualCommandButton}" FontSize="14"
                                                Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBorderBrush}" />
                                        <Button x:Name="ManualMofShiftOffsetButton" Grid.Row="2" Click="OpenShiftOffsetDialog"
                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:CManualView}}"
                                                Style="{StaticResource ManualMofShiftOffsetButton}"
                                                Visibility="{Binding IsManualShiftOffsetVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="SHIFT OFFSET" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock FontSize="10" HorizontalAlignment="Center">
                                                    <Run Text="X: " /><Run Text="{Binding ShiftOffsetX, Mode=OneWay}" /><Run Text=" mm" />
                                                    <Run Text="   /   " />
                                                    <Run Text="Y: " /><Run Text="{Binding ShiftOffsetY, Mode=OneWay}" /><Run Text=" mm" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="2" x:Name="ManualMofProgress" DataContext="{Binding CurrentScreen.Manual.MofRun}" Margin="0,4,0,0" ToolTip="{Binding Message}">
                                        <ItemsControl ItemsSource="{Binding Actions}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Background}" CornerRadius="3" Margin="2,1" Padding="6,3" ToolTip="{Binding Detail}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard x:Name="MofActionBlink"><Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.5" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever" />
                                                                            </Storyboard></BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="MofActionBlink" /></DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid TextElement.Foreground="White">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding CurrentScreen.Manual.IsManualPowerMeasureTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:CManualPowerMeasureView DataContext="{Binding CurrentScreen.Manual.PowerMeasurePanel}" />
            </Grid>

            <Grid x:Name="ManualControllerPanel" Grid.Row="1"
                  Visibility="{Binding CurrentScreen.Manual.IsManualControllerTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <ItemsControl x:Name="ManualControllerActions" ItemsSource="{Binding CurrentScreen.Manual.HeadGroups}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,0,4,6" Padding="6" Height="68"
                                        Background="{DynamicResource GridBackgroundBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource ManualSmallText}"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,0,0,5" />
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="RESET"
                                                Margin="2,0" Height="32" MinWidth="0" FontSize="12"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Manual.ResetAutomationControllerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ManualControllerResetButton}" />
                                        <Button Grid.Column="1" Content="ALL HOME"
                                                Margin="2,0" Height="32" MinWidth="0" FontSize="12"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Manual.HomeAutomationControllerAxesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ManualControllerAllHomeButton}" />
                                        <Button Grid.Column="2" Content="MOF Disable"
                                                Margin="2,0" Height="32" MinWidth="0" FontSize="12"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Manual.DisableControllerMofCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ManualControllerAllHomeButton}" />
                                        <Button Grid.Column="3" Content="HOME SPEED SET" Margin="2,0" Height="32" MinWidth="0" FontSize="12"
                                                Command="{Binding DataContext.CurrentScreen.Manual.OpenHomeSpeedSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource ManualControllerAllHomeButton}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Text="선택된 Head가 없습니다. 위에서 Head를 선택해 주세요." Margin="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ManualValueText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentScreen.Manual.ManualControllerHeads.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border x:Name="ManualControllerStatusGrid" Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="SCANNER AXIS STATUS / DIO CONTROL" Style="{StaticResource PanelTitle}" Margin="4,0,0,6" />
                            <ItemsControl ItemsSource="{Binding CurrentScreen.Manual.ManualControllerHeads}">
                                <ItemsControl.Resources>
                                    <Style x:Key="CompactControllerText" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="Margin" Value="1,0" />
                                    </Style>
                                    <Style x:Key="CompactControllerButton" TargetType="Button" BasedOn="{StaticResource ManualCommandButton}">
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Height" Value="28" />
                                        <Setter Property="Margin" Value="2,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </ItemsControl.Resources>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="2" Columns="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource GridBackgroundBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26" />
                                                    <RowDefinition Height="24" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="36" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding HeadName}" Margin="3,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                                                <Grid Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="34" /><ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="38" /><ColumnDefinition Width="46" /><ColumnDefinition Width="49" /><ColumnDefinition Width="41" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="AXIS" Style="{StaticResource CompactControllerText}" />
                                                    <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource CompactControllerText}" HorizontalAlignment="Center" FontSize="10" />
                                                    <TextBlock Grid.Column="2" Text="HOME" Style="{StaticResource CompactControllerText}" HorizontalAlignment="Center" FontSize="10" />
                                                    <TextBlock Grid.Column="3" Text="ERROR" Style="{StaticResource CompactControllerText}" HorizontalAlignment="Center" FontSize="10" />
                                                    <TextBlock Grid.Column="4" Grid.ColumnSpan="4" Text="CONTROL" Style="{StaticResource CompactControllerText}" HorizontalAlignment="Center" />
                                                </Grid>
                                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Axes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Rows="3" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}">
                                                                <Grid IsEnabled="{Binding IsControlEnabled}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="34" /><ColumnDefinition Width="60" />
                                                                        <ColumnDefinition Width="38" /><ColumnDefinition Width="46" /><ColumnDefinition Width="49" /><ColumnDefinition Width="41" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding AxisReference}" Style="{StaticResource CompactControllerText}" FontSize="10" FontWeight="Bold" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Enable}" Style="{StaticResource CompactControllerText}" Foreground="{Binding EnableBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Home}" Style="{StaticResource CompactControllerText}" Foreground="{Binding HomeBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Foreground="{Binding FaultBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="{Binding FaultDetail}" ToolTipService.ShowOnDisabled="True">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CompactControllerText}">
                                                                                <Setter Property="Text" Value="{Binding FaultState}" />
                                                                                <Style.Triggers><DataTrigger Binding="{Binding FaultState}" Value="FAULT"><Setter Property="Text" Value="ERROR" /></DataTrigger></Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button Grid.Column="4" Content="HOME" Style="{StaticResource CompactControllerButton}" Margin="1,0" Command="{Binding DataContext.CurrentScreen.Manual.ScannerAxisHomeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                    <Button Grid.Column="5" Content="ENABLE" Style="{StaticResource CompactControllerButton}" Margin="1,0" Background="{DynamicResource ButtonSuccessBrush}" BorderBrush="{DynamicResource StatusReadyBrush}" Command="{Binding DataContext.CurrentScreen.Manual.ScannerAxisEnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                    <Button Grid.Column="6" Content="DISABLE" Style="{StaticResource CompactControllerButton}" Margin="1,0" Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBorderBrush}" Command="{Binding DataContext.CurrentScreen.Manual.ScannerAxisDisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                    <Button Grid.Column="7" Content="CLEAR" Style="{StaticResource CompactControllerButton}" Margin="1,0" IsEnabled="{Binding CanClearFault}" Command="{Binding DataContext.CurrentScreen.Manual.ScannerAxisClearFaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid Grid.Row="3" Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="52" /><ColumnDefinition Width="57" /><ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="DIO" Style="{StaticResource CompactControllerText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Grid.Column="1" Background="{Binding DioBackground}" CornerRadius="2" Margin="2,3">
                                                        <TextBlock Text="{Binding DioState}" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Button Grid.Column="2" Content="READ" Command="{Binding ReadDioCommand}" IsEnabled="{Binding CanControlDio}" Style="{StaticResource CompactControllerButton}" />
                                                    <Button Grid.Column="3" Content="ON" Command="{Binding DioOnCommand}" IsEnabled="{Binding CanControlDio}" Style="{StaticResource CompactControllerButton}" Background="{DynamicResource ButtonSuccessBrush}" BorderBrush="{DynamicResource StatusReadyBrush}" />
                                                    <Button Grid.Column="4" Content="OFF" Command="{Binding DioOffCommand}" IsEnabled="{Binding CanControlDio}" Style="{StaticResource CompactControllerButton}" Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBorderBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
            </Grid>

            <ScrollViewer x:Name="ManualMotionPanel" Grid.Row="1" IsVisibleChanged="MotionVisibilityChanged" Tag="{Binding CurrentScreen.Manual.MotionPanel}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding CurrentScreen.Manual.IsManualMotionTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="CURRENT POSITION" Style="{StaticResource PanelTitle}" />
                            <Grid Height="30" Background="{DynamicResource GridBackgroundBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HEAD" Margin="12,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="X NAME" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="CUR(mm)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="Y NAME" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="4" Text="CUR(mm)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="5" Text="Z NAME" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="6" Text="CUR(mm)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                            <ListBox x:Name="MotionHeadTable" ItemsSource="{Binding CurrentScreen.Manual.ManualControllerHeads}"
                                     SelectedItem="{Binding CurrentScreen.Manual.MotionPanel.SelectedHead, Mode=TwoWay}"
                                     BorderThickness="0" Padding="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBackground" Background="Transparent"><ContentPresenter /></Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#C8E4FF" /></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HeadName}" HorizontalAlignment="Left" Margin="12,0" Foreground="{DynamicResource AccentTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding XAxis.AxisReference, TargetNullValue=-, FallbackValue=-}" ToolTip="{Binding XAxis.Detail}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding XCurrentPosition}" ToolTip="{Binding XAxis.Detail}" />
                                                <TextBlock Grid.Column="3" Text="{Binding YAxis.AxisReference, TargetNullValue=-, FallbackValue=-}" ToolTip="{Binding YAxis.Detail}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding YCurrentPosition}" ToolTip="{Binding YAxis.Detail}" />
                                                <TextBlock Grid.Column="5" Text="{Binding ZAxis.AxisReference, TargetNullValue=-, FallbackValue=-}" ToolTip="{Binding ZAxis.Detail}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="6" Text="{Binding ZCurrentPosition}" ToolTip="{Binding ZAxis.Detail}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="선택된 Head가 없습니다. 위에서 Head를 선택해 주세요." Margin="12">
