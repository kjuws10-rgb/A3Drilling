                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                        <Setter Property="Padding" Value="6,0" />
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="*" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Value" Width="120">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Button Content="{Binding Value}"
                                                            Click="OpenManualParameterInput"
                                                            Height="Auto"
                                                            Padding="6,0"
                                                            FontSize="11"
                                                            Margin="0"
                                                            FocusVisualStyle="{x:Null}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ManualInputButton}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <ComboBox ItemsSource="{Binding ValueOptions}"
