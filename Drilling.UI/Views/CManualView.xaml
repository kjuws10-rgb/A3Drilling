                                                <TextBlock Text="{Binding AxisName, StringFormat=JOG {0}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AxisName}" />
                                                <Button Grid.Column="1" Content="-" Tag="-" FontSize="22" Height="34" Margin="4,0,0,0" Style="{StaticResource ManualCommandButton}"
                                                        PreviewMouseLeftButtonDown="JogPressed" PreviewMouseLeftButtonUp="JogReleased" LostMouseCapture="JogCaptureLost" />
                                                <Button Grid.Column="2" Content="+" Tag="+" FontSize="22" Height="34" Margin="4,0,0,0" Style="{StaticResource ManualCommandButton}"
                                                        PreviewMouseLeftButtonDown="JogPressed" PreviewMouseLeftButtonUp="JogReleased" LostMouseCapture="JogCaptureLost" />
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Columns="3" Margin="0,12,0,0">
                                <Button Content="CENTER MOVE" Command="{Binding CenterCommand}" Height="44" FontSize="16" Margin="0,0,8,0" Style="{StaticResource ManualCommandButton}" />
                                <Button Content="Z RECIPE POSITION MOVE" Command="{Binding RecipeCommand}" Height="44" FontSize="16" Margin="0,0,8,0" Style="{StaticResource ManualCommandButton}" />
                                <Button Content="MOVE STOP" Command="{Binding StopCommand}" Height="44" FontSize="16" Style="{StaticResource ManualCommandButton}" Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBrush}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
