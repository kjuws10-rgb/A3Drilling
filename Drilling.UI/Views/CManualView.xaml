                                                <Button Grid.Column="2" Content="MOVE" Command="{Binding AbsoluteCommand}" Style="{StaticResource ManualCommandButton}" Height="34" FontSize="14" Margin="4,0,0,0" />
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,8,0">
