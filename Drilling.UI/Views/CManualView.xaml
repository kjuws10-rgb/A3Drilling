                                        <Style.Triggers><DataTrigger Binding="{Binding CurrentScreen.Manual.ManualControllerHeads.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,8,0,0" DataContext="{Binding CurrentScreen.Manual.MotionPanel}">
