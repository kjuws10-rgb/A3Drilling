                            <TextBlock Text="{Binding CurrentScreen.Manual.VisionProtocolCommandDescription}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="3"
                              Margin="0,10,0,0"
                              Visibility="{Binding CurrentScreen.Manual.VisionProtocolIsFlyingReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Inspection Type"
                                       Style="{StaticResource ManualSmallText}"
                                       VerticalAlignment="Center"
                                       ToolTip="Flying 검사 방식 구분 값" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CurrentScreen.Manual.VisionProtocolInspectionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ManualInput}"
                                     Height="34"
                                     FontFamily="Consolas"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="Flying 검사 방식 구분 값 (정수)"
                                       Style="{StaticResource ManualSmallText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="4"
                              Margin="0,10,0,0"
                              Visibility="{Binding CurrentScreen.Manual.VisionProtocolUsesMarkRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2. 검사 대상 위치 입력"
                                           Style="{StaticResource ManualSmallText}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Visibility="{Binding CurrentScreen.Manual.VisionProtocolIsFlyingReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CurrentScreen.Manual.VisionProtocolMarkRowCountText}"
                                               Style="{StaticResource ManualSmallText}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Button Content="+ ADD"
                                            menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.VisionProtocolAddMarkCommand}"
                                            Style="{StaticResource ManualCommandButton}"
                                            Height="26"
                                            Width="66"
                                            FontSize="11"
                                            Margin="0,0,6,0" />
                                    <Button Content="- REMOVE"
                                            menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.VisionProtocolRemoveMarkCommand}"
                                            Style="{StaticResource ManualCommandButton}"
                                            Height="26"
                                            Width="82"
                                            FontSize="11" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,6,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cell No" Style="{StaticResource ManualSmallText}" ToolTip="Cell 번호" />
                                <TextBlock Grid.Column="1" Text="DOE / Beam" Style="{StaticResource ManualSmallText}" Margin="5,0" ToolTip="DOE 또는 Beam 번호" />
                                <TextBlock Grid.Column="2" Text="Line No" Style="{StaticResource ManualSmallText}" Margin="5,0" ToolTip="검사 Line 번호" />
                                <TextBlock Grid.Column="3" Text="Index X" Style="{StaticResource ManualSmallText}" Margin="5,0" ToolTip="Shot의 X 위치 Index" />
                                <TextBlock Grid.Column="4" Text="Index Y" Style="{StaticResource ManualSmallText}" Margin="5,0" ToolTip="Shot의 Y 위치 Index" />
                                <TextBlock Grid.Column="5" Text="Head No" Style="{StaticResource ManualSmallText}" Margin="5,0,0,0" ToolTip="가공 Laser Head 번호" />
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          MaxHeight="112"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CurrentScreen.Manual.VisionProtocolMarkRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding CellNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ManualInput}" Height="32" FontSize="12" FontFamily="Consolas" />
                                                <TextBox Grid.Column="1" Text="{Binding DoeNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ManualInput}" Height="32" FontSize="12" FontFamily="Consolas" Margin="5,0" />
                                                <TextBox Grid.Column="2" Text="{Binding LineNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ManualInput}" Height="32" FontSize="12" FontFamily="Consolas" Margin="5,0" />
                                                <TextBox Grid.Column="3" Text="{Binding IndexX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ManualInput}" Height="32" FontSize="12" FontFamily="Consolas" Margin="5,0" />
                                                <TextBox Grid.Column="4" Text="{Binding IndexY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ManualInput}" Height="32" FontSize="12" FontFamily="Consolas" Margin="5,0" />
                                                <TextBox Grid.Column="5" Text="{Binding HeadNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ManualInput}" Height="32" FontSize="12" FontFamily="Consolas" Margin="5,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Grid.Row="3"
                                       Text="모든 입력값은 정수입니다. Index X/Y는 Shot의 위치 번호입니다."
                                       Style="{StaticResource ManualSmallText}"
                                       Margin="0,2,0,0" />
                        </Grid>

                        <Border Grid.Row="4"
                                Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{DynamicResource GridBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding CurrentScreen.Manual.VisionProtocolHasNoArguments, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="이 Command는 입력값이 없습니다. 바로 SEND를 누르세요."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <Grid Grid.Row="5" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="126" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="전송 문자열"
                                       Style="{StaticResource ManualSmallText}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="9,0">
                                <TextBlock Text="{Binding CurrentScreen.Manual.VisionProtocolRequestPreview}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding CurrentScreen.Manual.VisionProtocolRequestPreview}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Content="SEND"
                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.VisionProtocolSendCommand}"
                                    Style="{StaticResource ManualCommandButton}"
                                    Background="{DynamicResource ButtonSuccessBrush}"
                                    BorderBrush="{DynamicResource StatusReadyBrush}"
                                    Margin="10,0,0,0" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Communication Log (SEND / RECV / ERR)"
                                   Style="{StaticResource ManualSmallText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="CLEAR"
                                menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.VisionProtocolClearLogCommand}"
                                Style="{StaticResource ManualCommandButton}"
                                Height="28"
                                FontSize="11" />
                    </Grid>

                    <Border Grid.Row="4"
                            Background="{DynamicResource GridBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            Padding="6">
                        <ListBox ItemsSource="{Binding CurrentScreen.Manual.VisionProtocolLogs}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="NoWrap"
                                               Padding="2,3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


