<UserControl x:Class="Drilling.UI.Views.CAlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="AlarmActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="AlarmTrendViewButton" TargetType="Button" BasedOn="{StaticResource AlarmActionButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsEnabled" Value="{Binding CanEdit}" />
        </Style>
        <Style x:Key="AlarmHourViewButton" TargetType="Button" BasedOn="{StaticResource AlarmTrendViewButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsHourView}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AlarmCodeViewButton" TargetType="Button" BasedOn="{StaticResource AlarmTrendViewButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsCodeView}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AlarmTab" TargetType="TabItem">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="ColumnHeaderHeight" Value="42" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ColumnHeaderStyle"><Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextInvertedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="ContentTemplate"><Setter.Value>
                        <DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
                    </Setter.Value></Setter>
                </Style>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="AlarmCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="AlarmCenterCell" TargetType="TextBlock" BasedOn="{StaticResource AlarmCell}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="AlarmLevelCell" TargetType="TextBlock" BasedOn="{StaticResource AlarmCenterCell}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="HEAVY"><Setter Property="Foreground" Value="{DynamicResource ButtonDangerBorderBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="LIGHT"><Setter Property="Foreground" Value="{DynamicResource ButtonWarningBorderBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmEmptyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="24,48,24,24" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid Visibility="{Binding CurrentScreen.IsAlarmLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="ALARM" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TabControl x:Name="AlarmTabs" Grid.Row="1" SelectedIndex="{Binding CurrentScreen.Alarm.SelectedTabIndex, Mode=TwoWay}"
                    ItemContainerStyle="{StaticResource AlarmTab}" Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabControl.Template><ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <UniformGrid IsItemsHost="True" Rows="1" Columns="3" Width="636" Height="46"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate></TabControl.Template>
            <TabItem Header="CURRENT">
                <Border Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="ALARM RESET" Style="{StaticResource AlarmActionButton}"
                                        Background="{DynamicResource ButtonDangerBrush}" BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                        Foreground="{DynamicResource ButtonTextOnColorBrush}" Command="{Binding CurrentScreen.Alarm.AlarmResetCommand}" />
                                <Button Content="BUZZER OFF" Style="{StaticResource AlarmActionButton}" Margin="0"
                                        Command="{Binding CurrentScreen.Alarm.BuzzerOffCommand}" />
                            </StackPanel>
                            <TextBlock Text="CURRENT ALARM" Style="{StaticResource PanelTitle}" FontSize="18" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding CurrentScreen.Alarm.LogError}" Foreground="{DynamicResource ButtonDangerBorderBrush}" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentScreen.Alarm.LogError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <DataGrid x:Name="CurrentAlarmGrid" Grid.Row="2" Style="{StaticResource AlarmGrid}" ItemsSource="{Binding CurrentScreen.Alarm.CurrentAlarmRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="60" ElementStyle="{StaticResource AlarmCenterCell}" />
                                <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="90" ElementStyle="{StaticResource AlarmCenterCell}" />
                                <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="100" ElementStyle="{StaticResource AlarmLevelCell}" />
                                <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="150" ElementStyle="{StaticResource AlarmCenterCell}" />
                                <DataGridTextColumn Header="CAUSE" Binding="{Binding Cause}" Width="*" ElementStyle="{StaticResource AlarmCell}" />
                                <DataGridTextColumn Header="SOLUTION" Binding="{Binding Action}" Width="*" ElementStyle="{StaticResource AlarmCell}" />
                                <DataGridTextColumn Header="OCCURRED AT" Binding="{Binding Time}" Width="190" ElementStyle="{StaticResource AlarmCenterCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="현재 발생된 알람이 없습니다.">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AlarmEmptyText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentScreen.Alarm.CurrentAlarmRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="HISTORY/TREND">
                <Grid DataContext="{Binding CurrentScreen.Alarm.HistoryPanel}">
                    <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="FROM" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                        <DatePicker SelectedDate="{Binding From}" SelectedDateFormat="Short" Width="160" Height="36" FontSize="15" IsEnabled="{Binding CanEdit}" />
                        <TextBox x:Name="AlarmFromTime" Text="{Binding FromTime, UpdateSourceTrigger=PropertyChanged}" Width="134" Height="36" Margin="8,0,0,0"
                                 FontSize="15" VerticalContentAlignment="Center" TextAlignment="Center" IsEnabled="{Binding CanEdit}"
                                 ToolTip="시간 (24시간제): HH:mm:ss 또는 HH:mm:ss.fff" />
                        <TextBlock Text="TO" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="18,0,10,0" />
                        <DatePicker SelectedDate="{Binding Through}" SelectedDateFormat="Short" Width="160" Height="36" FontSize="15" IsEnabled="{Binding CanEdit}" />
                        <TextBox x:Name="AlarmThroughTime" Text="{Binding ThroughTime, UpdateSourceTrigger=PropertyChanged}" Width="134" Height="36" Margin="8,0,0,0"
                                 FontSize="15" VerticalContentAlignment="Center" TextAlignment="Center" IsEnabled="{Binding CanEdit}"
                                 ToolTip="시간 (24시간제): HH:mm:ss 또는 HH:mm:ss.fff" />
                        <Button Content="SEARCH" Command="{Binding SearchCommand}" Style="{StaticResource AlarmActionButton}" Margin="18,0,0,0" Height="36" />
                        <Button x:Name="AlarmLast24Hours" Content="LAST 24 HOUR" Command="{Binding Last24HoursCommand}" Style="{StaticResource AlarmActionButton}"
                                Margin="10,0,0,0" Width="180" Height="36" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="7*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="ALARM HISTORY" Style="{StaticResource PanelTitle}" FontSize="18" />
                            <DataGrid x:Name="AlarmHistoryGrid" Grid.Row="1" Style="{StaticResource AlarmGrid}" ItemsSource="{Binding Rows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="55" ElementStyle="{StaticResource AlarmCenterCell}" />
                                    <DataGridTextColumn Header="OCCURRED AT" Binding="{Binding Time}" Width="200" ElementStyle="{StaticResource AlarmCenterCell}" />
                                    <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="80" ElementStyle="{StaticResource AlarmCenterCell}" />
                                    <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="90" ElementStyle="{StaticResource AlarmLevelCell}" />
                                    <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="110" ElementStyle="{StaticResource AlarmCenterCell}" />
                                    <DataGridTextColumn Header="CAUSE" Binding="{Binding Cause}" Width="2*" ElementStyle="{StaticResource AlarmCell}" />
                                    <DataGridTextColumn Header="SOLUTION" Binding="{Binding Solution}" Width="*" ElementStyle="{StaticResource AlarmCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AlarmEmptyText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="AlarmHourView" Content="HOUR VIEW" Command="{Binding HourViewCommand}" Style="{StaticResource AlarmHourViewButton}" Margin="0,0,6,0" />
                                    <Button x:Name="AlarmCodeView" Content="CODE VIEW" Command="{Binding CodeViewCommand}" Style="{StaticResource AlarmCodeViewButton}" />
                                </StackPanel>
                                <TextBlock Text="TREND" Style="{StaticResource PanelTitle}" FontSize="18" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Grid.Row="1" Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="AlarmTrend" ItemsSource="{Binding Bars}" Margin="8">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid x:Name="TrendRow" Height="58" ToolTip="{Binding Detail}">
                                                    <Grid.RowDefinitions><RowDefinition x:Name="CauseRow" Height="24" /><RowDefinition x:Name="BarRow" Height="34" /></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TrendLabelColumn" Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Grid.RowSpan="2" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Cause}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                               TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <Grid Grid.Row="1" Grid.Column="1" Margin="4,5,4,9" Background="{DynamicResource GridAltBackgroundBrush}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding FilledWidth}" /><ColumnDefinition Width="{Binding EmptyWidth}" /></Grid.ColumnDefinitions>
                                                        <Border Background="{DynamicResource ButtonPrimaryBrush}" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Count, StringFormat={}{0:N0}}" Margin="0,0,0,4" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                                <DataTemplate.Triggers><DataTrigger Binding="{Binding IsHourly}" Value="True">
                                                    <Setter TargetName="TrendRow" Property="Height" Value="36" />
                                                    <Setter TargetName="CauseRow" Property="Height" Value="0" />
                                                    <Setter TargetName="BarRow" Property="Height" Value="36" />
                                                    <Setter TargetName="TrendLabelColumn" Property="Width" Value="110" />
                                                </DataTrigger></DataTemplate.Triggers>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="표시할 발생 이력이 없습니다.">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AlarmEmptyText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Bars.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="2" Text="{Binding TrendCaption}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="LIST">
                <Border Style="{StaticResource PanelBorder}" DataContext="{Binding CurrentScreen.Alarm.ListPanel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="ALARM LIST" Style="{StaticResource PanelTitle}" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource ButtonDangerBorderBrush}" Margin="0,0,0,8">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <DataGrid x:Name="AlarmListGrid" Grid.Row="2" Style="{StaticResource AlarmGrid}" ItemsSource="{Binding Rows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="60" ElementStyle="{StaticResource AlarmCenterCell}" />
                                <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="80" ElementStyle="{StaticResource AlarmCenterCell}" />
                                <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="140" ElementStyle="{StaticResource AlarmCenterCell}" />
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*" MinWidth="260" ElementStyle="{StaticResource AlarmCell}" />
                                <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="90" ElementStyle="{StaticResource AlarmLevelCell}" />
                                <DataGridTextColumn Header="CAUSE" Binding="{Binding Cause}" Width="1.6*" MinWidth="200" ElementStyle="{StaticResource AlarmCell}" />
                                <DataGridTextColumn Header="SOLUTION" Binding="{Binding Solution}" Width="*" MinWidth="150" ElementStyle="{StaticResource AlarmCell}" />
                                <DataGridTextColumn Header="CIM_ADRESS" Binding="{Binding CimAddress}" Width="140" ElementStyle="{StaticResource AlarmCenterCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
