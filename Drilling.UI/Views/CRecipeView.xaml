                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <Button Content="&gt;"
                                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.NextCellCommand}"
                                                    Style="{StaticResource RecipeTabButton}"
                                                    Width="30"
                                                    MinWidth="0"
                                                    Height="26"
                                                    Margin="5,0,0,0"
                                                    Padding="0"
                                                    FontSize="14"
                                                    ToolTip="Next Cell" />
                                        </StackPanel>
                                        <Button Content="← BACK"
                                                DockPanel.Dock="Left"
                                                menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.BackToCellPreviewCommand}"
                                                Style="{StaticResource RecipeTabButton}"
                                                Width="72"
                                                MinWidth="0"
                                                Height="26"
                                                Margin="0,0,10,0"
                                                FontSize="10" />
                                        <TextBlock Text="{Binding CurrentScreen.Recipe.SelectedCellShotGroupTitle}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextInvertedBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False">
                                <Grid Margin="8"
                                      Height="{Binding CurrentScreen.Recipe.CellShotMapPanelHeight}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="52*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="{Binding CurrentScreen.Recipe.CellShotMapGridRow}"
                                            Grid.RowSpan="{Binding CurrentScreen.Recipe.CellShotMapGridRowSpan}"
                                            Grid.Column="{Binding CurrentScreen.Recipe.CellShotMapGridColumn}"
                                            Grid.ColumnSpan="{Binding CurrentScreen.Recipe.CellShotMapGridColumnSpan}"
                                            Padding="7"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="28" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="CELL SHOT MAP"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <Grid x:Name="CellShotMapViewport"
                                                  Grid.Row="1"
                                                  Background="Transparent"
                                                  ClipToBounds="True"
                                                  Cursor="Hand"
                                                  PreviewMouseWheel="CellShotMap_PreviewMouseWheel"
                                                  PreviewMouseRightButtonDown="CellShotMap_PreviewMouseRightButtonDown">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="RESIZE" Click="CellShotMapResize_Click" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid x:Name="CellShotMapZoomContent"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="CellShotMapScaleTransform"
                                                                            ScaleX="1"
                                                                            ScaleY="1" />
                                                            <TranslateTransform x:Name="CellShotMapTranslateTransform" />
                                                        </TransformGroup>
                                                    </Grid.RenderTransform>
                                                    <Viewbox Stretch="Uniform">
                                                        <Grid x:Name="CellShotMapSurface"
                                                              Width="{Binding CurrentScreen.Recipe.CellShotMapSurfaceWidth}"
                                                              Height="{Binding CurrentScreen.Recipe.CellShotMapSurfaceHeight}"
                                                              Background="Transparent"
                                                              Cursor="Hand"
                                                              MouseLeftButtonDown="SelectShotGroupFromMap"
                                                              MouseMove="CellShotMapSurface_MouseMove"
                                                              MouseLeave="CellShotMapSurface_MouseLeave">
                                                            <Image Source="{Binding CurrentScreen.Recipe.CellShotMapImage}"
                                                                   Stretch="Fill"
                                                           IsHitTestVisible="False" />
                                                        </Grid>
                                                    </Viewbox>
                                                </Grid>
                                                <Border x:Name="CellShotMapHoverTip"
                                                        Panel.ZIndex="10"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="7,3"
                                                        Background="{DynamicResource PreviewHoverTipBackgroundBrush}"
                                                        BorderBrush="{DynamicResource PreviewHoverTipBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="2"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="CellShotMapHoverTipTranslateTransform" />
                                                    </Border.RenderTransform>
                                                    <TextBlock x:Name="CellShotMapHoverTipText"
                                                               Foreground="{DynamicResource PreviewHoverTipTextBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Fill="#FBBF24" />
                                                <TextBlock Text="SELECTED" Margin="5,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                                <TextBlock Text="×" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#D71920" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="MASKED" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                                <TextBlock Text="×" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#7A1FD0" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="CHESS" Margin="0,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="{Binding CurrentScreen.Recipe.CellShotDetailGridRow}"
                                          Grid.RowSpan="{Binding CurrentScreen.Recipe.CellShotDetailGridRowSpan}"
                                          Grid.Column="{Binding CurrentScreen.Recipe.CellShotDetailGridColumn}"
                                          Grid.ColumnSpan="{Binding CurrentScreen.Recipe.CellShotDetailGridColumnSpan}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="{Binding CurrentScreen.Recipe.CellShotDetailVerticalGap}" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="52*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="{Binding CurrentScreen.Recipe.SelectedShotDetailGridRow}"
                                                Grid.Column="{Binding CurrentScreen.Recipe.SelectedShotDetailGridColumn}"
                                                Grid.ColumnSpan="{Binding CurrentScreen.Recipe.SelectedShotDetailGridColumnSpan}"
                                                Padding="7"
                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="24" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="SELECTED SHOT DETAIL"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <Viewbox Grid.Row="1" Stretch="Uniform">
                                                    <Image Source="{Binding CurrentScreen.Recipe.SelectedShotDetailImage}"
                                                           Width="360"
                                                           Height="360"
                                                           Stretch="Fill" />
                                                </Viewbox>
                                                <StackPanel Grid.Row="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Ellipse Width="4" Height="4" Fill="#64748B" />
                                                    <TextBlock Text="PIXEL" Margin="4,0,10,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                                    <Ellipse Width="8" Height="8" Fill="#00723A" />
                                                    <TextBlock Text="DOE" Margin="4,0,10,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                                    <Ellipse Width="8" Height="8" Fill="#D71920" />
                                                    <TextBlock Text="MASKED" Margin="4,0,10,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                                    <Ellipse Width="8" Height="8" Fill="#FBBF24" />
                                                    <TextBlock Text="CENTER" Margin="4,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="{Binding CurrentScreen.Recipe.ShotInformationGridRow}"
                                                Grid.Column="{Binding CurrentScreen.Recipe.ShotInformationGridColumn}"
                                                Grid.ColumnSpan="{Binding CurrentScreen.Recipe.ShotInformationGridColumnSpan}"
                                                Padding="8,6"
                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26" />
                                                    <RowDefinition Height="23" />
                                                    <RowDefinition Height="23" />
                                                    <RowDefinition Height="6" />
                                                    <RowDefinition Height="24" />
                                                    <RowDefinition Height="23" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.ColumnSpan="2"
                                                           Text="SHOT INFORMATION"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Text="ROW / COL" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentScreen.Recipe.SelectedShotGroupGridText}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="CENTER" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentScreen.Recipe.SelectedShotGroupCenterText}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource PanelBorderBrush}" />
                                                <TextBlock Grid.Row="4" Text="STATE" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentScreen.Recipe.SelectedShotGroupStateText}" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#00723A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentScreen.Recipe.SelectedShotGroup.IsChessSkipped}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7A1FD0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentScreen.Recipe.SelectedShotGroup.IsInsideGlass}" Value="False">
                                                                    <Setter Property="Foreground" Value="#D71920" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentScreen.Recipe.SelectedShotGroup.IsMasked}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D71920" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="5" Text="MASK" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentScreen.Recipe.SelectedShotGroup.MaskingStateText}" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentScreen.Recipe.SelectedShotGroup.IsMasked}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D71920" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="6" Text="OFFSET X" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                                                <Grid Grid.Row="6" Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="{Binding CurrentScreen.Recipe.SelectedShotGroup.OffsetX}" Tag="{Binding CurrentScreen.Recipe.SelectedShotGroup}" Uid="OffsetX" Click="OpenShotGroupOffsetInput" Style="{StaticResource RecipeInputButton}" />
                                                    <TextBlock Grid.Column="1" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                </Grid>
                                                <TextBlock Grid.Row="7" Text="OFFSET Y" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                                                <Grid Grid.Row="7" Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="{Binding CurrentScreen.Recipe.SelectedShotGroup.OffsetY}" Tag="{Binding CurrentScreen.Recipe.SelectedShotGroup}" Uid="OffsetY" Click="OpenShotGroupOffsetInput" Style="{StaticResource RecipeInputButton}" />
                                                    <TextBlock Grid.Column="1" Text="mm" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                                </ScrollViewer>
                            </Grid>
                            </Border>
                        <Grid Grid.Row="0"
                              Grid.RowSpan="5"
                              Grid.Column="1"
                              Visibility="{Binding CurrentScreen.Recipe.IsCellPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GLASS PREVIEW"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentScreen.Recipe.CellPreviewSummaryText}"
                                           Margin="16,0,0,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="4">
                                <Grid x:Name="RecipePreviewViewport"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      Cursor="Hand"
                                      LostMouseCapture="RecipePreview_LostMouseCapture"
                                      PreviewMouseWheel="RecipePreview_PreviewMouseWheel"
                                      PreviewMouseLeftButtonDown="RecipePreview_PreviewMouseLeftButtonDown"
                                      PreviewMouseRightButtonDown="RecipePreview_PreviewMouseRightButtonDown"
                                      PreviewMouseMove="RecipePreview_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="RecipePreview_PreviewMouseLeftButtonUp">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="RESIZE" Click="RecipePreviewResize_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid x:Name="RecipePreviewZoomContent"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="RecipePreviewScaleTransform"
                                                                ScaleX="1"
                                                                ScaleY="1" />
                                                <TranslateTransform x:Name="RecipePreviewTranslateTransform" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Image Source="{Binding CurrentScreen.Recipe.CellPreviewImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                                        <ItemsControl ItemsSource="{Binding CurrentScreen.Recipe.CellPreviewLabels}"
                                                      Style="{StaticResource CellPreviewLabelItemsControl}"
                                                      IsHitTestVisible="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            MouseMove="CellPreviewLabel_MouseMove"
                                                            MouseLeave="CellPreviewLabel_MouseLeave"
                                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Recipe.SelectPreviewCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding CellNo}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border
                                                                                    Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="2"
                                                                                    SnapsToDevicePixels="True">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <Border x:Name="RecipePreviewHoverTip"
                                            Panel.ZIndex="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="7,3"
                                            Background="{DynamicResource PreviewHoverTipBackgroundBrush}"
                                            BorderBrush="{DynamicResource PreviewHoverTipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="RecipePreviewHoverTipTranslateTransform" />
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="RecipePreviewHoverTipText"
                                                   Foreground="{DynamicResource PreviewHoverTipTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2"
                          Grid.RowSpan="3"
                          Visibility="{Binding CurrentScreen.Recipe.IsHeadCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42*" />
                            <ColumnDefinition Width="58*" />
                        </Grid.ColumnDefinitions>

                        <ItemsControl Grid.Row="0"
                                      Grid.Column="0"
                                      ItemsSource="{Binding CurrentScreen.Recipe.GroupTabs}"
                                      Margin="0,0,12,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="9" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Group}"
                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Recipe.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Group}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RecipeTabButton}">
                                                <Setter Property="Height" Value="28" />
                                                <Setter Property="MinWidth" Value="0" />
                                                <Setter Property="Margin" Value="0,0,3,0" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DataGrid Grid.Row="1"
                                  Grid.Column="0"
                                  Margin="0,0,12,0"
                                  ItemsSource="{Binding CurrentScreen.Recipe.ManagedItems}"
                                  IsReadOnly="False"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="92" IsReadOnly="True" />
                                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" MinWidth="190" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Value" Width="136" CellStyle="{StaticResource RecipeFillDataGridCell}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Content="{Binding Value}" Tag="{Binding}" Click="OpenManagedItemInput"
                                                        Height="Auto" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RecipeInputButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                </Button>
                                                <ComboBox ItemsSource="{Binding ValueOptions}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Height="Auto" Margin="0" FocusVisualStyle="{x:Null}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBox}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                                </ComboBox>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="92" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HEAD PREVIEW"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentScreen.Recipe.HeadPreviewSummaryText}"
                                           Margin="16,0,0,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10">
                                <Border
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        Padding="4">
                                    <Grid>
                                        <Image Source="{Binding CurrentScreen.Recipe.HeadPreviewImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                                        <ItemsControl ItemsSource="{Binding CurrentScreen.Recipe.HeadPreviewLabels}"
                                                      Style="{StaticResource CellPreviewLabelItemsControl}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            Padding="6,0"
                                                            Background="{Binding BackgroundBrush}"
                                                            BorderBrush="{Binding BorderBrush}"
                                                            BorderThickness="1.4"
                                                            CornerRadius="2"
                                                            SnapsToDevicePixels="True">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   Foreground="{Binding TextBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>

                    <views:CRecipeZeroDefenceView Grid.Row="3" Grid.RowSpan="2"
                        DataContext="{Binding CurrentScreen.Recipe.ZeroDefence}"
                        Visibility="{Binding DataContext.CurrentScreen.Recipe.IsZeroDefenceCategory, RelativeSource={RelativeSource AncestorType=views:CRecipeView}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <DataGrid Grid.Row="4"
                              ItemsSource="{Binding CurrentScreen.Recipe.ManagedItems}"
                              IsReadOnly="False"
                              FontSize="13"
                              ColumnHeaderHeight="42"
                              RowHeight="40">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentScreen.Recipe.IsCellCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentScreen.Recipe.IsHeadCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentScreen.Recipe.IsZeroDefenceCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="128" IsReadOnly="True" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="280" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Value" Width="170" CellStyle="{StaticResource RecipeFillDataGridCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="{Binding Value}" Tag="{Binding}" Click="OpenManagedItemInput"
                                                    Height="Auto" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RecipeInputButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <ComboBox ItemsSource="{Binding ValueOptions}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="Auto" Margin="0" FocusVisualStyle="{x:Null}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBox}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="96" IsReadOnly="True" />
                            <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>

            <Border x:Name="HistoryPanel" Panel.ZIndex="1" Grid.Row="1" Grid.Column="1" Margin="12,12,0,0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Change History" Style="{StaticResource PanelTitle}"
                                   FontSize="20" VerticalAlignment="Center" />
                        <Button x:Name="HistoryExpandButton" Grid.Column="1" Content="EXPAND"
                                Click="ToggleHistory_Click" Style="{StaticResource RecipeTabButton}"
                                Width="100" MinWidth="0" Height="30" FontSize="12" Padding="0" />
                    </Grid>

                    <DataGrid x:Name="ChangeHistoryGrid" Grid.Row="1"
                              Grid.Column="0"
                              ItemsSource="{Binding CurrentScreen.Recipe.ChangeHistory}"
                              IsReadOnly="True"
                              Style="{StaticResource PlainDataGrid}"
                              FontSize="13"
                              ColumnHeaderHeight="42"
                              RowHeight="36"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="96" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="74" />
                            <DataGridTextColumn Header="Recipe" Binding="{Binding Recipe}" Width="140" />
                            <DataGridTextColumn Header="Tab" Binding="{Binding Tab}" Width="66" />
                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="76" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="92" />
                            <DataGridTextColumn Header="After" Binding="{Binding After}" Width="92">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AfterBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


