<UserControl x:Class="Drilling.UI.Views.CRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu"
             xmlns:views="clr-namespace:Drilling.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI"
             IsVisibleChanged="RecipeView_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="RecipeSmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="RecipeValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RecipeInputButton" TargetType="Button">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CurrentScreen.Recipe.IsViewRecipeSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" /></Border></ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource HeaderNavPressedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeFillDataGridCell"
               TargetType="DataGridCell"
               BasedOn="{StaticResource PlainDataGridCell}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="RecipeCompactInputBox" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,3" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="RecipeComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeComboBox" TargetType="ComboBox">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CurrentScreen.Recipe.IsViewRecipeSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RecipeComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Shell" Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextPrimaryBrush}"><Grid><ContentPresenter Margin="8,0,30,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" /><Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="5" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /><Setter TargetName="Shell" Property="TextElement.Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" /><Setter TargetName="Shell" Property="TextElement.Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"><Border Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"><ScrollViewer MaxHeight="220"><ItemsPresenter /></ScrollViewer></Border></Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeActionButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeTabButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeMainTabButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecipeListButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding CurrentScreen.IsRecipeLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="RECIPE / MANAGE"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="31"
                       FontWeight="SemiBold" />
            <TextBlock Text="Recipe item edit, create, modify, save, delete"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="16" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition>
                    <RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="232"/>
                        <Style.Triggers><DataTrigger Binding="{Binding CurrentScreen.Recipe.IsZeroDefenceCategory}" Value="True"><Setter Property="Height" Value="150"/></DataTrigger></Style.Triggers>
                    </Style></RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="RecipeFilesPanel" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="76" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Recipe List"
                               Style="{StaticResource PanelTitle}"
                               FontSize="20" />

                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="{DynamicResource GridHeaderBackgroundBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1,1,1,1">
                                <TextBlock Text="No."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource RecipeSmallText}"
                                           Foreground="{DynamicResource TextInvertedBrush}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="0,1,1,1">
                                <TextBlock Text="Recipe File"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource RecipeSmallText}"
                                           Foreground="{DynamicResource TextInvertedBrush}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CurrentScreen.Recipe.RecipeFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RecipeListButton}"
                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Recipe.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding FileName}">
                                        <Grid Height="38">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsView}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,1,1">
                                                <TextBlock Text="{Binding No}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeValueText}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsView}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Border Grid.Column="1"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                                    BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding FileName}"
                                                           Margin="18,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeValueText}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsView}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="2"
                              Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="PREV"
                                    Height="26"
                                    FontSize="10"
                                    Background="{DynamicResource ButtonPrimaryBrush}"
                                    BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                    Style="{StaticResource RecipeActionButton}"
                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.PreviousRecipePageCommand}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentScreen.Recipe.RecipeFilesPageText}"
                                       Style="{StaticResource RecipeSmallText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="NEXT"
                                    Height="26"
                                    FontSize="10"
                                    Background="{DynamicResource ButtonPrimaryBrush}"
                                    BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                    Style="{StaticResource RecipeActionButton}"
                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.NextRecipePageCommand}" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Style="{StaticResource RecipeActionButton}"
                                Background="{DynamicResource ButtonPrimaryBrush}"
                                BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                Margin="0,0,0,8"
                                menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.SelectCommand}">
                            <Grid Width="178">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M5,12 L10,17 L20,7"
                                          Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                          StrokeThickness="2.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="SELECT"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RecipeActionButton}"
                                Background="{DynamicResource ButtonPrimaryBrush}"
                                BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                Margin="0,0,0,8"
                                menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.CreateCommand}">
                            <Grid Width="178">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M12,3 V21 M3,12 H21"
                                          Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                          StrokeThickness="2.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="CREATE"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RecipeActionButton}"
                                Background="{DynamicResource ButtonWarningBrush}"
                                BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                Margin="0,0,0,8"
                                menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.ModifyCommand}">
                            <Grid Width="178">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M5,18 L7,13 L16,4 L20,8 L11,17 Z M14,6 L18,10"
                                          Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="MODIFY"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RecipeActionButton}"
                                Background="{DynamicResource ButtonSuccessBrush}"
                                BorderBrush="{DynamicResource StatusReadyBrush}"
                                Margin="0,0,0,8"
                                menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.SaveCommand}">
                            <Grid Width="178">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M5,4 H17 L20,7 V20 H4 V4 Z M8,4 V10 H16 V4 M8,17 H16"
                                          Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                          StrokeThickness="2.2"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="SAVE"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RecipeActionButton}"
                                Background="{DynamicResource ButtonDangerBrush}"
                                BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Recipe.DeleteCommand}">
                            <Grid Width="178">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M6,7 H18 M9,7 V5 H15 V7 M8,9 V20 H16 V9 M11,11 V18 M13,11 V18"
                                          Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="DELETE"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="RecipeEditorPanel" Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="Auto" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScreen.Recipe.IsCellCategory}" Value="True">
                                            <Setter Property="Height" Value="*" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="*" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScreen.Recipe.IsCellCategory}" Value="True">
                                            <Setter Property="Height" Value="160" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Recipe Managed Items"
                               Style="{StaticResource PanelTitle}"
                               FontSize="20" />

                    <Border Grid.Row="1"
                            Margin="0,12,0,10"
                            Padding="8,8,8,0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <ItemsControl ItemsSource="{Binding CurrentScreen.Recipe.ItemTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}"
                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Recipe.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Category}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RecipeMainTabButton}">
                                                <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
