<UserControl x:Class="Drilling.UI.Views.CMainProtectWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Drilling.UI">
    <UserControl.Resources>
        <Style x:Key="ProtectCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="ProtectLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <DataTemplate x:Key="CountValue">
            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontSize="29" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Detail}"/>
        </DataTemplate>
        <DataTemplate x:Key="SignalValue">
            <Border Background="{Binding Color}" CornerRadius="4" Padding="8,6" ToolTip="{Binding Detail}">
                <Grid>
                    <Border x:Name="SignalPulse" Background="#003310" Opacity="0" CornerRadius="3" ui:CSignalBlink.IsActive="{Binding IsBlinking}"/>
                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="100"/><RowDefinition Height="98"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Protect Window" Style="{StaticResource ProtectLabel}" FontSize="17"/>
            <Border HorizontalAlignment="Right" Background="{Binding Connection.Color}" Padding="12,3" CornerRadius="3" ToolTip="{Binding Connection.Detail}">
                <TextBlock Text="{Binding Connection.Text}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,6,6" Style="{StaticResource ProtectCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="레시피 설정매수" Style="{StaticResource ProtectLabel}"/>
                    <ContentControl Grid.Row="1" Content="{Binding RecipeCount}" ContentTemplate="{StaticResource CountValue}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="0,0,6,6" Style="{StaticResource ProtectCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="현재 사용매수" Style="{StaticResource ProtectLabel}"/>
                    <ContentControl Grid.Row="1" Content="{Binding CurrentCount}" ContentTemplate="{StaticResource CountValue}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Margin="0,0,0,6" Style="{StaticResource ProtectCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Tray Count" Style="{StaticResource ProtectLabel}"/>
                    <ContentControl Grid.Row="1" Content="{Binding TrayCount}" ContentTemplate="{StaticResource CountValue}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,6,6" Style="{StaticResource ProtectCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="교체요청 신호상태" Style="{StaticResource ProtectLabel}" Margin="0,0,0,5"/>
                    <ContentControl Grid.Row="1" Content="{Binding Request}" ContentTemplate="{StaticResource SignalValue}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource ProtectCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="교체완료 신호상태" Style="{StaticResource ProtectLabel}" Margin="0,0,0,5"/>
                    <ContentControl Grid.Row="1" Content="{Binding Complete}" ContentTemplate="{StaticResource SignalValue}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="교체 완료는 Shift/교체 구간 기준입니다. TPM 완료는 별도입니다."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
