<UserControl x:Class="Drilling.UI.Views.CMonitorLogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Drilling.UI.Menu.Menus"
             Loaded="ViewLoaded" IsVisibleChanged="ViewVisibilityChanged" DataContextChanged="ViewDataContextChanged">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:CLogTreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" MinHeight="28">
                <Path Width="17" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path.Style><Style TargetType="Path">
                        <Setter Property="Data" Value="M3,1 L11,1 L16,6 L16,19 L3,19 Z M11,1 L11,6 L16,6 M6,10 L13,10 M6,13 L13,13 M6,16 L11,16" />
                        <Setter Property="Fill" Value="{DynamicResource GridBackgroundBrush}" />
                        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="StrokeThickness" Value="1.3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                <Setter Property="Data" Value="M1,3 L8,3 L10,6 L19,6 L19,17 L1,17 Z" />
                                <Setter Property="Fill" Value="#F2CB62" /><Setter Property="Stroke" Value="#B98B22" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style></Path.Style>
                </Path>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelBorder}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="220" MaxWidth="660" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="320" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="REFRESH" Command="{Binding RefreshTreeCommand}" Width="100" Height="34" FontSize="13" Style="{StaticResource SecondaryButton}" Margin="0" />
                    <TextBlock Text="LOG FILES" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
                <TreeView x:Name="LogTree" Grid.Row="1" ItemsSource="{Binding TreeRoots}" FontSize="14" Padding="6"
                          Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource GridLineBrush}" SelectedItemChanged="LogSelectionChanged" TreeViewItem.Expanded="FolderExpanded"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></TreeView.ItemsPanel>
                    <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
                        <Style.Triggers><DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                    </Style></TreeView.ItemContainerStyle>
                </TreeView>
                <TextBlock Grid.Row="2" Text="{Binding TreeStatus}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding TreeStatus}" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource GridLineBrush}" />
            <Grid Grid.Column="2" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False"
                         FontSize="14" VerticalContentAlignment="Center" Height="38" Padding="8,0"
                         Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource GridLineBrush}"
                         ToolTip="{Binding FilePath}" />
            <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
            <TextBox x:Name="LogText" Grid.Row="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False"
                     FontFamily="Consolas, Malgun Gothic" FontSize="14" Padding="10"
                     Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource GridLineBrush}"
                     TextWrapping="NoWrap" VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     TextChanged="LogTextChanged" />
            </Grid>

            <Border Grid.ColumnSpan="3" Panel.ZIndex="20" Background="#B3172028">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="430" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LOADING LOG DATA"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <ProgressBar Value="{Binding LoadProgress, Mode=OneWay}"
                                     Minimum="0" Maximum="100" Height="16" Margin="0,16,0,8" />
                        <Grid>
                            <TextBlock Text="{Binding LoadProgressText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding LoadProgress, StringFormat={}{0:0}%}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
