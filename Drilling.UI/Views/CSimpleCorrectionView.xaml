<UserControl x:Class="Drilling.UI.Views.CSimpleCorrectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu"
             xmlns:views="clr-namespace:Drilling.UI.Views">
    <UserControl.Resources>
        <ControlTemplate x:Key="PreservedColorButton" TargetType="Button">
            <Border x:Name="StatusColorBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </ControlTemplate>
        <Style x:Key="RoughStateCard" TargetType="Border">
            <Setter Property="Background" Value="{Binding StateBrush}" />
            <Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="CornerRadius" Value="3" />
            <Style.Triggers><DataTrigger Binding="{Binding State}" Value="RUNNING">
                <DataTrigger.EnterActions><BeginStoryboard x:Name="RoughCardBlink"><Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="RoughCardBlink" /></DataTrigger.ExitActions>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SimpleCellButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SimpleHeadTemplate">
            <Button Margin="2" Padding="4,0" Height="34" MinWidth="0"
                    menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectHeadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding HeadNo}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Setter Property="Template" Value="{StaticResource PreservedColorButton}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
        <Border x:Name="SimplePreviewPanel" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <WrapPanel DockPanel.Dock="Right" Visibility="{Binding IsRough, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="■ WAIT  " Foreground="DarkGoldenrod" FontSize="11" /><TextBlock Text="■ OK  " Foreground="SeaGreen" FontSize="11" />
                        <TextBlock Text="■ RUNNING (Blink)  " Foreground="SeaGreen" FontSize="11" /><TextBlock Text="■ NG" Foreground="Firebrick" FontSize="11" />
                    </WrapPanel>
                    <Button DockPanel.Dock="Right" Content="GLASS" menu:CButtonCommandBehavior.Command="{Binding BackToGlassCommand}"
                            Visibility="{Binding CellVisibility}" Style="{StaticResource SecondaryButton}" Height="30" MinWidth="80" Padding="8,0" Margin="0" VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,8">
                    <Grid x:Name="SimpleGlassViewport" Visibility="{Binding GlassVisibility}" ClipToBounds="True">
                        <ScrollViewer x:Name="SimplePreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      SizeChanged="PreviewSizeChanged" ScrollChanged="PreviewScrollChanged">
                            <Canvas Width="{Binding PreviewContentWidth}" Height="{Binding PreviewContentHeight}" ClipToBounds="True">
                                <Canvas Width="860" Height="520" RenderTransform="{Binding PreviewTransform}">
                                    <Rectangle Canvas.Left="{Binding GlassFrame.CanvasLeft}" Canvas.Top="{Binding GlassFrame.CanvasTop}"
                                               Width="{Binding GlassFrame.Width}" Height="{Binding GlassFrame.Height}"
                                               Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" IsHitTestVisible="False" />
                                    <Image Source="{Binding PreviewImage}" Width="860" Height="520" Stretch="Fill" IsHitTestVisible="False" />
                                    <ItemsControl Width="860" Height="520" ItemsSource="{Binding CellLabels}"
                                                  Style="{StaticResource CellPreviewLabelItemsControl}" IsHitTestVisible="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="{Binding Width}" Height="{Binding Height}"
                                                        Style="{StaticResource SimpleCellButton}" ToolTip="{Binding DisplayText}"
                                                        menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding CellNo}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                                    <ItemsControl x:Name="SimpleFirstShotCallouts" Width="{Binding PreviewContentWidth}" Height="{Binding PreviewContentHeight}" ItemsSource="{Binding FirstShotCallouts}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Canvas Width="{Binding DataContext.PreviewContentWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Height="{Binding DataContext.PreviewContentHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Rectangle x:Name="CalloutMarker" Canvas.Left="{Binding CellBounds.X}" Canvas.Top="{Binding CellBounds.Y}"
                                                           Width="{Binding CellBounds.Width}" Height="{Binding CellBounds.Height}"
                                                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="#22488AC0" IsHitTestVisible="False" />
                                                <Polyline x:Name="CalloutLeader" Points="{Binding LeaderPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1" Opacity="0.4" IsHitTestVisible="False" />
                                                <Button x:Name="CalloutLabel" Canvas.Left="{Binding LabelLeft}" Canvas.Top="{Binding LabelTop}"
                                                        Template="{StaticResource PreservedColorButton}"
                                                        Width="{Binding LabelWidth}" Height="{Binding LabelHeight}" MinWidth="0" Margin="0" Padding="4,0"
                                                        Content="{Binding Label}" ToolTip="{Binding Detail}" ToolTipService.InitialShowDelay="0"
                                                        Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                                                        Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Cursor="Hand"
                                                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                        menu:CButtonCommandBehavior.Command="{Binding DataContext.SelectCorrectionShotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding ShotKey}" />
                                            </Canvas>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="CalloutLabel" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalloutLeader" Property="Opacity" Value="1" />
                                                    <Setter TargetName="CalloutLeader" Property="StrokeThickness" Value="2.4" />
                                                    <Setter TargetName="CalloutMarker" Property="StrokeThickness" Value="2.6" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="CalloutLabel" Property="Background" Value="{DynamicResource ButtonSuccessBrush}" />
                                                    <Setter TargetName="CalloutLabel" Property="BorderBrush" Value="{DynamicResource ButtonSuccessBorderBrush}" />
                                                    <Setter TargetName="CalloutLabel" Property="Foreground" Value="White" />
                                                    <Setter TargetName="CalloutMarker" Property="Fill" Value="#9928A15B" />
                                                    <Setter TargetName="CalloutMarker" Property="Stroke" Value="{DynamicResource ButtonSuccessBrush}" />
                                                    <Setter TargetName="CalloutMarker" Property="StrokeThickness" Value="2.6" />
                                                    <Setter TargetName="CalloutLeader" Property="Stroke" Value="{DynamicResource ButtonSuccessBrush}" />
                                                    <Setter TargetName="CalloutLeader" Property="Opacity" Value="1" />
                                                    <Setter TargetName="CalloutLeader" Property="StrokeThickness" Value="3" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasInspectionState}" Value="True">
                                                    <Setter TargetName="CalloutLabel" Property="Background" Value="{Binding InspectionBrush}" /><Setter TargetName="CalloutLabel" Property="BorderBrush" Value="{Binding InspectionBrush}" /><Setter TargetName="CalloutLabel" Property="Foreground" Value="White" />
                                                    <Setter TargetName="CalloutMarker" Property="Fill" Value="{Binding InspectionBrush}" /><Setter TargetName="CalloutMarker" Property="Stroke" Value="{Binding InspectionBrush}" />
                                                    <Setter TargetName="CalloutLeader" Property="Stroke" Value="{Binding InspectionBrush}" /><Setter TargetName="CalloutLeader" Property="Opacity" Value="1" /><Setter TargetName="CalloutLeader" Property="StrokeThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InspectionState}" Value="RUNNING">
                                                    <Setter TargetName="CalloutLeader" Property="StrokeThickness" Value="3" />
                                                    <DataTrigger.EnterActions><BeginStoryboard x:Name="RoughPreviewBlink"><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CalloutLabel" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetName="CalloutMarker" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetName="CalloutLeader" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="RoughPreviewBlink" /></DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                <views:CReviewCameraOverlay DataContext="{Binding Camera}" Panel.ZIndex="1000"
                                    Visibility="{Binding DataContext.IsRough, RelativeSource={RelativeSource AncestorType=views:CSimpleCorrectionView}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Width="{Binding DataContext.PreviewContentWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Height="{Binding DataContext.PreviewContentHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Canvas>
                        </ScrollViewer>
                        <TextBlock Text="우측에서 Head를 선택해 주세요." Visibility="{Binding SelectHeadHintVisibility}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <Grid x:Name="SimpleCellViewport" Visibility="{Binding CellVisibility}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding CellSummary}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ShotRows}" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                            </ControlTemplate></ItemsControl.Template>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <ItemsControl ItemsSource="{Binding Shots}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Width="94" Height="62" Margin="2" Padding="5" CornerRadius="3" ToolTip="{Binding State}" MouseLeftButtonUp="SelectRepresentativeShot">
                                            <Border.Style><Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding CanProcess}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsRough, RelativeSource={RelativeSource AncestorType=views:CSimpleCorrectionView}}" Value="True" />
                                                    </MultiDataTrigger.Conditions><Setter Property="Cursor" Value="Hand" /></MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsReference}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="White" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                                        <Setter Property="Background" Value="#F87171" /><Setter Property="TextElement.Foreground" Value="#281315" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChessSkipped}" Value="True">
                                                        <Setter Property="Background" Value="#C084FC" /><Setter Property="TextElement.Foreground" Value="#211827" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style></Border.Style>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" TextAlignment="Center" />
                                                <TextBlock Text="{Binding Head}" FontSize="11" TextAlignment="Center" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding State}" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Margin="3,6,3,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border x:Name="SimpleCurrentRecipePanel" Style="{StaticResource PanelBorder}" Padding="12,7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="CURRENT RECIPE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding RecipeName}" ToolTip="{Binding RecipeId}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorText}" Foreground="{DynamicResource ButtonDangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,7,0,0" Visibility="{Binding IsRough, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Stage Y Cur (mm)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding Inspection.StageY}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Review X Cur (mm)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding Inspection.ReviewX}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Inspection.Mode}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="1" x:Name="SimpleHeadSelectPanel" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding HeadSelectionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,2,5" />
                    <ItemsControl ItemsSource="{Binding HeadSelections}" ItemTemplate="{StaticResource SimpleHeadTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="2,6,2,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="HEAD" Height="32" MinWidth="0" Padding="8,0" Margin="2,0" Template="{StaticResource PreservedColorButton}"
                                menu:CButtonCommandBehavior.Command="{Binding SelectScopeCommand}" CommandParameter="HEAD">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsHeadScope}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" /><Setter Property="Foreground" Value="White" />
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="HEAD + CELL" Height="32" MinWidth="0" Padding="8,0" Margin="2,0" Template="{StaticResource PreservedColorButton}"
                                menu:CButtonCommandBehavior.Command="{Binding SelectScopeCommand}" CommandParameter="HEAD_CELL">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsHeadCellScope}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" /><Setter Property="Foreground" Value="White" />
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </Grid>
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding IsRough, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="BEAM" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="2,0,12,0" />
                        <ComboBox ItemsSource="{Binding Inspection.BeamNumbers}" SelectedItem="{Binding Inspection.SelectedBeam, Mode=TwoWay}" IsEnabled="{Binding Inspection.CanConfigure}" Height="30" MinWidth="80" HorizontalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" x:Name="SimpleCorrectionPanel" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="CORRECTION" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,2,8" />
                    <ScrollViewer x:Name="SimpleCorrectionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSimple, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding CorrectionRows}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1" Padding="9,7" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="23" /><RowDefinition Height="27" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.ColumnSpan="3" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="X (mm)" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Y (mm)" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Row="2" Text="Current" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentX}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CurrentY}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                                        <TextBlock Grid.Row="3" Text="Input" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InputX, Mode=OneWay}" Tag="X" IsReadOnly="True" Cursor="Hand"
                                                 PreviewMouseLeftButtonDown="OpenCorrectionInput" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Margin="3,2" />
                                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding InputY, Mode=OneWay}" Tag="Y" IsReadOnly="True" Cursor="Hand"
                                                 PreviewMouseLeftButtonDown="OpenCorrectionInput" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Margin="3,2" />
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Visibility="{Binding IsSimple, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding CorrectionEmptyText}" Visibility="{Binding CorrectionEmptyVisibility}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                    </Grid>
                    <Grid Grid.Row="1" Visibility="{Binding IsRough, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Inspection.Summary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Inspection.Rows}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource RoughStateCard}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="23" /><RowDefinition Height="23" /><RowDefinition Height="23" /><RowDefinition Height="23" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.ColumnSpan="2" Text="{Binding Title}" Foreground="White" FontWeight="Bold" />
                                            <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Text="Target (mm)" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReviewX, StringFormat='X {0}'}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StageY, StringFormat='Y {0}'}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="Current Offset" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentX}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CurrentY}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Text="Recv Target − Hole" ToolTip="X = Target X − Hole X / Y = Target Y − Hole Y (mm)" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeltaX}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DeltaY}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            <TextBlock Grid.Row="4" Text="Vision Flip Convert" ToolTip="Setting의 Vision Flip을 적용한 설계 기준 Offset (mm)" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConvertedX}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ConvertedY}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,7,0,0" Visibility="{Binding IsRough, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Inspection.Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <UniformGrid Rows="1">
                            <Button Content="Review Start" Height="36" Margin="0,0,3,0" Style="{StaticResource PrimaryButton}" menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="REVIEW_START" />
                            <Button Content="Review Stop" Height="36" Margin="3,0" Template="{StaticResource PreservedColorButton}" menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="REVIEW_STOP">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="NG RETRY" Height="36" Margin="3,0,0,0" Style="{StaticResource SecondaryButton}" menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="NG_RETRY" />
                        </UniformGrid>
                        <UniformGrid Rows="1" Margin="0,7,0,0">
                            <Button Content="OFFSET APPLY" Height="36" Margin="0,0,3,0" Style="{StaticResource PrimaryButton}" menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="OFFSET_APPLY" />
                            <Button Content="OFFSET INIT" Height="36" Margin="3,0,0,0" Style="{StaticResource SecondaryButton}" menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="OFFSET_INIT" />
                        </UniformGrid>
                        <Button Content="CUR REVIEW OFFSET VIEW" Height="36" Margin="0,7,0,0" Style="{StaticResource SecondaryButton}" menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="OFFSET_VIEW" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding IsSimple, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="OFFSET APPLY" Height="40" Margin="0,0,4,0" Style="{StaticResource PrimaryButton}"
                                    menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="OFFSET_APPLY" />
                            <Button Grid.Column="1" Content="OFFSET INIT" Height="40" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}"
                                    menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="OFFSET_INIT" />
                        </Grid>
                        <Button Content="CUR REVIEW OFFSET VIEW" Height="40" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                menu:CButtonCommandBehavior.Command="{Binding OffsetActionCommand}" CommandParameter="OFFSET_VIEW" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
