<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Drilling.UI.Views" x:Class="Drilling.UI.Views.CAutomationControllerStatusView">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Automation Controller Status">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:CAutomationControllerStatusView}}" Value="True">
                            <Setter Property="FontSize" Value="14"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Margin" Value="0,10,0,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:CAutomationControllerStatusView}}" Value="True">
                            <Setter Property="Margin" Value="0,4,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ControllerCard" Margin="3" Padding="8" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ControllerNameText" Text="{Binding ControllerName}" Foreground="{DynamicResource AccentTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" x:Name="ControllerTaskSummary" Text="{Binding TaskSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid x:Name="ControllerCpuRow" DockPanel.Dock="Top" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ControllerCpuBar" Minimum="0" Maximum="100" Height="10" Value="{Binding CpuUsagePercent}" Foreground="{Binding CpuUsageBrush}" Background="{DynamicResource PanelBackgroundBrush}"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding CpuUsageText}" Foreground="{Binding StateBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" Margin="0,5,0,8" x:Name="ControllerDetailText" Text="{Binding DetailText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding TaskColumns, RelativeSource={RelativeSource AncestorType=local:CAutomationControllerStatusView}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TaskStatusCard" Margin="2" Padding="6" Background="{Binding StateBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid x:Name="TaskHeader" Grid.ColumnSpan="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TaskTitleText" Text="{Binding Task}" Foreground="{Binding CardTextBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" x:Name="TaskHeadText" Text="{Binding Head}" Foreground="{Binding CardTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Viewbox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly">
                                                    <TextBlock x:Name="TaskStateText" Text="{Binding StateText}" Foreground="{Binding CardTextBrush}" FontSize="16" FontWeight="Bold"/>
                                                </Viewbox>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,3,0,0" x:Name="TaskFileText" Text="{Binding FileText}" Foreground="{Binding CardTextBrush}" FontSize="8" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsStateHighlighted}" Value="False">
                                                <Setter TargetName="TaskStatusCard" Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                                <Setter TargetName="TaskTitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Setter TargetName="TaskHeadText" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Setter TargetName="TaskStateText" Property="Foreground" Value="{Binding StateBrush}"/>
                                                <Setter TargetName="TaskFileText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:CAutomationControllerStatusView}}" Value="True">
                                                <Setter TargetName="TaskStatusCard" Property="Padding" Value="4"/>
                                                <Setter TargetName="TaskTitleText" Property="FontSize" Value="9"/>
                                                <Setter TargetName="TaskHeadText" Property="Margin" Value="4,0,0,0"/>
                                                <Setter TargetName="TaskStateText" Property="FontSize" Value="14"/>
                                                <Setter TargetName="TaskFileText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:CAutomationControllerStatusView}}" Value="True">
                            <Setter TargetName="ControllerCard" Property="Padding" Value="4"/>
                            <Setter TargetName="ControllerNameText" Property="FontSize" Value="11"/>
                            <Setter TargetName="ControllerTaskSummary" Property="FontSize" Value="9"/>
                            <Setter TargetName="ControllerCpuRow" Property="Margin" Value="0,4,0,0"/>
                            <Setter TargetName="ControllerCpuBar" Property="Height" Value="8"/>
                            <Setter TargetName="ControllerDetailText" Property="Margin" Value="0,3,0,4"/>
                            <Setter TargetName="ControllerDetailText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
