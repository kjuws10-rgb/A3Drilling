<UserControl x:Class="Drilling.UI.Views.CPmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="PmSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PmActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PmSecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PmActionButton}">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        </Style>

        <Style x:Key="PmGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Visibility="{Binding CurrentScreen.IsPmLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="245" />
            <RowDefinition Height="12" />
            <RowDefinition Height="7*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="20,0">
                    <TextBlock Text="LIFE STATUS" Style="{StaticResource PmSectionTitle}" />
                    <TextBlock Text="CRYSTAL / PROTECT WINDOW"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource PanelBorderBrush}" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="18,12,18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="CRYSTAL USE BY HEAD"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding CurrentScreen.Pm.PartLifeRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3,2"
                                            Background="{DynamicResource PanelAltBackgroundBrush}"
                                            BorderBrush="{DynamicResource GridLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{DynamicResource GridHeaderBackgroundBrush}"
                                                    BorderBrush="{DynamicResource GridLineBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock Text="{Binding Head}"
                                                           Foreground="{DynamicResource TextInvertedBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Row="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding CrystalUse}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="25"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text=" h"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11"
                                                               Margin="2,0,0,3"
                                                               VerticalAlignment="Bottom" />
                                                </StackPanel>
                                                <Border Height="1"
                                                        Margin="8,4"
                                                        Background="{DynamicResource GridLineBrush}" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <TextBlock Text="LIMIT "
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding CrystalLimit}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text=" h"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" />

                    <Grid Grid.Column="2" Margin="18,12,18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="PROTECT WINDOW"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding CurrentScreen.Pm.ProtectWindowItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3,2"
                                            Background="{DynamicResource PanelAltBackgroundBrush}"
                                            BorderBrush="{DynamicResource GridLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{DynamicResource GridHeaderBackgroundBrush}"
                                                    BorderBrush="{DynamicResource GridLineBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextInvertedBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="28"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="12"
                                                           Margin="7,0,0,4"
                                                           VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="468" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="458" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="116" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="104"
                                Height="104"
                                Background="{DynamicResource ButtonWarningBrush}"
                                BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScreen.Pm.IsLocked}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PmLockBlinkStoryboard">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1"
                                                                         To="0.42"
                                                                         Duration="0:0:0.55" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PmLockBlinkStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Viewbox Width="62" Height="68">
                                <Canvas Width="48" Height="54">
                                    <Path Data="M10,23 V16 C10,8.3 16.3,2 24,2 C31.7,2 38,8.3 38,16 V23"
                                          Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                          StrokeThickness="5.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Border Canvas.Left="5"
                                            Canvas.Top="20"
                                            Width="38"
                                            Height="31"
                                            Background="{DynamicResource ButtonTextOnColorBrush}"
                                            CornerRadius="3" />
                                    <Ellipse Canvas.Left="21"
                                             Canvas.Top="29"
                                             Width="6"
                                             Height="6"
                                             Fill="{DynamicResource ButtonWarningBrush}" />
                                    <Rectangle Canvas.Left="23"
                                               Canvas.Top="34"
                                               Width="2"
                                               Height="8"
                                               Fill="{DynamicResource ButtonWarningBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="PM LOCK"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="54"
                                   FontWeight="SemiBold"
                                   Margin="24,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBorderBrush}" />

                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="START TIME"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentScreen.Pm.StartTime}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1"
                        Margin="0,20"
                        Background="{DynamicResource PanelBorderBrush}" />

                <Grid Grid.Column="2" Margin="28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="74" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,14">
                        <TextBlock Text="PASSWORD REQUIRED"
                                   Foreground="{DynamicResource ButtonDangerBorderBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Enter the PM password to restore equipment control."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="{DynamicResource GridBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="4">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PmPasswordBox"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         FontSize="25"
                                         FontWeight="SemiBold"
                                         PasswordChanged="PmPasswordChanged"
                                         PreviewMouseLeftButtonDown="OpenPmPasswordKeyboard" />
                            <TextBox x:Name="PmPasswordVisibleTextBox"
                                     Visibility="Collapsed"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="25"
                                     FontWeight="SemiBold"
                                     PreviewMouseLeftButtonDown="OpenPmPasswordKeyboard" />
                            <Button Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Show / Hide Password"
                                    Click="TogglePmPasswordVisibility">
                                <Viewbox Width="24" Height="24">
                                    <Grid Width="24" Height="24">
                                        <Path Data="M2,12 C4.8,7.5 8,5 12,5 C16,5 19.2,7.5 22,12 C19.2,16.5 16,19 12,19 C8,19 4.8,16.5 2,12 Z"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="1.8"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Stroke="{DynamicResource TextMutedBrush}"
                                                 StrokeThickness="1.8"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                        <Path x:Name="PmPasswordVisibilitySlash"
                                              Visibility="Collapsed"
                                              Data="M4,4 L20,20"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Grid>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="4"
                      Margin="0,20,28,20"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Content="PM UNLOCK"
                            Background="{DynamicResource ButtonDangerBrush}"
                            BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                            Click="UnlockPm"
                            Style="{StaticResource PmActionButton}" />
                    <Button Grid.Row="2"
                            Content="CLEAR"
                            Click="ClearPmPassword"
                            Style="{StaticResource PmSecondaryActionButton}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="20,0">
                    <TextBlock Text="PM HISTORY" Style="{StaticResource PmSectionTitle}" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource PanelBorderBrush}" />

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding CurrentScreen.Pm.HistoryRows}"
                          Style="{StaticResource PlainDataGrid}"
                          IsReadOnly="True"
                          RowHeight="40"
                          FontSize="13"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOCK TIME" Binding="{Binding LockTime}" Width="205" ElementStyle="{StaticResource PmGridText}" />
                        <DataGridTextColumn Header="UNLOCK TIME" Binding="{Binding UnlockTime}" Width="205" ElementStyle="{StaticResource PmGridText}" />
                        <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="130" ElementStyle="{StaticResource PmGridText}" />
                        <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
