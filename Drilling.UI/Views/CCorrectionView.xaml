<UserControl x:Class="Drilling.UI.Views.CCorrectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu"
             xmlns:views="clr-namespace:Drilling.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="CorrectionLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CorrectionValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CorrectionFlipStateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CorrectionScannerFlipRowTemplate">
            <Grid Height="15" Margin="0,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="23" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="23" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="23" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="X" Style="{StaticResource CorrectionFlipStateText}" />
                <TextBlock Grid.Column="2" Text="{Binding XState}" Tag="{Binding XFlip}" Style="{StaticResource CorrectionFlipStateText}" />
                <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource CorrectionFlipStateText}" />
                <TextBlock Grid.Column="4" Text="{Binding YState}" Tag="{Binding YFlip}" Style="{StaticResource CorrectionFlipStateText}" />
                <TextBlock Grid.Column="5" Text="XY" Style="{StaticResource CorrectionFlipStateText}" />
                <TextBlock Grid.Column="6" Text="{Binding XyState}" Tag="{Binding XyFlip}" Style="{StaticResource CorrectionFlipStateText}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CorrectionTabButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CorrectionCommandButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OffsetKindButton" TargetType="Button" BasedOn="{StaticResource CorrectionTabButton}">
            <Setter Property="Height" Value="32" /><Setter Property="MinWidth" Value="62" />
            <Setter Property="Margin" Value="0,0,5,3" /><Setter Property="FontSize" Value="12" />
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextInvertedBrush}" />
            </DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="CorrectionReviewDataGrid"
               TargetType="DataGrid"
               BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding CurrentScreen.IsCorrectionLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="50" />
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="{Binding CurrentScreen.Correction.Title}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="31"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentScreen.Correction.Subtitle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="15" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding CurrentScreen.Correction.IsCorrectionCommandsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        VerticalAlignment="Center">
                <Button Content="LOAD"
                        menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Correction.ExecuteCommand}"
                        CommandParameter="LOAD"
                        Style="{StaticResource CorrectionCommandButton}"
                        Background="{DynamicResource ButtonSecondaryBrush}"
                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Content="CALCULATE"
                        menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Correction.ExecuteCommand}"
                        CommandParameter="CALCULATE"
                        Style="{StaticResource CorrectionCommandButton}"
                        Background="{DynamicResource ButtonPrimaryBrush}"
                        BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                        Foreground="{DynamicResource ButtonTextOnColorBrush}" />
                <Button Content="APPLY"
                        menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Correction.ExecuteCommand}"
                        CommandParameter="APPLY"
                        Style="{StaticResource CorrectionCommandButton}"
                        Background="{DynamicResource ButtonSuccessBrush}"
                        BorderBrush="{DynamicResource ButtonSuccessBorderBrush}"
                        Foreground="{DynamicResource ButtonTextOnColorBrush}" />
                <Button Content="SAVE"
                        menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Correction.ExecuteCommand}"
                        CommandParameter="SAVE"
                        Style="{StaticResource CorrectionCommandButton}"
                        Background="{DynamicResource ButtonWarningBrush}"
                        BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                        Foreground="{DynamicResource ButtonTextOnColorBrush}"
                        Margin="0" />
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding CurrentScreen.Correction.Tabs}"
                      Margin="0,2,0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}"
                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Correction.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Name}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CorrectionTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="DefaultWorkspace" Grid.Row="2" Grid.RowSpan="3" Margin="0,8,0,0"
              Visibility="{Binding CurrentScreen.Correction.IsDefaultTab, Converter={StaticResource BooleanToVisibilityConverter}}">
            <views:CDefaultOffsetView DataContext="{Binding CurrentScreen.Correction.DefaultOffset}" />
        </Grid>

        <Grid Grid.Row="2" Grid.RowSpan="3"
              Visibility="{Binding CurrentScreen.Correction.IsAlignDistortionTab, Converter={StaticResource BooleanToVisibilityConverter}}">
            <views:CAlignDistortionView Margin="0,8,0,0"
                                        DataContext="{Binding CurrentScreen.Correction.AlignDistortion}" />
        </Grid>

        <TabControl Grid.Row="2" Grid.RowSpan="3" Margin="0,8,0,0"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Visibility="{Binding CurrentScreen.Correction.IsReviewCorrectionTab, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="MinWidth" Value="140" />
                    <Setter Property="Padding" Value="20,8" />
                    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,1,1,3" Padding="{TemplateBinding Padding}" CornerRadius="5,5,0,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers><Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                    </Trigger></Style.Triggers>
                </Style>
            </TabControl.Resources>
            <TabItem Header="SIMPLE" IsSelected="True">
                <views:CSimpleCorrectionView Margin="0,8,0,0" DataContext="{Binding CurrentScreen.Correction.Simple}" />
            </TabItem>
            <TabItem Header="ROUGH">
                <views:CSimpleCorrectionView Margin="0,8,0,0" DataContext="{Binding CurrentScreen.Correction.Rough}" />
            </TabItem>
            <TabItem Header="FINE">
                <views:CFineCorrectionView Margin="0,8,0,0" DataContext="{Binding CurrentScreen.Correction.Fine}" />
            </TabItem>
            <TabItem Header="REVIEW DATA">
                <views:CReviewDataView Margin="0,8,0,0" DataContext="{Binding CurrentScreen.Correction.ReviewData}" />
            </TabItem>
        </TabControl>

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding CurrentScreen.Correction.SummaryItems}"
                      Visibility="{Binding CurrentScreen.Correction.IsOtherCorrectionTab, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PanelBorder}"
                            Padding="16,10"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource CorrectionLabelText}" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Value}"
                                       Foreground="{Binding ValueBrush}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3"
              Visibility="{Binding CurrentScreen.Correction.IsOtherCorrectionTab, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="500" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Margin="0,0,12,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Correction Source"
                               Style="{StaticResource PanelTitle}"
                               FontSize="18" />
                    <DataGrid ItemsSource="{Binding CurrentScreen.Correction.SourceRows}"
                              IsReadOnly="True"
                              Style="{StaticResource CorrectionReviewDataGrid}"
                              FontSize="12"
                              ColumnHeaderHeight="40"
                              RowHeight="40"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="86" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="170" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="78">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding StateBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource PanelBorder}"
                    Margin="0,0,12,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Correction Candidate"
                               Style="{StaticResource PanelTitle}"
                               FontSize="18" />
                    <DataGrid ItemsSource="{Binding CurrentScreen.Correction.CandidateRows}"
                              IsReadOnly="True"
                              Style="{StaticResource CorrectionReviewDataGrid}"
                              FontSize="13"
                              ColumnHeaderHeight="42"
                              RowHeight="42"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="190" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="170" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ValueBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding StateBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2"
                  Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="135" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Detail"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding CurrentScreen.Correction.DetailItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="122" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource CorrectionLabelText}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   Style="{StaticResource CorrectionValueText}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Apply Preview"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Correction.ApplyRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource CorrectionReviewDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="40"
                                  RowHeight="39"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="160" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="120" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ValueBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Grid.RowSpan="3"
              Visibility="{Binding CurrentScreen.Correction.IsOutputHistoryTab, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="420" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="6*" MinWidth="650" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock Text="GLASS-CELL VIEW"
                                       DockPanel.Dock="Left"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="15"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentScreen.Correction.OutputViewerSummary}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding CurrentScreen.Correction.OutputViewerHeadCards}"
                                      Margin="0,0,0,7">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="28"
                                            Margin="1"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{Binding Foreground}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="2"
                                Background="{DynamicResource GridBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="6">
                            <Grid x:Name="OutputViewerPreviewViewport" ClipToBounds="True">
                                <Image Source="{Binding CurrentScreen.Correction.OutputViewerGlassPreviewImage}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                                <ItemsControl ItemsSource="{Binding CurrentScreen.Correction.OutputViewerCellPreviewLabels}"
                                              Style="{StaticResource CellPreviewLabelItemsControl}"
                                              IsHitTestVisible="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding CellNo}"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Correction.SelectOutputViewerCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding CellNo}"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    MouseMove="OutputViewerCellPreviewLabel_MouseMove"
                                                    MouseLeave="OutputViewerCellPreviewLabel_MouseLeave">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#F4F7FA" />
                                                        <Setter Property="BorderBrush" Value="#3F6F98" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Foreground" Value="#203446" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="2"
                                                                            SnapsToDevicePixels="True">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#F6C453" />
                                                                <Setter Property="Foreground" Value="#17212B" />
                                                                <Setter Property="BorderBrush" Value="#FFF4D6" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border x:Name="OutputViewerPreviewHoverTip"
                                        Panel.ZIndex="10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Padding="7,3"
                                        Background="{DynamicResource PreviewHoverTipBackgroundBrush}"
                                        BorderBrush="{DynamicResource PreviewHoverTipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="OutputViewerPreviewHoverTipTranslateTransform" />
                                    </Border.RenderTransform>
                                    <TextBlock x:Name="OutputViewerPreviewHoverTipText"
                                               Foreground="{DynamicResource PreviewHoverTipTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CELL SHOT VIEW"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="14"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentScreen.Correction.OutputViewerSelectedShotName}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#2DD4BF" />
                                <TextBlock Text="SHOT" Margin="4,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="×" Foreground="#F87171" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="MASKING / OFF" Margin="3,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="◆" Foreground="#C084FC" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="CHESS / OFF" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{DynamicResource GridBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="4"
                                ClipToBounds="True">
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Grid x:Name="OutputViewerCellShotMapSurface"
                                          Width="{Binding CurrentScreen.Correction.OutputViewerCellShotMapSurfaceWidth}"
                                          Height="{Binding CurrentScreen.Correction.OutputViewerCellShotMapSurfaceHeight}"
                                          Background="Transparent"
                                          Cursor="Hand"
                                          MouseLeftButtonDown="SelectOutputViewerShotFromMap">
                                        <Image Source="{Binding CurrentScreen.Correction.OutputViewerCellShotMapImage}"
                                               Stretch="Fill"
                                               IsHitTestVisible="False" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="NO CELL SELECTED"
                                           Visibility="{Binding CurrentScreen.Correction.OutputViewerHasNoCellSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OFFSET VIEWER"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="17"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                            <ItemsControl Grid.Column="1"
                                          x:Name="OutputOffsetKinds"
                                          ItemsSource="{Binding CurrentScreen.Correction.OutputOffsets.Kinds}"
                                          HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource OffsetKindButton}"
                                                Command="{Binding DataContext.CurrentScreen.Correction.OutputOffsets.SelectKindCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <TextBlock Text="{Binding CurrentScreen.Correction.OutputOffsets.Description}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,8"
                            Padding="9,7"
                            Background="{DynamicResource GridHeaderBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CurrentScreen.Correction.OutputViewerSelectedCellName}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentScreen.Correction.OutputViewerSelectedShotName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CurrentScreen.Correction.OutputViewerSelectedShotDetail}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Border Visibility="{Binding CurrentScreen.Correction.OutputViewerHasNoCellSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource GridBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="NO CELL SELECTED"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <DataGrid x:Name="OutputOffsetGrid"
                                  Visibility="{Binding CurrentScreen.Correction.OutputViewerIsCellDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ItemsSource="{Binding CurrentScreen.Correction.OutputOffsets.ShotItems}"
                                  SelectedItem="{Binding CurrentScreen.Correction.OutputOffsets.SelectedShotItem, Mode=OneWay}"
                                  Style="{StaticResource CorrectionReviewDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  RowHeight="52"
                                  ColumnHeaderHeight="34"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="OutputOffsetGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="ToolTip" Value="{Binding CoordinateDetail}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#566B7E" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#B8D5EA" />
                                            <Setter Property="BorderThickness" Value="2,0,0,1" />
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#566B7E" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#B8D5EA" />
                                            <Setter Property="BorderThickness" Value="2,0,0,1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="SHOT" Width="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ShotName}"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="HEAD" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Head}"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="DESIGN OFFSET X (mm)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DesignOffsetX}"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="DESIGN OFFSET Y (mm)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DesignOffsetY}"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SCANNER OFFSET GX (mm)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ScannerOffsetGx}"
                                                       Foreground="#FFB45C"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SCANNER OFFSET GY (mm)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ScannerOffsetGy}"
                                                       Foreground="#FFB45C"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
