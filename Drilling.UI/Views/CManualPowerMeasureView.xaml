<UserControl x:Class="Drilling.UI.Views.CManualPowerMeasureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="13"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="PmPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OpenPowerMeasureInput" />
            <EventSetter Event="PreviewKeyDown" Handler="PowerMeasureInputKeyDown" />
        </Style>
        <Style x:Key="PmCellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="PmGraph">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Maximum}" FontSize="10" />
                <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,2">
                    <Canvas Width="600" Height="160" ClipToBounds="True" Background="{DynamicResource GridBackgroundBrush}">
                        <Line X1="8" X2="592" Y1="152" Y2="152" Stroke="Gray" />
                        <Line X1="8" X2="8" Y1="8" Y2="152" Stroke="Gray" />
                        <Line X1="8" X2="592" Y1="{Binding TargetLineY}" Y2="{Binding TargetLineY}" Stroke="DarkOrange" StrokeThickness="2" StrokeDashArray="4,3" />
                        <Polyline Points="{Binding Points}" Stroke="SteelBlue" StrokeThickness="3" />
                        <Ellipse Width="10" Height="10" Fill="SteelBlue" Canvas.Left="{Binding LastPointLeft}" Canvas.Top="{Binding LastPointTop}" Visibility="{Binding LastPointVisibility}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Row="2" Text="0" FontSize="10" />
                <TextBlock Grid.Row="2" Text="{Binding Attempts}" HorizontalAlignment="Right" FontSize="10" />
            </Grid>
        </DataTemplate>
        <Style x:Key="PmGraphCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="SteelBlue" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="SteelBlue" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGraphSelected}" Value="True"><Setter Property="BorderBrush" Value="SteelBlue" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PmButton" TargetType="Button">
            <Setter Property="Background" Value="SteelBlue" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PmGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="3,3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="7*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
        <Grid x:Name="PowerMeasureContent" Margin="0,0,8,0">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="2.4*" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource PmPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding StageText}" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding RunControlsVisibility}">
                            <TextBlock Text="Tolerance Mode" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="105" Height="28" VerticalContentAlignment="Center" IsEnabled="{Binding CanEdit}" />
                            <TextBlock Text="{Binding ToleranceText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="AUTO · Head별 허용오차 / 최대 검사 횟수 적용" Visibility="{Binding AutoSettingsVisibility}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding QueueText}" ToolTip="{Binding QueueText}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Stage Y 0 mm / Scanner CENTER" DockPanel.Dock="Right" Foreground="DarkOrange" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Head별 전용 PowerMeter · 병렬 측정" FontSize="12" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataGrid x:Name="HeadGrid" Grid.Row="1" Style="{StaticResource PmGrid}" Margin="0,0,0,8"
                      ItemsSource="{Binding Heads}" SelectedItem="{Binding SelectedHead}" IsReadOnly="True"
                      Visibility="{Binding GridViewVisibility}"
                      Loaded="FitHeadRows" SizeChanged="FitHeadRows" ColumnHeaderHeight="42" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="HEAD" Binding="{Binding HeadName}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource PmCellText}" />
                    <DataGridTemplateColumn Header="PowerMeter" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBlock Text="{Binding SelectedPowerMeter.DisplayText}" FontSize="12" Margin="2,1" VerticalAlignment="Center" TextAlignment="Center" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="0.85*">
                        <DataGridTemplateColumn.Header><TextBlock Text="Settle Time&#x0a;(ms)" TextAlignment="Center" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBox Text="{Binding SettleTime, UpdateSourceTrigger=PropertyChanged}" Tag="Settle Time (ms)" Height="26" FontSize="13" Margin="2,1"
                                     IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="0.8*">
                        <DataGridTemplateColumn.Header><TextBlock Text="Measure&#x0a;Count" TextAlignment="Center" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBox Text="{Binding MeasureCount, UpdateSourceTrigger=PropertyChanged}" Tag="Measure Count" Height="26" FontSize="13" Margin="2,1"
                                     IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="0.8*">
                        <DataGridTemplateColumn.Header><TextBlock Text="Interval&#x0a;(ms)" TextAlignment="Center" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBox Text="{Binding MeasureInterval, UpdateSourceTrigger=PropertyChanged}" Tag="Interval (ms)" Height="26" FontSize="13" Margin="2,1"
                                     IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="0.85*">
                        <DataGridTemplateColumn.Header><TextBlock Text="Target&#x0a;(W)" TextAlignment="Center" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Tag="Target Power (W)" Height="26" FontSize="13" Margin="2,1"
                                     IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Measured}" Width="0.9*" IsReadOnly="True" ElementStyle="{StaticResource PmCellText}">
                        <DataGridTextColumn.Header><TextBlock Text="Measured&#x0a;(W)" TextAlignment="Center" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Error}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource PmCellText}">
                        <DataGridTextColumn.Header><TextBlock Text="Diff&#x0a;(W)" TextAlignment="Center" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Angle}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource PmCellText}">
                        <DataGridTextColumn.Header><TextBlock Text="ATT&#x0a;(°)" TextAlignment="Center" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="AutoToleranceColumn" Binding="{Binding Tolerance}" Width="0.8*" MinWidth="65" IsReadOnly="True" Visibility="Collapsed" ElementStyle="{StaticResource PmCellText}">
                        <DataGridTextColumn.Header><TextBlock Text="허용오차&#x0a;(W)" TextAlignment="Center" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="AutoAttemptsColumn" Binding="{Binding AttemptProgress}" Width="0.8*" MinWidth="75" IsReadOnly="True" Visibility="Collapsed" ElementStyle="{StaticResource PmCellText}">
                        <DataGridTextColumn.Header><TextBlock Text="검사 횟수&#x0a;현재 / 최대" TextAlignment="Center" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="State" Width="1.2*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Border Background="{Binding StateBackground}" CornerRadius="2" Margin="2,1" Padding="2,1" ToolTip="{Binding Snapshot.Message}">
                            <TextBlock Text="{Binding State}" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding GraphViewVisibility}">
                <ItemsControl x:Name="HeadGraphs" ItemsSource="{Binding Heads}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.GraphColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Style="{StaticResource PmGraphCard}" Command="{Binding DataContext.SelectGraphHeadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{Binding StateBackground}" CornerRadius="2" Padding="5,2" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding State}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding HeadName}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Grid.Row="1" Margin="0,3,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Measured, StringFormat='Measured {0} W'}" Foreground="SteelBlue" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Target, StringFormat='Target {0} W'}" Foreground="DarkOrange" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ContentControl Grid.Row="2" Content="{Binding Graph}" ContentTemplate="{StaticResource PmGraph}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        <TextBlock Grid.Row="3" Text="{Binding GraphSummary}" FontSize="11" Margin="0,2,0,0" />
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Head Select에서 표시할 Head를 선택해 주세요." HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasHeads}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PmPanel}" Margin="0,0,8,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding DetailTitle}" ToolTip="{Binding DetailTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12" />
                        <TextBlock Grid.Row="1" Text="Blue: Measured / Orange: Target" HorizontalAlignment="Right" FontSize="10" />
                        <ContentControl Grid.Row="2" Content="{Binding Graph}" ContentTemplate="{StaticResource PmGraph}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="{Binding DetailMessage}" ToolTip="{Binding DetailMessage}" TextTrimming="CharacterEllipsis" FontSize="12" />
                    </Grid>
                </Border>
                <DataGrid Grid.Column="1" ItemsSource="{Binding Samples}" Style="{StaticResource PmGrid}" IsReadOnly="True" RowHeight="24" ColumnHeaderHeight="28" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Attempt}" Width="0.4*" ElementStyle="{StaticResource PmCellText}" />
                        <DataGridTextColumn Header="ATT (°)" Binding="{Binding Angle, StringFormat=F4}" Width="*" ElementStyle="{StaticResource PmCellText}" />
                        <DataGridTextColumn Header="Power (W)" Binding="{Binding Power, StringFormat=F4}" Width="*" ElementStyle="{StaticResource PmCellText}" />
                        <DataGridTextColumn Header="Diff (W)" Binding="{Binding Error, StringFormat=F4}" Width="*" ElementStyle="{StaticResource PmCellText}" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="0.7*" ElementStyle="{StaticResource PmCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <DockPanel Grid.Row="3">
                <Button x:Name="ViewToggle" DockPanel.Dock="Left" Content="{Binding ViewToggleText}" Command="{Binding ToggleViewCommand}" Style="{StaticResource PmButton}" Width="155" Height="42" Margin="0,0,12,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding RunControlsVisibility}">
                    <Button Content="START" Command="{Binding StartCommand}" Style="{StaticResource PmButton}" Background="SeaGreen" Width="145" Height="42" Margin="0,0,8,0" FontSize="16" />
                    <Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource PmButton}" Background="Firebrick" Width="145" Height="42" FontSize="16" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
