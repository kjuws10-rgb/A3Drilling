                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0" />
                                        <Border Width="16"
                                                Height="12"
                                                Background="Transparent"
                                                BorderBrush="#E65A5A"
                                                BorderThickness="2"
                                                Margin="0,0,6,0" />
                                        <TextBlock Text="= MASKING"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentScreen.Monitor.CoordinateSelectedBasisName}"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,18,0" />
                                    <TextBlock Text="{Binding CurrentScreen.Monitor.CoordinateSelectedCellName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="14"
                                               Margin="0,0,18,0" />
                                    <TextBlock Text="{Binding CurrentScreen.Monitor.CoordinateSelectedShotName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="14" />
                                </StackPanel>
                            </Grid>

                            <Border Visibility="{Binding CurrentScreen.Monitor.CoordinateIsGlassPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10">
                                <Grid>
                                    <Grid x:Name="CoordinateGlassPreviewViewport"
                                          ClipToBounds="True">
                                        <Image Source="{Binding CurrentScreen.Monitor.CoordinateGlassPreviewImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                                        <ItemsControl ItemsSource="{Binding CurrentScreen.Monitor.CoordinateCellPreviewLabels}"
                                                      Style="{StaticResource CellPreviewLabelItemsControl}"
                                                      IsHitTestVisible="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.SelectCoordinateCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding CellNo}"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            MouseMove="CoordinateCellPreviewLabel_MouseMove"
                                                            MouseLeave="CoordinateCellPreviewLabel_MouseLeave">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="2"
                                                                                    SnapsToDevicePixels="True">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding CurrentScreen.Monitor.CoordinateGlassPreviewSummary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,10,8"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <Border x:Name="CoordinateGlassPreviewHoverTip"
                                            Panel.ZIndex="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="7,3"
                                            Background="{DynamicResource PreviewHoverTipBackgroundBrush}"
                                            BorderBrush="{DynamicResource PreviewHoverTipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CoordinateGlassPreviewHoverTipTranslateTransform" />
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="CoordinateGlassPreviewHoverTipText"
                                                   Foreground="{DynamicResource PreviewHoverTipTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Visibility="{Binding CurrentScreen.Monitor.CoordinateIsCellDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Content="BACK TO GLASS"
                                            menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Monitor.BackToCoordinateGlassPreviewCommand}"
                                            HorizontalAlignment="Left"
                                            MinWidth="132"
                                            Height="34"
                                            Padding="12,0"
                                            Margin="0,0,0,8"
                                            Background="{DynamicResource ButtonSecondaryBrush}"
                                            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Cursor="Hand" />

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CurrentScreen.Monitor.CoordinateShotMatrixRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding Shots}"
                                                                  HorizontalAlignment="Stretch"
                                                                  Margin="0,0,0,5">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button menu:CButtonCommandBehavior.Command="{Binding SelectCommand}"
                                                                        CommandParameter="{Binding ShotKey}"
                                                                        Width="132"
                                                                        Height="78"
                                                                        Margin="3"
                                                                        Padding="5"
                                                                        Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Background" Value="{Binding BackgroundBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
                                                                            <Setter Property="BorderThickness" Value="{Binding BorderThickness}" />
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}"
                                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                CornerRadius="4">
                                                                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                                                              HorizontalAlignment="Stretch"
                                                                                                              VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="*" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Text="{Binding ShotName}"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   FontSize="12"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center" />
                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{Binding Detail}"
                                                                                   Foreground="{Binding DetailBrush}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   TextAlignment="Center"
                                                                                   TextWrapping="Wrap"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding CurrentScreen.Monitor.IsGenericDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding CurrentScreen.Monitor.StatusPanelTitle}"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.StatusRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  ColumnHeaderHeight="38"
                                  RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="150" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="130" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                                <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding CurrentScreen.Monitor.ParameterPanelTitle}"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.ParameterRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  ColumnHeaderHeight="38"
                                  RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="220" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
