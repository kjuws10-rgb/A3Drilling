<UserControl x:Class="Drilling.UI.Views.CMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu"
             xmlns:ui="clr-namespace:Drilling.UI"
             xmlns:views="clr-namespace:Drilling.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="MonitorViewLoaded"
             Unloaded="MonitorViewUnloaded"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="MelsecDescriptionRow" TargetType="DataGridRow">
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip>
                        <TextBlock Text="{Binding PlacementTarget.DataContext.Description, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                   MaxWidth="480"
                                   TextWrapping="Wrap" />
                    </ToolTip>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Description}" Value="">
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonitorSmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MonitorValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ProductProcessTabItem" TargetType="TabItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductProcessTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ProductProcessTabItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Padding="8,6"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <ItemsPresenter VerticalAlignment="Center"
                                                ClipToBounds="False" />
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="0,8,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorInputButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource HeaderNavPressedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MonitorComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Shell" Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1"><Grid><TextBlock x:Name="SelectedText" Margin="8,0,28,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /><Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /><Setter TargetName="SelectedText" Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" /><Setter TargetName="SelectedText" Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" StaysOpen="False"><Border Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"><ScrollViewer MaxHeight="220"><ItemsPresenter /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorTabButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorActionButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="XpsJogButton"
               TargetType="Button"
               BasedOn="{StaticResource MonitorActionButton}">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoCommandButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="66" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorInputCell" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MonitorInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding CurrentScreen.IsMonitorLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding CurrentScreen.Monitor.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="31"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentScreen.Monitor.Subtitle}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="15" />
        </StackPanel>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding CurrentScreen.Monitor.Tabs}"
                      Margin="0,6,0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}"
                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Name}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MonitorTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid Visibility="{Binding CurrentScreen.Monitor.IsMotor, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="XPS Axis Monitor"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.AxisRows}"
                                  SelectedItem="{Binding CurrentScreen.Monitor.SelectedAxisRow, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="36"
                                  RowHeight="34"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" Width="64" />
                                <DataGridTextColumn Header="Positioner" Binding="{Binding Name}" Width="1.25*" />
                                <DataGridTextColumn Header="Current" Binding="{Binding CurrentPosition}" Width="*" />
                                <DataGridTextColumn Header="Speed (mm/sec)" Binding="{Binding FeedbackVelocity}" Width="1.15*" />
                                <DataGridTextColumn Header="Accel (mm/sec2)" Binding="{Binding FeedbackAcceleration}" Width="1.2*" />
                                <DataGridTextColumn Header="Servo" Binding="{Binding Servo}" Width="58">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ServoBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Home" Width="58">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding HomeBrush}" Padding="6,4">
                                                <TextBlock Text="{Binding Home}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Lim+" Width="54">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding LimitPlusBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Lim-" Width="54">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding LimitMinusBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Alarm" Width="64">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding AlarmBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="78" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding CurrentScreen.Monitor.SelectedAxisRow.Name, StringFormat=XPS Axis Operation  (Selected Axis : {0})}"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,8">
                            <Button Content="SERVO ON"
                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Monitor.ExecuteOperationCommand}"
                                    CommandParameter="SERVO ON"
                                    Margin="0,0,6,0"
                                    Background="#2F7852"
                                    BorderBrush="#4A9D72"
                                    Style="{StaticResource MonitorActionButton}" />
                            <Button Content="SERVO OFF"
                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Monitor.ExecuteOperationCommand}"
                                    CommandParameter="SERVO OFF"
                                    Margin="2,0,4,0"
                                    Background="{DynamicResource ButtonSecondaryBrush}"
                                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Style="{StaticResource MonitorActionButton}" />
                            <Button Content="HOME"
                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Monitor.ExecuteOperationCommand}"
                                    CommandParameter="HOME"
                                    Margin="4,0,2,0"
                                    Background="#416C92"
                                    BorderBrush="#5B87AE"
                                    Style="{StaticResource MonitorActionButton}" />
                            <Button Content="ALARM RESET"
                                    menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Monitor.ExecuteOperationCommand}"
                                    CommandParameter="ALARM RESET"
                                    Margin="6,0,0,0"
                                    Background="{DynamicResource ButtonSecondaryBrush}"
                                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Style="{StaticResource MonitorActionButton}" />
                        </UniformGrid>

                        <ScrollViewer x:Name="XpsOperationScrollViewer"
                                      Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                        <Grid MinHeight="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportHeight}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="244" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="188" />
                                <RowDefinition Height="*" MinHeight="188" />
                            </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource GridBackgroundBrush}"
                                            Padding="8"
                                            Margin="0,0,6,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="54" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="ABS MOVE"
                                                       Style="{StaticResource PanelTitle}"
                                                       FontSize="15"
                                                       Margin="0,0,0,8" />
                                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Cur Pos"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MonitorSmallText}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CurrentScreen.Monitor.SelectedAxisRow.CurrentPosition}"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="mm"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MonitorSmallText}" />
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Target Pos"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MonitorSmallText}" />
                                                <Button Grid.Column="1"
                                                        Content="{Binding CurrentScreen.Monitor.OperationFields[0].Value}"
                                                        Tag="{Binding CurrentScreen.Monitor.OperationFields[0]}"
                                                        Click="OpenMotorOperationInput"
                                                        Style="{StaticResource MonitorInputButton}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CurrentScreen.Monitor.OperationFields[0].Unit}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MonitorSmallText}" />
                                            </Grid>
                                            <Grid Grid.Row="3" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Speed"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MonitorSmallText}" />
                                                <Button Grid.Column="1"
                                                        Content="{Binding CurrentScreen.Monitor.OperationFields[1].Value}"
