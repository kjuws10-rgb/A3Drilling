<UserControl x:Class="Drilling.UI.Views.CManualInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Drilling.UI.Views"
             FontFamily="Segoe UI" Loaded="View_Loaded" Unloaded="View_Unloaded"
             DataContextChanged="View_DataContextChanged" PreviewKeyDown="View_PreviewKeyDown" LayoutUpdated="View_LayoutUpdated">
    <UserControl.Resources>
        <!-- The combo templates below are copied from the existing Review screen;
             every surface continues to use the application's Light/Dark resources. -->
        <ControlTemplate x:Key="ManualButtonTemplate" TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.44" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Shell" Property="BorderThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ManualComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManualComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ManualComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource GridBackgroundBrush}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,34,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="10"
                                                      Height="5"
                                                      Stretch="Fill"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                                <Setter TargetName="Shell" Property="TextElement.Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                                <Setter TargetName="Shell" Property="TextElement.Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource GridBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManualPanel" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="CornerRadius" Value="6" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="ManualButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Template" Value="{StaticResource ManualButtonTemplate}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" /><Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" /><Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="ManualPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template" Value="{StaticResource ManualButtonTemplate}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" /><Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" /><Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="ManualLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ManualTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
            <Setter Property="FontSize" Value="18" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ManualInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Padding" Value="7,5" /><Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ManualGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="30" /><Setter Property="ColumnHeaderHeight" Value="31" />
            <Setter Property="FontSize" Value="11" /><Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>
        <Style x:Key="ManualCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Manual Inspection side pages reuse the existing theme brushes and flat button geometry. -->
        <Style x:Key="ManualSideTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="66" /><Setter Property="Padding" Value="5,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="SideTabSurface" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="SideTabSurface" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="SideTabSurface" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SideTabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SideTabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ManualSideTabs" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,4,0,0" />
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ManualSideSection" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <ContentPresenter x:Name="SideSectionContent" ContentSource="Content" />
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="SideSectionContent" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ShellBackgroundBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border x:Name="ToolbarPanel" Grid.Row="0" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,0,4">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" ClipToBounds="True">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
              <TextBlock Text="2D 결과 지도" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" ToolTip="MANUAL INSPECTION · 지도에서 선택하고 우클릭으로 동작합니다." />
              <Border Grid.Column="1" x:Name="FinalCsvSourceBadge" Margin="8,0,4,0" Padding="6,2" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBackgroundBrush}" HorizontalAlignment="Left" MaxWidth="420">
                <TextBlock x:Name="FinalCsvSourceText" Text="Offset CSV 확인 중" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Border>
            </Grid>


            <Button Grid.Column="3" Width="82" Margin="6,0,0,0"  x:Name="ZoomResetButton" Content="100% · 맞춤" Padding="5,2" FontSize="11" Style="{StaticResource ManualButton}" Click="ZoomReset_Click" ToolTip="전체 범위를 화면에 맞춥니다. 실제 장비 위치는 바뀌지 않습니다." />
            <Button Grid.Column="4" Width="66" Content="선택 ▾" Style="{StaticResource ManualButton}" Click="SelectionTools_Click" Padding="5,2" Margin="6,0,0,0" ToolTip="보이는 점 전체 / NG만 / 선택 해제" />
            <Button Grid.Column="5" Width="72" Margin="6,0,0,0"  x:Name="FilesButton" Content="파일 ▾" Padding="5,2" Style="{StaticResource ManualButton}" Click="Files_Click" ToolTip="통합 Offset 파일 가져오기 · 현재 Offset 데이터 CSV 내보내기" />
            <Button Grid.Column="6" Width="32" Margin="6,0,0,0"  x:Name="LoadRecipeButton" Content="↻" Padding="0" FontSize="17" AutomationProperties.Name="결과 새로고침" Tag="Refresh" Style="{StaticResource ManualButton}" Click="Action_Click" ToolTip="현재 표시한 자료를 다시 읽습니다. 파일 작업과 복귀 지점은 유지합니다." />
            <Button Grid.Column="7" Width="68" Margin="6,0,0,0"  x:Name="StopButton" Content="■ 중지" Padding="5,2" Tag="Stop" Style="{StaticResource ManualButton}" Click="Action_Click" Background="{DynamicResource ButtonDangerBrush}" Foreground="{DynamicResource ButtonTextOnColorBrush}" ToolTip="Esc · 현재 동작에 중지를 요청합니다. 정리 완료 전까지 새 동작을 시작하지 않습니다." AutomationProperties.Name="현재 동작 중지" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,10,0" x:Name="ContextText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <Grid Grid.Column="1" Height="20" MaxWidth="300" Margin="0,0,12,0">
              <TextBlock MaxHeight="18" x:Name="StatusText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <StackPanel x:Name="JobProgressPanel" Visibility="Collapsed" MinWidth="90" MaxWidth="300">
                <TextBlock x:Name="JobProgressText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="JobProgressBar" Height="3" Margin="0,2,0,0" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="현재 작업 진행"/>
              </StackPanel>
            </Grid>
            <TextBlock Grid.Column="2" MaxWidth="250" x:Name="SelectionCountText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Grid>
      </Border>
      <TextBlock Grid.Row="1" MaxHeight="18" Margin="4,0,4,4" x:Name="MessageText" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <Grid x:Name="EditorBody" Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeftInspectorColumn" Width="Auto"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition Width="*" MinWidth="0"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition x:Name="InspectorColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="2">
          <Expander x:Name="LeftInspectorSection" ExpandDirection="Right" IsExpanded="False" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Stretch" Expanded="SideSection_Expanded">
            <Expander.Header>
              <TextBlock Text="도구 · 조회" FontWeight="SemiBold" FontSize="12" Margin="2,6">
                <TextBlock.LayoutTransform>
                  <RotateTransform Angle="-90"/>
                </TextBlock.LayoutTransform>
              </TextBlock>
            </Expander.Header>
            <ScrollViewer x:Name="LeftInspectorScroll" Width="250" Margin="0,0,7,0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="FilterNoticeText" Foreground="{DynamicResource ButtonWarningBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="30" Margin="3,2,3,2"/>
                <Grid Grid.Row="1">
                  <TabControl x:Name="LeftPaneTabs" Style="{StaticResource ManualSideTabs}" SelectionChanged="LeftPane_SelectionChanged">
                    <TabItem x:Name="LeftFiltersTab" Header="필터" Style="{StaticResource ManualSideTab}">
                      <Expander x:Name="WorkInfoSection" Header="필터" IsExpanded="True" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                        <StackPanel Margin="3,4,3,2">
                          <TextBlock Text="Cell · 표시 기준" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                          <ComboBox Grid.Column="1" Width="Auto" Margin="0,0,0,4" x:Name="CellFilter" Style="{StaticResource ManualComboBox}" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" AutomationProperties.Name="지도 Cell 범위" ToolTip="지도와 결과 표의 Cell 범위입니다. 산포도는 별도 범위를 사용합니다."/>
                          <TextBlock x:Name="MeasurementLevelLabel" Text="측정 편차 Level" Style="{StaticResource ManualLabel}" Margin="0,0,0,4"/>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                              <TextBlock Text="측정 상태" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <ComboBox x:Name="JudgeFilter" Style="{StaticResource ManualComboBox}" SelectionChanged="Filter_Changed" AutomationProperties.Name="지도 측정 상태 필터" ToolTip="현재 측정·복사 편차의 상태를 구분합니다. 저장된 Offset만 있는 점은 새 측정 전까지 미측정입니다."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                              <TextBlock Text="Head" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <ComboBox x:Name="HeadFilter" Style="{StaticResource ManualComboBox}" DisplayMemberPath="Label" SelectionChanged="Filter_Changed"/>
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="측정 출처" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                          <ComboBox x:Name="SourceFilter" Style="{StaticResource ManualComboBox}" SelectionChanged="Filter_Changed"/>
                          <Expander x:Name="SearchSection" Header="위치 검색" IsExpanded="True" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                            <StackPanel Margin="3,4,3,2">
                                <TextBlock Text="위치 검색" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <TextBox x:Name="SearchBox" Style="{StaticResource ManualInput}" TextChanged="Search_Changed" AutomationProperties.Name="Cell Head Shot Beam 위치 검색" AutomationProperties.HelpText="Ctrl F로 검색을 엽니다. 위치 키 또는 Cell Head Shot Beam 식별자를 입력합니다." ToolTip="위치 키 또는 C / H / S / B 식별자 · 검색은 지도·표만 필터합니다."/>
                              <TextBlock Text="결과 표 정렬" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <ComboBox x:Name="SortFilter" Style="{StaticResource ManualComboBox}" SelectionChanged="Filter_Changed"/>
                            </StackPanel>
                          </Expander>
                          <WrapPanel Margin="0,5,0,0">
                            <Button Content="필터 초기화" Style="{StaticResource ManualButton}" Click="ResetFilters_Click" FontSize="11" Padding="6,4"/>
                              <Button Content="−" Style="{StaticResource ManualButton}" Click="ZoomOut_Click" ToolTip="지도 축소 · Ctrl 휠" AutomationProperties.Name="지도 축소"/>
                              <Button Content="+" Style="{StaticResource ManualButton}" Click="ZoomIn_Click" ToolTip="지도 확대 · Ctrl 휠" AutomationProperties.Name="지도 확대"/>
                          </WrapPanel>
                        </StackPanel>
                      </Expander>
                    </TabItem>
                    <TabItem x:Name="LeftLegendTab" Header="범례" Style="{StaticResource ManualSideTab}">
                      <StackPanel Margin="3,4,3,2">
                        <TextBlock x:Name="ColorDescriptionText" Style="{StaticResource ManualLabel}" TextWrapping="Wrap"/>
                        <TextBlock Text="NG 빨강 · 미측정/초기화 회색" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                        <TextBlock Text="테두리: 선택 / 대표" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                        <WrapPanel x:Name="MapLegendItems"/>
                        <TextBlock x:Name="MapLegendText" Style="{StaticResource ManualLabel}" Visibility="Collapsed"/>
                      </StackPanel>
                    </TabItem>
                    <TabItem x:Name="LeftInfoTab" Header="정보" Style="{StaticResource ManualSideTab}">
                      <StackPanel Margin="3,4,3,2">
                        <TextBlock Text="저장된 최종 Review Offset" FontWeight="SemiBold" Style="{StaticResource ManualLabel}"/>
                        <TextBlock x:Name="FinalOffsetFileText" Style="{StaticResource ManualLabel}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FinalOffsetInfoText" Style="{StaticResource ManualLabel}" TextWrapping="Wrap" MaxHeight="48"/>
                        <TextBlock x:Name="StagePositionText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas" ToolTip="마지막 도착 확인 목표입니다. 실시간 모터 피드백이 아닙니다."/>
                        <TextBlock x:Name="PersistenceText" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="방향키 한 점 · Ctrl 끝 · Shift 범위" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                        <TextBlock Text="Ctrl+Shift 끝까지 · Space 동작 메뉴" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                        <TextBlock Text="Alt 방향키 보기 이동 · Ctrl 휠 확대" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                        <TextBlock Text="더블클릭 맞춤 · Esc 메뉴 닫기" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                      </StackPanel>
                    </TabItem>
                    <TabItem x:Name="LeftScatterTab" Header="산포" Style="{StaticResource ManualSideTab}">
                      <Expander x:Name="ScatterSection" Header="산포도" IsExpanded="False" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                        <ScrollViewer x:Name="ScatterSectionContent" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                          <TabControl x:Name="ScatterPaneTabs" Style="{StaticResource ManualSideTabs}" SelectionChanged="ScatterPane_SelectionChanged">
                            <TabItem x:Name="ScatterGraphTab" Header="그래프" Style="{StaticResource ManualSideTab}">
                              <StackPanel Margin="3,4,3,2">
                                <StackPanel x:Name="ScatterQuickControls">
                                  <ComboBox x:Name="ScatterDataCombo" Width="Auto" HorizontalAlignment="Left" Margin="0,0,6,6" Style="{StaticResource ManualComboBox}" SelectionChanged="Scatter_Changed"/>
                                  <UniformGrid Columns="3">
                                    <Button x:Name="ScatterCellButton" Content="현재 셀" Tag="CELL" Style="{StaticResource ManualButton}" Click="ScatterScope_Click" FontSize="10" Padding="3,3" Margin="0,0,2,3" MinHeight="26"/>
                                    <Button x:Name="ScatterHeadButton" Content="전체 셀 · Head별" Tag="HEAD" Style="{StaticResource ManualButton}" Click="ScatterScope_Click" FontSize="10" Padding="3,3" Margin="0,0,2,3" MinHeight="26"/>
                                    <Button x:Name="ScatterCellsButton" Content="선택 셀들" Tag="CELLS" Style="{StaticResource ManualButton}" Click="ScatterScope_Click" FontSize="10" Padding="3,3" Margin="0,0,2,3" MinHeight="26"/>
                                  </UniformGrid>
                                </StackPanel>
                                <Grid x:Name="ScatterPlotRow" Height="190">
                                  <views:CManualInspectionScatterControl x:Name="ScatterPlot" MinHeight="150" Height="190" AutomationProperties.Name="측정 편차 산포도" AutomationProperties.HelpText="측정 편차를 현재 Cell·Head·선택 Cell 범위로 봅니다. 점을 클릭하면 지도와 선택이 연결됩니다. Ctrl 휠 또는 확대 축소 버튼으로 보기를 바꾸고 더블클릭하면 Auto로 맞춥니다. 원측정 기록은 기존 보정 기반 값을 포함하지 않습니다."/>
                                </Grid>
                              </StackPanel>
                            </TabItem>
                            <TabItem x:Name="ScatterStatsTab" Header="통계" Style="{StaticResource ManualSideTab}">
                              <ScrollViewer x:Name="ScatterStatisticsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3,4,3,2">
                                  <TextBlock x:Name="ScatterMetricsText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Normal" TextWrapping="Wrap"/>
                                  <TextBlock x:Name="ScatterExcludedText" Style="{StaticResource ManualLabel}" Margin="0,10,0,6" FontSize="10"/>
                                  <DataGrid x:Name="ScatterGroupsGrid" Style="{StaticResource ManualGrid}" MaxHeight="110" RowHeight="26" FontSize="10">
                                    <DataGrid.Columns>
                                      <DataGridTextColumn Header="범위" Binding="{Binding Group}" Width="40"/>
                                      <DataGridTextColumn Header="점" Binding="{Binding Count}" Width="35"/>
                                      <DataGridTextColumn Header="평균 X/Y µm" Binding="{Binding Mean}" Width="*"/>
                                    </DataGrid.Columns>
                                  </DataGrid>
                                  <WrapPanel x:Name="ScatterLegendItems" Margin="0,4,0,2"/>
                                  <TextBlock x:Name="ScatterLegendText" Style="{StaticResource ManualLabel}"/>
                                </StackPanel>
                              </ScrollViewer>
                            </TabItem>
                            <TabItem x:Name="ScatterAxisTab" Header="축 설정" Style="{StaticResource ManualSideTab}">
                              <Expander x:Name="ScatterSettingsSection" Header="축 설정" IsExpanded="False" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                                <StackPanel Margin="3,4,3,2">
                                  <WrapPanel>
                                    <Button x:Name="ScatterAutoButton" Content="Auto" Style="{StaticResource ManualButton}" Click="ScatterAuto_Click" ToolTip="현재 범위의 유효 오차와 원점을 포함해 두 축을 자동으로 맞춥니다."/>
                                    <Button x:Name="ScatterZoomOutButton" Content="−" Style="{StaticResource ManualButton}" Click="ScatterZoomOut_Click" AutomationProperties.Name="산포도 축소"/>
                                    <Button x:Name="ScatterFitButton" Content="맞춤" Style="{StaticResource ManualButton}" Click="ScatterAuto_Click" ToolTip="더블클릭과 동일: 확대/고정축을 해제하고 현재 모집단을 Auto로 맞춥니다."/>
                                    <Button x:Name="ScatterZoomInButton" Content="+" Style="{StaticResource ManualButton}" Click="ScatterZoomIn_Click" AutomationProperties.Name="산포도 확대"/>
                                  </WrapPanel>
                                  <TextBlock Text="고정 반범위 ± µm" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ScatterRangeInput" Text="20" Width="Auto" Style="{StaticResource ManualInput}" KeyDown="ScatterRange_KeyDown" Margin="0,0,4,6" AutomationProperties.Name="산포도 고정 축 반범위 마이크로미터" ToolTip="양수 µm를 입력한 뒤 Enter 또는 축 적용. X/Y 두 축에 같은 ±범위를 사용합니다."/>
                                    <Button x:Name="ScatterRangeApplyButton" Content="축 적용" Style="{StaticResource ManualButton}" Click="ScatterRangeApply_Click" ToolTip="입력한 ±범위로 표시축만 고정합니다. 측정값과 보정값은 바뀌지 않습니다." Grid.Column="1"/>
                                  </Grid>
                                  <TextBlock x:Name="ScatterAxisText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                </StackPanel>
                              </Expander>
                            </TabItem>
                            <TabItem x:Name="ScatterTargetsTab" Header="대상" Style="{StaticResource ManualSideTab}">
                              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ScatterScopeControls" Margin="0,4,0,7"/>
                              </ScrollViewer>
                            </TabItem>
                          </TabControl>
                        </ScrollViewer>
                      </Expander>
                    </TabItem>
                    <TabItem x:Name="LeftSettingsTab" Header="설정" Style="{StaticResource ManualSideTab}">
                      <Expander x:Name="SettingsSection" Header="설정" IsExpanded="False" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                        <TabControl x:Name="SettingsPaneTabs" Style="{StaticResource ManualSideTabs}" SelectionChanged="SettingsPane_SelectionChanged">
                          <TabItem x:Name="SettingsMeasureTab" Header="측정" Style="{StaticResource ManualSideTab}">
                            <StackPanel Margin="3,4,3,2">
                              <TextBlock Text="측정 방식" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <ComboBox x:Name="MeasurementModeCombo" Style="{StaticResource ManualComboBox}"/>
                              <TextBlock Text="Flying은 해당 Cell·Head·행·Beam의 유효점을 검사합니다." Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <Button x:Name="LevelsButton" Content="Level 범위" Style="{StaticResource ManualButton}" Click="Levels_Click"/>
                            </StackPanel>
                          </TabItem>
                          <TabItem x:Name="SettingsLimitsTab" Header="한계" Style="{StaticResource ManualSideTab}">
                            <StackPanel Margin="3,4,3,2">
                              <TextBlock Text="입력 편차 상한 µm" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <TextBox x:Name="DeltaLimitInput" Style="{StaticResource ManualInput}"/>
                              <TextBlock Text="저장값 상한 µm" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <TextBox x:Name="TotalLimitInput" Style="{StaticResource ManualInput}"/>
                              <TextBlock Text="Scanner Field mm" Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                              <TextBox x:Name="FieldLimitInput" Style="{StaticResource ManualInput}"/>
                              <Button x:Name="SaveLimitsButton" Content="한계 설정 적용" Style="{StaticResource ManualButton}" Click="Limits_Click" Margin="0,7,0,8"/>
                            </StackPanel>
                          </TabItem>
                          <TabItem x:Name="SettingsLevelsTab" Header="Level" Style="{StaticResource ManualSideTab}">
                            <StackPanel Margin="3,4,3,2">
                              <StackPanel x:Name="LevelSettingsPanel" Visibility="Collapsed"/>
                            </StackPanel>
                          </TabItem>
                        </TabControl>
                      </Expander>
                    </TabItem>
                    <TabItem x:Name="LeftHistoryTab" Header="이력" Style="{StaticResource ManualSideTab}">
                      <Grid Margin="3,4,3,2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="OffsetHistoryText" Style="{StaticResource ManualLabel}"/>
                        <ScrollViewer x:Name="HistoryItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl x:Name="RevisionItems">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding DisplayText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Grid>
                    </TabItem>
                  </TabControl>
                </Grid>
              </Grid>
            </ScrollViewer>
          </Expander>
        </Border>
        <ScrollViewer x:Name="WorkspaceScroll" Grid.Column="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="WorkspaceBody" Height="{Binding ViewportHeight,ElementName=WorkspaceScroll}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="MapPanel" Grid.Row="0" Style="{StaticResource ManualPanel}" Padding="0" Margin="0,0,0,3" ClipToBounds="True">
              <Grid>
                <Border x:Name="MapViewportFrame" ClipToBounds="True">
                  <views:CManualInspectionMapControl x:Name="PositionMap" MinHeight="80" AutomationProperties.Name="측정 결과 2D 지도" AutomationProperties.HelpText="전체 Cell에서 셀 내부나 번호 클릭은 해당 Cell을 엽니다. 드래그로 점을 선택하고 Ctrl 드래그로 추가합니다. 방향키는 한 점, Ctrl 방향키는 행·열 끝, Shift 방향키는 범위 선택, Ctrl Shift 방향키는 끝까지 범위 선택입니다. Space는 동작 메뉴, Esc는 메뉴 닫기, Alt 방향키는 보기 이동, Ctrl 휠은 확대 축소입니다. 단일 Cell의 측정점 더블클릭은 편차 키패드 입력, 빈 공간 더블클릭은 맞춤입니다."/>
                </Border>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource ManualPanel}" Padding="4,2" Margin="0">
              <Expander x:Name="ResultsSection" Header="측정 결과 표" IsExpanded="False" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                <ScrollViewer x:Name="ResultsSectionContent" MaxHeight="164" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,6,0,0">
                    <TextBlock x:Name="ResultStatsText" Style="{StaticResource ManualLabel}"/>
                    <DataGrid x:Name="ResultGrid" Style="{StaticResource ManualGrid}" MaxHeight="112" MinHeight="80" SelectionChanged="ResultGrid_SelectionChanged" PreviewMouseLeftButtonDown="ResultGrid_LeftButtonDown" PreviewMouseRightButtonDown="ResultGrid_RightButtonDown">
                      <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                          <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="선택" Width="42">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Cell / Head / Shot / Beam" Binding="{Binding Point.Identity}" Width="180"/>
                        <DataGridTextColumn Header="측정 상태" Binding="{Binding Point.MeasurementStatusText}" Width="145"/>
                        <DataGridTextColumn Header="측정 편차 X/Y µm" Binding="{Binding Point.MeasurementErrorText}" Width="155"/>
                        <DataGridTextColumn Header="측정 Level" Binding="{Binding MeasurementLevelText}" Width="90"/>
                        <DataGridTextColumn Visibility="Collapsed" Header="보정 Level" Binding="{Binding AppliedLevelText}" Width="100"/>
                        <DataGridTextColumn Header="측정 출처" Binding="{Binding MeasurementOriginText}" Width="170"/>
                        <DataGridTextColumn Header="작업 상태" Binding="{Binding Point.SourceText}" Width="160"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                      <Button x:Name="PreviousPageButton" Content="이전" Style="{StaticResource ManualButton}" Click="PreviousPage_Click"/>
                      <TextBlock x:Name="PageText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,8,14,0"/>
                      <Button x:Name="NextPageButton" Content="다음" Style="{StaticResource ManualButton}" Click="NextPage_Click"/>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Expander>
            </Border>
          </Grid>
        </ScrollViewer>
        <Border Grid.Column="4" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="2">
          <Expander x:Name="InspectorSection" ExpandDirection="Left" IsExpanded="False" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Stretch" Expanded="SideSection_Expanded" ToolTip="선택점 요약 · 대표값 복사 · 보정 확인과 적용">
            <Expander.Header>
              <TextBlock Text="대표 · 보정" FontWeight="SemiBold" FontSize="12" Margin="2,6">
                <TextBlock.LayoutTransform>
                  <RotateTransform Angle="-90"/>
                </TextBlock.LayoutTransform>
              </TextBlock>
            </Expander.Header>
            <ScrollViewer x:Name="InspectorScroll" Width="280" Margin="7,0,0,0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="PointSummaryPanel" Style="{StaticResource ManualPanel}" Padding="6" Margin="0,0,0,4">
                  <StackPanel>
                    <TextBlock x:Name="PointScopeText" Text="포커스 위치" Style="{StaticResource ManualLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                    <TextBlock x:Name="PointTitleText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PointIdentityText" Style="{StaticResource ManualLabel}" Margin="0,2,0,4" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LastMeasurementText" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3" MaxHeight="30"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock x:Name="PointJudgesText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="NoWrap" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PointErrorText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="NoWrap" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <Button x:Name="MeasureCurrentButton" Content="현 위치 측정" Tag="Measure" Style="{StaticResource ManualButton}" Click="Action_Click" ToolTip="현재 도착한 선택 위치 한 점을 측정합니다." Grid.Column="1" FontSize="11" Padding="5,3" MinHeight="26" Margin="3,0,0,2"/>
                    </Grid>
                    <Button x:Name="RetryButton" Content="남은 위치만 재측정" Tag="RetryRemaining" Style="{StaticResource ManualButton}" Click="Action_Click" Margin="0,3,0,0" FontSize="11" MinHeight="26" Padding="4,3"/>
                  </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                  <TabControl x:Name="RightPaneTabs" Style="{StaticResource ManualSideTabs}" SelectionChanged="RightPane_SelectionChanged">
                    <TabItem x:Name="RightDetailsTab" Header="상세" Style="{StaticResource ManualSideTab}">
                      <StackPanel Margin="3,4,3,2">
                        <Expander x:Name="PointDetailsSection" Header="좌표 · 보정 · 출처" IsExpanded="True" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                          <TextBlock x:Name="PointDetailsText" Style="{StaticResource ManualLabel}" Margin="0,7,0,4" MaxHeight="150" TextTrimming="CharacterEllipsis"/>
                        </Expander>
                        <TextBlock x:Name="SelectionSummaryText" Style="{StaticResource ManualLabel}" Margin="0,8,0,3" Visibility="Collapsed" MaxHeight="45"/>
                        <TextBlock x:Name="SelectionLevelsText" Style="{StaticResource ManualLabel}" Margin="0,0,0,6" Visibility="Collapsed" MaxHeight="45"/>
                      </StackPanel>
                    </TabItem>
                    <TabItem x:Name="RightReferenceTab" Header="대표 복사" Style="{StaticResource ManualSideTab}">
                      <Expander x:Name="ReferenceSection" Header="대표값 복사" IsExpanded="False" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                        <StackPanel Margin="3,4,3,2">
                          <TextBlock x:Name="ReferenceText" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,0,8" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                          <Button x:Name="SetReferenceButton" Content="대표값으로 지정" Style="{StaticResource ManualButton}" Click="SetReference_Click" FontSize="11" Padding="5,4" MinHeight="28"/>
                          <TextBox x:Name="CopyReasonInput" Text="대표값 동일 반영" Style="{StaticResource ManualInput}" ToolTip="복사 사유"/>
                          <Button x:Name="CopyReferenceButton" Content="선택점에 복사" Style="{StaticResource ManualPrimaryButton}" Click="CopyReference_Click" FontSize="11" Padding="5,4" MinHeight="28"/>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ClearReferenceButton" Content="대표 해제" Style="{StaticResource ManualButton}" Click="ClearReference_Click" FontSize="11" Padding="3,4" MinHeight="28"/>
                            <Button x:Name="UndoCopyButton" Content="복사 취소" Tag="UndoCopy" Style="{StaticResource ManualButton}" Click="Action_Click" FontSize="11" Padding="3,4" MinHeight="28" Grid.Column="1"/>
                          </Grid>
                            <TextBlock Text="대표 편차를 작업에 대체합니다. CSV 저장은 현재 Cell 일괄 보정에서 합니다." Style="{StaticResource ManualLabel}" Margin="0,2,0,2"/>
                        </StackPanel>
                      </Expander>
                    </TabItem>
                    <TabItem x:Name="RightCorrectionTab" Header="보정" Style="{StaticResource ManualSideTab}">
                      <Expander x:Name="CorrectionSection" Header="현재 Cell CSV 저장" IsExpanded="False" Style="{StaticResource ManualSideSection}" Expanded="SideSection_Expanded">
                        <StackPanel Margin="3,4,3,2">
                          <TextBlock x:Name="SaveStatusText" Style="{StaticResource ManualLabel}" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                          <TextBlock x:Name="BulkSummaryText" Style="{StaticResource ManualLabel}" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                          <Button x:Name="BulkApplyButton" Content="현재 Cell 일괄 보정 · CSV 저장" Tag="BulkApply" Style="{StaticResource ManualPrimaryButton}" Click="Action_Click" MinHeight="28" Padding="5,4"/>
                          <Button x:Name="OffsetInitButton" Content="현재 Cell Offset Init" Tag="InitializeOffsets" Style="{StaticResource ManualButton}" Click="Action_Click" MinHeight="28" Padding="5,4" Margin="0,4,0,0"/>
                          <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="RollbackButton" Content="되돌리기 (0)" Style="{StaticResource ManualButton}" Click="Rollback_Click" MinHeight="28" Padding="3,4"/>
                            <Button x:Name="RedoOffsetsButton" Grid.Column="1" Content="다시 적용 (0)" Tag="RedoOffsets" Style="{StaticResource ManualButton}" Click="Action_Click" MinHeight="28" Padding="3,4"/>
                          </Grid>
                        </StackPanel>
                      </Expander>
                    </TabItem>
                  </TabControl>
                </Grid>
              </Grid>
            </ScrollViewer>
          </Expander>
        </Border>
      </Grid>
    </Grid>
</UserControl>
