<UserControl x:Class="Drilling.UI.Views.CManualInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Drilling.UI.Views"
             FontFamily="Segoe UI" Loaded="View_Loaded" Unloaded="View_Unloaded"
             DataContextChanged="View_DataContextChanged" PreviewKeyDown="View_PreviewKeyDown">
    <UserControl.Resources>
        <!-- The combo templates below are copied from the existing Review screen;
             every surface continues to use the application's Light/Dark resources. -->
        <ControlTemplate x:Key="ManualButtonTemplate" TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.44" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Shell" Property="BorderThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ManualComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManualComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ManualComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource GridBackgroundBrush}"
                                                BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,34,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="10"
                                                      Height="5"
                                                      Stretch="Fill"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                                <Setter TargetName="Shell" Property="TextElement.Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                                <Setter TargetName="Shell" Property="TextElement.Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource GridBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManualPanel" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="CornerRadius" Value="6" /><Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ManualButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Template" Value="{StaticResource ManualButtonTemplate}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" /><Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" /><Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="ManualPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template" Value="{StaticResource ManualButtonTemplate}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" /><Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" /><Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="ManualLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ManualTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
            <Setter Property="FontSize" Value="18" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ManualInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="Padding" Value="7,5" /><Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ManualGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="30" /><Setter Property="ColumnHeaderHeight" Value="31" />
            <Setter Property="FontSize" Value="11" /><Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>
        <Style x:Key="ManualCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,7">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="LoadRecipeButton" Content="현재 Recipe" Tag="LoadCurrentRecipe" Style="{StaticResource ManualButton}" Click="Action_Click" />
                <Button x:Name="LoadResultButton" Content="측정 결과 불러오기" Tag="LoadResultFile" Style="{StaticResource ManualButton}" Click="Action_Click" />
                <Button x:Name="FilesButton" Content="파일 · 세션 ▾" Style="{StaticResource ManualButton}" Click="Files_Click" />
                <Button x:Name="StopButton" Content="■ 중지" Tag="Stop" Style="{StaticResource ManualButton}" Click="Action_Click"
                        Background="{DynamicResource ButtonDangerBrush}" Foreground="{DynamicResource ButtonTextOnColorBrush}" />
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="MANUAL INSPECTION" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="리뷰 작업공간 · 측정과 보정" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="10,7" CornerRadius="4" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ContextText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="StagePositionText" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0"
                           ToolTip="마지막 이동에서 도착이 확인된 목표입니다. 실시간 모터 위치는 모션 모니터에서 확인하세요." />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
            <WrapPanel Margin="0,0,0,7">
                <StackPanel Width="138" Margin="0,0,10,0"><TextBlock Text="보고 싶은 Cell" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="CellFilter" Style="{StaticResource ManualComboBox}" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" /></StackPanel>
                <StackPanel Width="138" Margin="0,0,10,0"><TextBlock Text="결과 표시" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="JudgeFilter" Style="{StaticResource ManualComboBox}" SelectionChanged="Filter_Changed" /></StackPanel>
                <Expander Header="검색 · 표시 세부 설정" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,16,0,0">
                    <WrapPanel Margin="8,8,0,0">
                        <StackPanel Width="115" Margin="0,0,8,6"><TextBlock Text="Head" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="HeadFilter" Style="{StaticResource ManualComboBox}" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" /></StackPanel>
                        <StackPanel Width="132" Margin="0,0,8,6"><TextBlock Text="후보 출처" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="SourceFilter" Style="{StaticResource ManualComboBox}" SelectionChanged="Filter_Changed" /></StackPanel>
                        <StackPanel Width="178" Margin="0,0,8,6"><TextBlock Text="키 검색" Style="{StaticResource ManualLabel}" /><TextBox x:Name="SearchBox" Style="{StaticResource ManualInput}" TextChanged="Search_Changed" ToolTip="C1, H01, S3 또는 고유 키" /></StackPanel>
                        <StackPanel Width="125" Margin="0,0,8,6"><TextBlock Text="표 정렬" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="SortFilter" Style="{StaticResource ManualComboBox}" SelectionChanged="Filter_Changed" /></StackPanel>
                        <Button Content="세부 필터 초기화" Style="{StaticResource ManualButton}" Click="ResetFilters_Click" VerticalAlignment="Bottom" />
                    </WrapPanel>
                </Expander>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="12" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="WorkspaceScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,5,0">
                    <Border Style="{StaticResource ManualPanel}">
                        <StackPanel>
                            <TextBlock Text="2D 측정 결과 지도" Style="{StaticResource ManualTitle}" />
                            <TextBlock Text="행·열 배치에서 위치를 선택하고, 선택한 값은 아래 표에서 확인합니다." Style="{StaticResource ManualLabel}" />
                            <WrapPanel>
                                <Button Content="−" Style="{StaticResource ManualButton}" Click="ZoomOut_Click" />
                                <Button x:Name="ZoomResetButton" Content="100% · 맞춤" Style="{StaticResource ManualButton}" Click="ZoomReset_Click" />
                                <Button Content="+" Style="{StaticResource ManualButton}" Click="ZoomIn_Click" />
                                <ComboBox x:Name="ColorFilter" Width="126" Height="32" Style="{StaticResource ManualComboBox}" SelectionChanged="Color_Changed" Margin="0,0,6,6" />
                                <Button x:Name="PanToolButton" Content="선택 도구" Style="{StaticResource ManualButton}" Click="PanTool_Click" />
                                <Button x:Name="LevelsButton" Content="레벨 범위 편집" Style="{StaticResource ManualButton}" Click="Levels_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="FilterNoticeText" Foreground="{DynamicResource ButtonWarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,4" />
                            <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                <views:CManualInspectionMapControl x:Name="PositionMap" Height="480" />
                            </Border>
                            <TextBlock Text="클릭 한 점  ·  Ctrl+클릭 여러 점  ·  드래그 영역 선택  ·  Ctrl+휠 확대/축소  ·  Alt+드래그/방향키 화면 이동  ·  우클릭 이동·측정·보정"
                                       Style="{StaticResource ManualLabel}" Margin="0,8,0,4" />
                            <WrapPanel x:Name="MapLegendItems" Margin="0,3,0,0" />
                            <TextBlock x:Name="MapLegendText" Style="{StaticResource ManualLabel}" />
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock x:Name="SelectionCountText" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <Button Content="보이는 NG 선택" Style="{StaticResource ManualButton}" Click="SelectNg_Click" />
                                <Button Content="보이는 점 전체 선택" Style="{StaticResource ManualButton}" Click="SelectAll_Click" />
                                <Button Content="해제" Style="{StaticResource ManualButton}" Click="ClearSelection_Click" />
                                <Button x:Name="SelectedWorkButton" Content="선택 작업 ▾" Style="{StaticResource ManualButton}" Click="SelectedWork_Click" />
                                <Button x:Name="RemeasureSelectedButton" Content="선택점 재측정" Tag="MoveMeasure" Style="{StaticResource ManualPrimaryButton}" Click="Action_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManualPanel}" Background="{DynamicResource PanelAltBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="대표값과 같은 오프셋 · 판정" Style="{StaticResource ManualTitle}" />
                            <TextBlock Text="① 대표점 지정 → ② 대상 선택 → ③ 내용 확인" Style="{StaticResource ManualLabel}" />
                            <TextBlock x:Name="ReferenceText" Foreground="{DynamicResource AccentTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,10" />
                            <WrapPanel>
                                <Button x:Name="SetReferenceButton" Content="선택한 점을 대표값으로" Style="{StaticResource ManualButton}" Click="SetReference_Click" />
                                <Button x:Name="ClearReferenceButton" Content="대표 해제" Style="{StaticResource ManualButton}" Click="ClearReference_Click" />
                                <Button x:Name="CopyReferenceButton" Content="같은 오프셋 · 상태 적용" Style="{StaticResource ManualPrimaryButton}" Click="CopyReference_Click" />
                                <Button x:Name="UndoCopyButton" Content="직전 복사 되돌리기" Tag="UndoCopy" Style="{StaticResource ManualButton}" Click="Action_Click" />
                            </WrapPanel>
                            <TextBlock Text="선택 위치의 최종 보정 F·작업 편차·작업 판정이 대표값을 따릅니다. 원측정은 별도 보존하고 ◇ 대표값 복사로 표시합니다. 활성 보정은 아래 검증·적용 후 저장됩니다." Style="{StaticResource ManualLabel}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="CorrectionSection" Style="{StaticResource ManualPanel}">
                        <StackPanel>
                            <DockPanel><TextBlock x:Name="CandidateStatusText" DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /><TextBlock Text="보정 계산 · 검증 · 적용" Style="{StaticResource ManualTitle}" /></DockPanel>
                            <TextBlock x:Name="CandidateContextText" Style="{StaticResource ManualLabel}" />
                            <WrapPanel Margin="0,5,0,0">
                                <Button x:Name="CalculateButton" Content="① 선택점 보정 계산" Tag="Calculate" Style="{StaticResource ManualButton}" Click="Action_Click" />
                                <Button x:Name="ValidateButton" Content="② 후보 검증" Tag="Validate" Style="{StaticResource ManualButton}" Click="Action_Click" />
                                <Button x:Name="ApplyButton" Content="③ 보정 적용 · 저장" Style="{StaticResource ManualPrimaryButton}" Click="Apply_Click" />
                                <Button x:Name="RollbackButton" Content="직전 보정 원복" Style="{StaticResource ManualButton}" Click="Rollback_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="IncompleteText" Foreground="{DynamicResource ButtonDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6" />
                            <CheckBox x:Name="AllowManualCheck" Content="대표값 복사 등 수동 보정 후보를 포함하여 검토" Style="{StaticResource ManualCheck}" Checked="AllowManual_Changed" Unchecked="AllowManual_Changed" Margin="0,3,0,7" />
                            <TextBlock Text="직접 측정은 현재값 B + 측정 편차, 대표 복사는 지정한 최종 F를 사용합니다. 같은 직접 측정의 중복 누적은 차단합니다." Style="{StaticResource ManualLabel}" />
                            <DataGrid x:Name="CandidateGrid" Style="{StaticResource ManualGrid}" MaxHeight="250" Margin="0,5,0,5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="대상" Binding="{Binding Key}" Width="*" MinWidth="150" />
                                    <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="100" />
                                    <DataGridTextColumn Header="현재 B µm" Binding="{Binding BaseText}" Width="143" />
                                    <DataGridTextColumn Header="증감 Δ µm" Binding="{Binding DeltaText}" Width="143" />
                                    <DataGridTextColumn Header="적용 후 F µm" Binding="{Binding FinalText}" Width="143" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="CandidateRowCountText" Style="{StaticResource ManualLabel}" />
                            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6" />
                            <Expander Header="보정 한계 · 적용 이력" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                                <StackPanel Margin="0,8,0,0">
                                    <WrapPanel>
                                        <StackPanel Width="105" Margin="0,0,9,7"><TextBlock Text="증감 상한 µm" Style="{StaticResource ManualLabel}" /><TextBox x:Name="DeltaLimitInput" Style="{StaticResource ManualInput}" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,9,7"><TextBlock Text="총량 상한 µm" Style="{StaticResource ManualLabel}" /><TextBox x:Name="TotalLimitInput" Style="{StaticResource ManualInput}" /></StackPanel>
                                        <StackPanel Width="125" Margin="0,0,9,7"><TextBlock Text="Scanner Field mm" Style="{StaticResource ManualLabel}" /><TextBox x:Name="FieldLimitInput" Style="{StaticResource ManualInput}" /></StackPanel>
                                        <Button x:Name="SaveLimitsButton" Content="한계 설정 반영" Style="{StaticResource ManualButton}" Click="Limits_Click" VerticalAlignment="Bottom" />
                                    </WrapPanel>
                                    <ItemsControl x:Name="RevisionItems"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManualPanel}">
                        <StackPanel>
                            <DockPanel><ComboBox x:Name="ScatterDataCombo" DockPanel.Dock="Right" Width="205" Style="{StaticResource ManualComboBox}" SelectionChanged="Scatter_Changed" /><TextBlock Text="측정 산포도" Style="{StaticResource ManualTitle}" /></DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ScatterCellButton" Content="현재 셀 전체" Tag="CELL" Style="{StaticResource ManualButton}" Click="ScatterScope_Click" />
                                <Button x:Name="ScatterHeadButton" Content="전체 셀 · Head별" Tag="HEAD" Style="{StaticResource ManualButton}" Click="ScatterScope_Click" />
                                <Button x:Name="ScatterCellsButton" Content="선택 셀들" Tag="CELLS" Style="{StaticResource ManualButton}" Click="ScatterScope_Click" />
                            </WrapPanel>
                            <StackPanel x:Name="ScatterScopeControls" Margin="0,4,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="205" /></Grid.ColumnDefinitions>
                                <views:CManualInspectionScatterControl x:Name="ScatterPlot" Height="310" />
                                <StackPanel Grid.Column="1" Margin="10,6,0,0">
                                    <TextBlock x:Name="ScatterMetricsText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ScatterExcludedText" Style="{StaticResource ManualLabel}" Margin="0,10,0,6" />
                                    <DataGrid x:Name="ScatterGroupsGrid" Style="{StaticResource ManualGrid}" MaxHeight="145" RowHeight="26" FontSize="10">
                                        <DataGrid.Columns><DataGridTextColumn Header="범위" Binding="{Binding Group}" Width="40" /><DataGridTextColumn Header="점" Binding="{Binding Count}" Width="35" /><DataGridTextColumn Header="평균 X/Y µm" Binding="{Binding Mean}" Width="*" /></DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="ScatterLegendItems" Margin="0,4,0,2" />
                            <TextBlock x:Name="ScatterLegendText" Style="{StaticResource ManualLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ManualPanel}">
                        <StackPanel>
                            <DockPanel><Button DockPanel.Dock="Right" Content="현재 결과 CSV" Tag="ExportCsv" Style="{StaticResource ManualButton}" Click="Action_Click" /><TextBlock Text="측정 결과" Style="{StaticResource ManualTitle}" /></DockPanel>
                            <TextBlock x:Name="ResultStatsText" Style="{StaticResource ManualLabel}" />
                            <DataGrid x:Name="ResultGrid" Style="{StaticResource ManualGrid}" MaxHeight="420" MinHeight="100" SelectionChanged="ResultGrid_SelectionChanged"
                                      PreviewMouseLeftButtonDown="ResultGrid_LeftButtonDown" PreviewMouseRightButtonDown="ResultGrid_RightButtonDown">
                                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="선택" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Cell / Head / Shot / Beam" Binding="{Binding Point.Identity}" Width="180" />
                                    <DataGridTextColumn Header="작업판정" Binding="{Binding Point.WorkingJudge}" Width="82">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Style.Triggers>
                                            <DataTrigger Binding="{Binding Point.WorkingJudge}" Value="OK"><Setter Property="Foreground" Value="{DynamicResource StatusReadyBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Point.WorkingJudge}" Value="NG"><Setter Property="Foreground" Value="{DynamicResource ReviewMaskTextBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Point.WorkingJudge}" Value="ERROR"><Setter Property="Foreground" Value="{DynamicResource ButtonWarningBrush}" /></DataTrigger>
                                        </Style.Triggers></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="원측정판정" Binding="{Binding Point.OriginalJudge}" Width="90" />
                                    <DataGridTextColumn Header="작업 ΔX / ΔY µm" Binding="{Binding Point.WorkingErrorText}" Width="155" />
                                    <DataGridTextColumn Header="원측정 ΔX / ΔY µm" Binding="{Binding Point.OriginalErrorText}" Width="155" />
                                    <DataGridTextColumn Header="상태 출처" Binding="{Binding Point.SourceText}" Width="164" />
                                    <DataGridTextColumn Header="최종 후보 F µm" Binding="{Binding Point.CandidateOffsetText}" Width="150" />
                                    <DataGridTextColumn Header="대표 키" Binding="{Binding Point.ReferenceText}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="PreviousPageButton" Content="이전" Style="{StaticResource ManualButton}" Click="PreviousPage_Click" />
                                <TextBlock x:Name="PageText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,8,14,0" />
                                <Button x:Name="NextPageButton" Content="다음" Style="{StaticResource ManualButton}" Click="NextPage_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource ManualPanel}">
                    <StackPanel>
                        <TextBlock Text="최근 클릭한 위치" Style="{StaticResource ManualLabel}" />
                        <TextBlock x:Name="PointTitleText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PointIdentityText" Style="{StaticResource ManualLabel}" Margin="0,5,0,8" />
                        <TextBlock x:Name="PointJudgesText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="PointErrorText" Foreground="{DynamicResource AccentTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9" />
                        <TextBlock x:Name="PointDetailsText" Style="{StaticResource ManualLabel}" Margin="0,0,0,10" />
                        <Button x:Name="MoveButton" Content="이동만" Tag="Move" Style="{StaticResource ManualButton}" Click="Action_Click" />
                        <Button x:Name="MoveMeasureButton" Content="이동 후 측정" Tag="MoveMeasure" Style="{StaticResource ManualPrimaryButton}" Click="Action_Click" />
                        <Button x:Name="MoveMeasureCorrectButton" Content="이동 후 측정 &amp; 보정" Tag="MoveMeasureCorrect" Style="{StaticResource ManualPrimaryButton}" Click="Action_Click" />
                        <Button Content="선택 작업 ▾" Style="{StaticResource ManualButton}" Click="SelectedWork_Click" />
                        <Button x:Name="PointHistoryButton" Content="원시 값 · 측정 이력" Style="{StaticResource ManualButton}" Click="PointHistory_Click" />
                        <Button Content="보정 검증 · 적용 보기" Style="{StaticResource ManualButton}" Click="CorrectionFocus_Click" />
                        <TextBlock Text="Alt 조작은 화면 보기 이동입니다. 실제 이동·측정·보정은 위 버튼이나 우클릭 메뉴로 실행합니다." Style="{StaticResource ManualLabel}" Margin="0,8,0,7" />
                        <Expander Header="측정 옵션 · 추가 동작" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="획득 방식" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="MeasurementModeCombo" Style="{StaticResource ManualComboBox}" />
                                <TextBlock Text="Flying은 선택점이 포함된 Cell·Head·행 전체로 넓어집니다. 실행 전에 대상 범위를 확인합니다." Style="{StaticResource ManualLabel}" Margin="0,6,0,10" />
                                <Button x:Name="MeasureButton" Content="현재 위치 측정" Tag="Measure" Style="{StaticResource ManualButton}" Click="Action_Click" />
                                <Button x:Name="RetryButton" Content="잔여 재실행" Tag="RetryRemaining" Style="{StaticResource ManualButton}" Click="Action_Click" />
                                <Button x:Name="SideStopButton" Content="중지" Tag="Stop" Style="{StaticResource ManualButton}" Click="Action_Click" Background="{DynamicResource ButtonDangerBrush}" Foreground="{DynamicResource ButtonTextOnColorBrush}" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SimulationOptions" Header="SIM 전용 · 예제 및 오류 주입" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="실제 설비 명령과 분리된 시뮬레이션입니다." Style="{StaticResource ManualLabel}" />
                                <TextBlock Text="예제" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="SimulationDemoCombo" Style="{StaticResource ManualComboBox}" />
                                <Button x:Name="SimulationDemoButton" Content="SIM 새 예제" Tag="NewSimulation" Style="{StaticResource ManualButton}" Click="Action_Click" Margin="0,6" />
                                <TextBlock Text="가상 측정 상황" Style="{StaticResource ManualLabel}" /><ComboBox x:Name="SimulationScenarioCombo" Style="{StaticResource ManualComboBox}" />
                                <TextBlock Text="배속" Style="{StaticResource ManualLabel}" Margin="0,6,0,4" /><ComboBox x:Name="SimulationSpeedCombo" Style="{StaticResource ManualComboBox}" />
                                <TextBlock Text="오류 주입" Style="{StaticResource ManualLabel}" Margin="0,6,0,4" /><ComboBox x:Name="SimulationFaultCombo" Style="{StaticResource ManualComboBox}" />
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="JobProgressText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,5" />
                        <ProgressBar x:Name="JobProgressBar" Height="7" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="PersistenceText" Grid.Row="4" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
