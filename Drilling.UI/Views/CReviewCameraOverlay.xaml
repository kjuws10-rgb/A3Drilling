<UserControl x:Class="Drilling.UI.Views.CReviewCameraOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <Canvas>
        <Canvas x:Name="CameraMarker" Width="36" Height="28" Visibility="Collapsed">
            <Canvas.RenderTransform><TranslateTransform x:Name="CameraTranslation" /></Canvas.RenderTransform>
            <Border Width="36" Height="28" CornerRadius="3" BorderThickness="2" BorderBrush="#00A7C4" Background="#55B9F5FF" />
            <Line X1="10" Y1="14" X2="26" Y2="14" Stroke="#005B72" StrokeThickness="1.5" />
            <Line X1="18" Y1="6" X2="18" Y2="22" Stroke="#005B72" StrokeThickness="1.5" />
            <Border Canvas.Top="-14" Width="36" Height="14" CornerRadius="2,2,0,0" Background="#007E98">
                <TextBlock Text="CAM" Foreground="White" FontSize="9" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Canvas>
    </Canvas>
</UserControl>
