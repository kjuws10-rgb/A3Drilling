<UserControl x:Class="Drilling.UI.Views.CManualMofView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="MofView_IsVisibleChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="MofHeadCardTemplate">
            <Border Margin="1" Padding="2,4" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeadName}" Foreground="{Binding TextBrush}" FontSize="10"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ShotCountText}" Foreground="{Binding TextBrush}" FontSize="8"
                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelBorder}" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Head Assignment / Glass Preview" Style="{StaticResource PanelTitle}"
                       FontSize="14" TextWrapping="Wrap" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding OddHeadPreviews}" ItemTemplate="{StaticResource MofHeadCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4" Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid x:Name="GlassPreviewViewport"
                          Grid.Row="2"
                          Margin="0,6"
                          Background="Transparent"
                          ClipToBounds="True"
                          Cursor="Hand"
                          LostMouseCapture="GlassPreview_LostMouseCapture"
                          PreviewMouseLeftButtonDown="GlassPreview_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="GlassPreview_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="GlassPreview_PreviewMouseLeftButtonUp">
                        <Grid x:Name="GlassPreviewZoomContent"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="GlassPreviewScaleTransform"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                    <TranslateTransform x:Name="GlassPreviewTranslateTransform" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="GlassPreviewFitCanvas" Width="{Binding PreviewContentWidth}" Height="{Binding PreviewContentHeight}"
                                    ClipToBounds="True" Background="{DynamicResource GridBackgroundBrush}">
                            <Canvas x:Name="GlassPreviewDesignCanvas" Width="860" Height="520"
                                    Canvas.Left="{Binding PreviewContentLeft}" Canvas.Top="{Binding PreviewContentTop}">
                                 <Rectangle Canvas.Left="{Binding GlassFrame.CanvasLeft}"
                                            Canvas.Top="{Binding GlassFrame.CanvasTop}"
                                            Width="{Binding GlassFrame.Width}"
                                            Height="{Binding GlassFrame.Height}"
                                            Stroke="{DynamicResource PanelBorderBrush}"
                                            StrokeThickness="1.4"
                                            Fill="{DynamicResource GridBackgroundBrush}" />

                                <Image Canvas.Left="0"
                                       Canvas.Top="0"
                                       Width="860"
                                       Height="520"
                                       Source="{Binding RecipePreviewImage}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />

                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="860"
                                              Height="520"
                                              ItemsSource="{Binding HeadAssignmentAreas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="860" Height="520" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       Fill="{Binding FillBrush}"
                                                       Stroke="{Binding StrokeBrush}"
                                                       StrokeThickness="{Binding BorderThicknessValue.Left}"
                                                       StrokeDashArray="5,3"
                                                       StrokeDashCap="Flat"
                                                       Opacity="{Binding Opacity}"
                                                       Visibility="{Binding RangeVisibility}"
                                                       SnapsToDevicePixels="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="860"
                                              Height="520"
                                              ItemsSource="{Binding HeadAssignmentAreas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="860" Height="520" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding LabelCanvasLeft}" />
                                            <Setter Property="Canvas.Top" Value="{Binding LabelCanvasTop}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                             <Border Width="{Binding LabelWidth}"
                                                     Height="20"
                                                     Background="{DynamicResource PanelBackgroundBrush}"
                                                     BorderBrush="{Binding StrokeBrush}"
                                                     BorderThickness="0,0,0,1"
                                                     Visibility="{Binding RangeVisibility}">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           Foreground="{Binding StrokeBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                 <!-- The physical Glass uses the same restrained accent as the rest of the HMI. -->
                                 <Rectangle Canvas.Left="{Binding GlassFrame.CanvasLeft}"
                                            Canvas.Top="{Binding GlassFrame.CanvasTop}"
                                            Width="{Binding GlassFrame.Width}"
                                            Height="{Binding GlassFrame.Height}"
                                            Fill="Transparent"
                                            Stroke="{DynamicResource MenuItemSelectedBorderBrush}"
                                            StrokeThickness="1.8"
                                            Opacity="0.9"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="True" />

                        <ItemsControl Width="860" Height="520" ItemsSource="{Binding CellPreviewLabels}"
                                      Style="{StaticResource CellPreviewLabelItemsControl}"
                                      IsHitTestVisible="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}"
                                            Height="{Binding Height}"
                                            Background="Transparent"
                                            MouseMove="CellPreviewLabel_MouseMove"
                                            MouseLeave="CellPreviewLabel_MouseLeave" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </Canvas>
                            </Canvas>
                        </Viewbox>
                        </Grid>
                        <Border x:Name="GlassPreviewHoverTip"
                                Panel.ZIndex="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Padding="7,3"
                                Background="{DynamicResource PreviewHoverTipBackgroundBrush}"
                                BorderBrush="{DynamicResource PreviewHoverTipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="GlassPreviewHoverTipTranslateTransform" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="GlassPreviewHoverTipText"
                                       Foreground="{DynamicResource PreviewHoverTipTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
            <ItemsControl Grid.Row="3" ItemsSource="{Binding EvenHeadPreviews}" ItemTemplate="{StaticResource MofHeadCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4" Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Grid.Row="4" Text="{Binding GlassPreviewSummary}" FontSize="10" Margin="0,6,0,0"
                       Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
