<Window x:Class="Drilling.UI.Popup.CColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Level Color"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyDown="WindowKeyDown"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Padding="20"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptText"
                       FontSize="19"
                       FontWeight="SemiBold" />

            <Grid Grid.Row="1" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewBorder"
                        Margin="0,0,12,0"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="3" />
                <TextBox x:Name="HexTextBox"
                         Grid.Column="1"
                         Height="48"
                         Padding="12,6"
                         FontSize="19"
                         FontWeight="SemiBold"
                         CharacterCasing="Upper"
                         VerticalContentAlignment="Center"
                         TextChanged="HexTextChanged" />
            </Grid>

            <TextBlock x:Name="ValidationText"
                       Grid.Row="2"
                       Margin="2,0,0,8"
                       Foreground="{DynamicResource ButtonDangerBrush}"
                       Text="#RRGGBB 형식으로 입력하거나 아래 색상을 선택하세요." />

            <UniformGrid Grid.Row="3" Columns="6" Rows="2">
                <Button Tag="#22C55E" Background="#22C55E" ToolTip="#22C55E" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#84CC16" Background="#84CC16" ToolTip="#84CC16" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#EAB308" Background="#EAB308" ToolTip="#EAB308" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#F59E0B" Background="#F59E0B" ToolTip="#F59E0B" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#EF4444" Background="#EF4444" ToolTip="#EF4444" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#EC4899" Background="#EC4899" ToolTip="#EC4899" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#A855F7" Background="#A855F7" ToolTip="#A855F7" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#3B82F6" Background="#3B82F6" ToolTip="#3B82F6" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#06B6D4" Background="#06B6D4" ToolTip="#06B6D4" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#14B8A6" Background="#14B8A6" ToolTip="#14B8A6" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#64748B" Background="#64748B" ToolTip="#64748B" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
                <Button Tag="#334155" Background="#334155" ToolTip="#334155" Click="PaletteClick" Style="{StaticResource SwatchButton}" />
            </UniformGrid>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="CANCEL" Click="CancelClick" Style="{StaticResource DialogButton}" />
                <Button Grid.Column="2"
                        Content="APPLY"
                        Click="ApplyClick"
                        Style="{StaticResource DialogButton}"
                        Background="{DynamicResource ButtonSuccessBrush}"
                        Foreground="{DynamicResource ButtonTextOnColorBrush}"
                        BorderBrush="{DynamicResource ButtonSuccessBorderBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
