<Window x:Class="Drilling.UI.Popup.CShiftOffsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Offset"
        Width="940"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        KeyDown="WindowKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShiftInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ButtonSecondaryBrush}"
            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
            BorderThickness="1"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Shift Offset"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Manual Start에서만 적용되는 설계좌표 기준 이동량입니다."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="SHIFT OFFSET X"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextBrush}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="mm"
                                   Width="34"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="ShiftXTextBox"
                                 Style="{StaticResource ShiftInputBox}"
                                 PreviewTextInput="NumericTextBoxPreviewTextInput"
                                 TextChanged="OnShiftInputChanged" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SHIFT OFFSET Y"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextBrush}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="mm"
                                   Width="34"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="ShiftYTextBox"
                                 Style="{StaticResource ShiftInputBox}"
                                 PreviewTextInput="NumericTextBoxPreviewTextInput"
                                 TextChanged="OnShiftInputChanged" />
                    </DockPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource GridBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="GLASS VIEW"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                        <Canvas x:Name="PreviewCanvas"
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Background="{DynamicResource ButtonSecondaryBrush}" />
                        <TextBlock x:Name="PreviewCaptionText"
                                   Grid.Row="2"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource GridBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="260" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="GX/GY TRANSFER POSITION"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                        <Grid Grid.Row="1" Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HEAD" Style="{StaticResource TableText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="GX" TextAlignment="Right" Style="{StaticResource TableText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="GY" TextAlignment="Right" Style="{StaticResource TableText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HeadRowsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding HeadName}" Style="{StaticResource TableText}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding ScannerGx}" TextAlignment="Right" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding ScannerGy}" TextAlignment="Right" Style="{StaticResource TableText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Ready" />
                <Button Grid.Column="1"
                        Content="APPLY"
                        Style="{StaticResource DialogButton}"
                        Background="{DynamicResource ButtonSuccessBrush}"
                        BorderBrush="{DynamicResource ButtonSuccessBorderBrush}"
                        Foreground="{DynamicResource ButtonTextOnColorBrush}"
                        Click="OnApplyClicked" />
                <Button Grid.Column="3"
                        Content="CLOSE"
                        Style="{StaticResource DialogButton}"
                        Background="{DynamicResource ButtonSecondaryBrush}"
                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                        Click="OnCloseClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
