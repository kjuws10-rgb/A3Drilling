<Window x:Class="Drilling.UI.Popup.CAutoReviewMonitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Drilling.UI.Views"
        Title="Review Monitor · FINE" Width="1480" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ShellBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="MonitorGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" /><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" /><Setter Property="RowHeight" Value="30" />
            <Setter Property="FontSize" Value="12" /><Setter Property="SelectionMode" Value="Single" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel><Button DockPanel.Dock="Right" Content="닫기" Width="90" Height="32" Click="CloseClicked" Style="{StaticResource SecondaryButton}" />
                    <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="19" VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel>
                <TextBlock Text="{Binding ProgressText}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
                <TextBlock Text="{Binding Status}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Tolerance}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Preview}">
                        <TextBlock Text="Stage Y  " /><TextBlock Text="{Binding StageY}" FontWeight="Bold" /><TextBlock Text="  mm     Review X  " />
                        <TextBlock Text="{Binding ReviewX}" FontWeight="Bold" /><TextBlock Text="  mm    " /><TextBlock Text="{Binding Mode}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="11*" /><ColumnDefinition Width="12*" /></Grid.ColumnDefinitions>
            <views:CFineGlassPreviewView x:Name="MonitorPreview" DataContext="{Binding Preview}" />
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding FocusText}" TextWrapping="Wrap" Foreground="#196FD1" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TabControl Grid.Row="1" x:Name="MonitorTabs">
                        <TabItem Header="NG"><DataGrid x:Name="NgGrid" Style="{StaticResource MonitorGrid}" ItemsSource="{Binding NgResults}" SelectedItem="{Binding SelectedNg}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LINE" Binding="{Binding LineNo}" Width="48" />
                                <DataGridTextColumn Header="HEAD" Binding="{Binding Head}" Width="70" />
                                <DataGridTextColumn Header="CELL" Binding="{Binding Cell}" Width="65" />
                                <DataGridTextColumn Header="SHOT" Binding="{Binding Shot}" Width="50" />
                                <DataGridTextColumn Header="BEAM" Binding="{Binding Beam}" Width="48" />
                                <DataGridTextColumn Header="Recv Target−Hole&#10;X / Y (mm)" Binding="{Binding Received}" Width="125" />
                                <DataGridTextColumn Header="Vision Flip Convert&#10;X / Y (mm)" Binding="{Binding Converted}" Width="132" />
                                <DataGridTextColumn Header="초과량 / 원인" Binding="{Binding Excess}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid></TabItem>
                        <TabItem Header="LINE SUMMARY"><DataGrid x:Name="LineGrid" Style="{StaticResource MonitorGrid}" ItemsSource="{Binding Preview.Lines}" MouseDoubleClick="LineDoubleClicked">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LINE" Binding="{Binding OrderNo}" Width="48" />
                                <DataGridTextColumn Header="STATE" Binding="{Binding StateText}" Width="85" />
                                <DataGridTextColumn Header="검사 / 전체 · NG" Binding="{Binding ResultSummary}" Width="180" />
                                <DataGridTextColumn Header="X Min" Binding="{Binding Statistics[0].Minimum}" Width="70" />
                                <DataGridTextColumn Header="X Max" Binding="{Binding Statistics[0].Maximum}" Width="70" />
                                <DataGridTextColumn Header="X Avg" Binding="{Binding Statistics[0].Average}" Width="70" />
                                <DataGridTextColumn Header="Y Min" Binding="{Binding Statistics[1].Minimum}" Width="70" />
                                <DataGridTextColumn Header="Y Max" Binding="{Binding Statistics[1].Maximum}" Width="70" />
                                <DataGridTextColumn Header="Y Avg" Binding="{Binding Statistics[1].Average}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid></TabItem>
                        <TabItem Header="RESULT" Visibility="{Binding FinalVisibility}"><DataGrid x:Name="FinalGrid" Style="{StaticResource MonitorGrid}" ItemsSource="{Binding FinalResults}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LINE" Binding="{Binding LineNo}" Width="48" />
                                <DataGridTextColumn Header="HEAD" Binding="{Binding Head}" Width="70" />
                                <DataGridTextColumn Header="CELL" Binding="{Binding Cell}" Width="65" />
                                <DataGridTextColumn Header="SHOT" Binding="{Binding Shot}" Width="50" />
                                <DataGridTextColumn Header="BEAM" Binding="{Binding Beam}" Width="48" />
                                <DataGridTextColumn Header="Recv Target−Hole&#10;X / Y (mm)" Binding="{Binding Received}" Width="125" />
                                <DataGridTextColumn Header="Vision Flip Convert&#10;X / Y (mm)" Binding="{Binding Converted}" Width="132" />
                                <DataGridTextColumn Header="RESULT" Binding="{Binding Judge}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid></TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,10,0,0"><StackPanel>
            <TextBlock Text="{Binding OffsetStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ResultFile}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" />
            <TextBlock Text="AUTO: FINE 누적 보정은 다음 Glass의 스크립트 생성 때 사용 · 이 창을 닫아도 검사는 계속됩니다."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" />
        </StackPanel></Border>
    </Grid>
</Window>
