<Window x:Class="Drilling.UI.Popup.CProtectWindowRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Drilling.UI"
        Title="보호윈도우 교체 요청" Width="920" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="88"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <TextBlock Text="Protect Window" FontSize="22" FontWeight="SemiBold"/>
            <Border HorizontalAlignment="Right" Background="{Binding Connection.Color}" CornerRadius="3" Padding="12,4">
                <TextBlock Text="{Binding Connection.Text}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <Border Grid.Row="1" x:Name="RequestBanner" Background="#288D54" CornerRadius="6">
            <Grid>
                <Border x:Name="RequestPulse" Background="#003310" Opacity="0" CornerRadius="6" ui:CSignalBlink.IsActive="True"/>
                <TextBlock Text="보호윈도우 교체 요청 중" Foreground="White" FontSize="48" FontWeight="Bold"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
            <TextBlock Text="교체완료 신호상태" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Background="{Binding Complete.Color}" CornerRadius="5" Padding="14,7" ToolTip="{Binding Complete.Detail}">
                <TextBlock x:Name="CompletionText" Text="{Binding Complete.Text}" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="요청 신호가 ON이면 창을 닫아도 1초 이내에 다시 표시됩니다." FontSize="14"/>
                <TextBlock Text="{Binding Request.Text, StringFormat='교체요청 신호상태: {0}'}" Margin="0,4,0,0"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="닫기" Height="44" FontSize="18" FontWeight="SemiBold" Click="CloseClicked"
                    Background="{DynamicResource ButtonSecondaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"/>
        </Grid>
    </Grid>
</Window>
