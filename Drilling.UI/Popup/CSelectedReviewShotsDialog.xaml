<Window x:Class="Drilling.UI.Popup.CSelectedReviewShotsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cur Selected Shot"
        Width="680" Height="560" MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ButtonSecondaryBrush}"
            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
            BorderThickness="1" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Cur Selected Shot" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,6,0,16"
                       FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
            <Grid Grid.Row="2">
                <DataGrid x:Name="ShotGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="34" ColumnHeaderHeight="36"
                          GridLinesVisibility="All" FontSize="14"
                          Background="{DynamicResource GridBackgroundBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource PanelBorderBrush}"
                          HorizontalGridLinesBrush="{DynamicResource PanelBorderBrush}"
                          VerticalGridLinesBrush="{DynamicResource PanelBorderBrush}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextInvertedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,0" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                            <Setter Property="Padding" Value="12,0" />
                        </Style>
                        <Style x:Key="CellText" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="10,0" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ButtonSecondaryBrush}" Padding="10,8"
                                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ItemCount, StringFormat={}{0} Shots}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Items[0].IsEmpty}" Value="True">
                                                                <Setter Property="Text" Value="0 Shots" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Head" Binding="{Binding Head}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Cell" Binding="{Binding Cell}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Shot" Binding="{Binding ShotName}" Width="1.5*" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="선택된 Shot이 없습니다." Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                           Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Row="3" Content="닫기" Click="OnCloseClicked" IsCancel="True"
                    HorizontalAlignment="Right" Width="130" Height="42" Margin="0,16,0,0"
                    FontSize="14" FontWeight="SemiBold"
                    Background="{DynamicResource ButtonSecondaryBrush}"
                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
    </Border>
</Window>
