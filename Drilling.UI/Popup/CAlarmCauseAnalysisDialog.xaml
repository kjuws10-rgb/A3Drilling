<Window x:Class="Drilling.UI.Popup.CAlarmCauseAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALARM CAUSE ANALYSIS" Width="1580" Height="920" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="AnalysisImportantRowBrush" Color="#FFFFE8E8" />
        <SolidColorBrush x:Key="AnalysisAlarmMomentRowBrush" Color="#FFFFE2A6" />
        <SolidColorBrush x:Key="AnalysisReferenceDifferenceRowBrush" Color="#FFE5F2FF" />
        <Style x:Key="AnalysisLogGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="31" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBaselineDifference}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AnalysisReferenceDifferenceRowBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AnalysisImportantRowBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlarmMoment}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AnalysisAlarmMomentRowBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AnalysisCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <DataTemplate x:Key="AnalysisLogCellTemplate">
            <TextBlock Text="{Binding Message}" Style="{StaticResource AnalysisCell}"
                       ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
                <TextBlock.ToolTip>
                    <ToolTip MaxWidth="900" Placement="Mouse">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="860" />
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="QuickRangeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="AnalysisOptionCheckBox" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="CauseCandidateButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="TimelineEventButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AnalysisImportantRowBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBorderBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ALARM CAUSE ANALYSIS" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AlarmHeading}" Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ButtonDangerBorderBrush}" />
                <TextBlock Text="{Binding AlarmCause}" Margin="0,3,0,0" FontSize="14" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="ALARM TIME" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding AlarmTime}" Margin="16,4,0,0" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,10" Padding="12,9" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                Background="{DynamicResource PanelBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="BEFORE (sec)" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding BeforeSeconds, UpdateSourceTrigger=PropertyChanged}" Width="76" Height="34" FontSize="14"
                             VerticalContentAlignment="Center" TextAlignment="Center" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="AFTER (sec)" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <TextBox Text="{Binding AfterSeconds, UpdateSourceTrigger=PropertyChanged}" Width="76" Height="34" FontSize="14"
                             VerticalContentAlignment="Center" TextAlignment="Center" IsEnabled="{Binding CanEdit}" />
                    <Button Content="LOAD LOGS" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Width="148" Height="34" Margin="16,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ANALYSIS RANGE" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Interval}" Margin="0,3,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="QUICK RANGE" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <Button Content="±1s" Tag="1" Click="QuickRangeClicked" Style="{StaticResource QuickRangeButton}"
                                Width="58" Margin="0,0,5,0" IsEnabled="{Binding CanEdit}" />
                        <Button Content="±5s" Tag="5" Click="QuickRangeClicked" Style="{StaticResource QuickRangeButton}"
                                Width="58" Margin="0,0,5,0" IsEnabled="{Binding CanEdit}" />
                        <Button Content="±30s" Tag="30" Click="QuickRangeClicked" Style="{StaticResource QuickRangeButton}"
                                Width="64" Margin="0,0,5,0" IsEnabled="{Binding CanEdit}" />
                        <Button Content="ALL" Tag="3600" Click="QuickRangeClicked" Style="{StaticResource QuickRangeButton}"
                                Width="58" IsEnabled="{Binding CanEdit}" ToolTip="알람 발생 전후 60분" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="상태 변화만 표시" IsChecked="{Binding ShowStateChangesOnly, Mode=TwoWay}"
                                  Style="{StaticResource AnalysisOptionCheckBox}" IsEnabled="{Binding CanEdit}" />
                        <CheckBox Content="이전 정상 후보 구간과 비교" IsChecked="{Binding CompareWithReference, Mode=TwoWay}"
                                  Style="{StaticResource AnalysisOptionCheckBox}" IsEnabled="{Binding HasReference}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ReferenceSummary}" Margin="0,4,12,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ReferenceSummary}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,9" Padding="12,8" BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding FailureSummary.Source, StringFormat=SOURCE · {0}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding FailureSummary.LeadTime, StringFormat=LEAD · {0}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FAILURE SUMMARY" FontSize="14" FontWeight="Bold" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding FailureSummary.Title}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource ButtonDangerBorderBrush}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding FailureSummary.Category}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding FailureSummary.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,0" Padding="8,4" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Value}" Margin="0,2,0,0" FontSize="13" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="2" Text="{Binding FailureSummary.Detail}" Margin="4,5,4,0" FontSize="11"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FailureSummary.Detail}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,9" Padding="10,8" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="4,0,4,5">
                    <TextBlock DockPanel.Dock="Right" Text="규칙 기반 참고용 · 확정 원인이 아닙니다. 후보를 누르면 근거 로그로 이동합니다."
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="ROOT CAUSE CANDIDATES" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CauseCandidateButton}" Click="CandidateClicked" Margin="4,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="근거 로그 이동"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="10,0,0,0" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RankLabel}" Foreground="{DynamicResource ButtonPrimaryBrush}"
                                                       FontWeight="Bold" FontSize="11" Margin="0,0,9,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Reason}" Margin="0,3,0,0" FontSize="11"
                                               TextWrapping="Wrap" LineHeight="15"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Text="현재 분석 범위에서 규칙에 맞는 원인 후보를 찾지 못했습니다."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Height="42"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Candidates.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,0,0,9" Padding="10,7" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="4,0,4,5">
                    <TextBlock DockPanel.Dock="Right" Text="시간순 · 항목을 누르면 해당 로그 시점으로 이동합니다."
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="KEY TIMELINE" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Timeline}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TimelineEventButton}" Click="TimelineClicked" Margin="3,0"
                                    ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
                                <Button.ToolTip>
                                    <ToolTip MaxWidth="900" Placement="Mouse">
                                        <TextBlock Text="{Binding FullMessage}" TextWrapping="Wrap" MaxWidth="860" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Source}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding OffsetText}" FontSize="11" FontWeight="Bold" />
                                    </DockPanel>
                                    <Border Grid.Row="1" Height="2" Margin="0,4,0,4" Background="{DynamicResource ButtonPrimaryBrush}" />
                                    <TextBlock Grid.Row="2" Text="{Binding Summary}" FontSize="10" LineHeight="13"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="27" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Text="표시할 핵심 사건이 없습니다." Height="38"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Timeline.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="5,0,5,6" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Width="15" Height="15" Background="{StaticResource AnalysisReferenceDifferenceRowBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" />
                    <TextBlock Text="정상 후보 대비 신규" VerticalAlignment="Center" Margin="6,0,18,0" />
                    <Border Width="15" Height="15" Background="{StaticResource AnalysisImportantRowBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" />
                    <TextBlock Text="오류/지연 등 중요 로그" VerticalAlignment="Center" Margin="6,0,18,0" />
                    <Border Width="15" Height="15" Background="{StaticResource AnalysisAlarmMomentRowBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" />
                    <TextBlock Text="알람 발생 시점" VerticalAlignment="Center" Margin="6,0,18,0" />
                    <Border Width="15" Height="15" Background="{DynamicResource ButtonPrimaryBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" />
                    <TextBlock Text="현재 선택 행" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding CursorTime}" VerticalAlignment="Center" FontWeight="SemiBold"
                           Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>

        <ItemsControl Grid.Row="6" ItemsSource="{Binding Panes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="2" Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                            Background="{DynamicResource PanelBackgroundBrush}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource AnalysisLogGrid}"
                                          Loaded="LogGridLoaded" Unloaded="LogGridUnloaded" SelectionChanged="LogGridSelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="130" ElementStyle="{StaticResource AnalysisCell}" />
                                        <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="116" ElementStyle="{StaticResource AnalysisCell}" />
                                        <DataGridTemplateColumn Header="LOG" Width="900" SortMemberPath="Message"
                                                                CellTemplate="{StaticResource AnalysisLogCellTemplate}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="이 시간 구간에 해당 로그가 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Grid.Row="7" Margin="5,10,5,0">
            <Button DockPanel.Dock="Right" Content="CLOSE" Click="CloseClicked" Style="{StaticResource SecondaryButton}" Width="130" Height="38" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
        </DockPanel>
    </Grid>
</Window>
