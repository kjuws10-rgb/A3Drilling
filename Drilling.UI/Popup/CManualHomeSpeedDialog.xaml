<Window x:Class="Drilling.UI.Popup.CManualHomeSpeedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOME SPEED SET" Width="980" Height="560" MinWidth="840" MinHeight="360"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" /><Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Padding="20" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="REFRESH" Command="{Binding RefreshCommand}" Width="100" Style="{StaticResource PopupButton}" />
                <TextBlock x:Name="HeadingText" Text="HOME SPEED SET" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="선택한 Head의 축별 저장값과 단위를 확인하고 설정해 주세요." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,14" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Heads}" x:Name="HomeSpeedHeads">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Margin="3,3,7,7" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource GridBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding HeadName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8" />
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="96" /><ColumnDefinition Width="78" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="AXIS" Style="{StaticResource HeaderText}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="SAVED" Style="{StaticResource HeaderText}" />
                                    <TextBlock Grid.Column="2" Text="SET VALUE" Style="{StaticResource HeaderText}" />
                                    <TextBlock Grid.Column="3" Text="UNIT" Style="{StaticResource HeaderText}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Axes}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="96" /><ColumnDefinition Width="78" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AxisName}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding SavedValue}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2" Text="{Binding NewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSet}" PreviewMouseLeftButtonDown="OpenHomeSpeedInput"
                                                 FontSize="14" Height="32" Padding="6,4" Margin="3,0" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding SpeedUnit}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="SET" Command="{Binding SetCommand}" Style="{StaticResource PopupButton}" />
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="닫기" Click="CloseClicked" IsCancel="True" Width="110" Height="38" Style="{StaticResource PopupButton}" />
                <TextBlock Text="저장한 값은 해당 컨트롤러를 RESET한 후 적용됩니다." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
