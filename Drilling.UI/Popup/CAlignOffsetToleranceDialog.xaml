<Window x:Class="Drilling.UI.Popup.CAlignOffsetToleranceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align Offset Tolerance" Width="900" Height="650" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" KeyDown="OnKeyDown"
        Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Padding="24" Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Align Offset Tolerance 초과" FontSize="23" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,12,0,14">
                <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="X 또는 Y 중 하나만 초과해도 해당 Shot의 X/Y 둘 다 제외합니다.&#x0a;제외된 Shot은 기존 저장값을 유지합니다. 전부 제외를 선택하면 레시피를 변경하지 않습니다." />
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding ExceededShots}" Style="{StaticResource PlainDataGrid}"
                      IsReadOnly="True" RowHeight="30" ColumnHeaderHeight="36" FontSize="14"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cell" Binding="{Binding CellNo, StringFormat='Cell {0}'}" Width="*" />
                    <DataGridTextColumn Header="Shot" Binding="{Binding ShotName}" Width="*" />
                    <DataGridTextColumn Header="Design Offset X (mm)" Binding="{Binding X, StringFormat={}{0:0.000}}" Width="2*" />
                    <DataGridTextColumn Header="Design Offset Y (mm)" Binding="{Binding Y, StringFormat={}{0:0.000}}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
            <UniformGrid Grid.Row="3" Columns="2" Margin="0,18,0,0" Height="46">
                <Button x:Name="ApplyRemainingButton" Content="초과 Shot 제외 후 적용" Margin="0,0,10,0" FontSize="16"
                        Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanApplyRemaining}" Click="OnApplyRemaining" />
                <Button Content="전부 제외 (적용 안 함)" FontSize="16" Style="{StaticResource SecondaryButton}" Click="OnCancel" />
            </UniformGrid>
        </Grid>
    </Border>
</Window>
