<Window x:Class="Drilling.UI.Popup.CInterlockDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interlock / Safety" Width="780" Height="500" MinWidth="540" MinHeight="320"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource ButtonSecondaryBrush}"
            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Item}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
            <DataGrid x:Name="DetailGrid" Grid.Row="1" ItemsSource="{Binding Details}"
                      Style="{StaticResource PlainDataGrid}" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      CanUserResizeRows="False" RowHeight="40" ColumnHeaderHeight="36"
                      FontSize="14" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Description}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <Style x:Key="DetailText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="10,0" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*"
                                        ElementStyle="{StaticResource DetailText}" />
                    <DataGridTemplateColumn Header="State" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="2" Content="CLOSE" IsCancel="True" Width="130" Height="42"
                    HorizontalAlignment="Right" Margin="0,18,0,0" FontSize="14" FontWeight="SemiBold"
                    Background="{DynamicResource ButtonSecondaryBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" Click="OnCloseClicked" />
        </Grid>
    </Border>
</Window>
