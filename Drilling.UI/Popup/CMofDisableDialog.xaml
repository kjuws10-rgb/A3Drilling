<Window x:Class="Drilling.UI.Popup.CMofDisableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOF Disable" Width="540" Height="500" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        </Style>
    </Window.Resources>
    <Border Padding="20" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="ControllerTitle" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="MOF를 해제할 축을 선택하세요." Margin="0,8,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="전체선택" Click="SelectAll" />
                    <Button Content="전체선택해제" Click="ClearAll" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="취소" IsCancel="True" />
                <Button Content="MOF 해제" Click="Confirm" IsDefault="True"
                        Background="{DynamicResource ButtonPrimaryBrush}"
                        BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl x:Name="AxisItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,3" Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
