<Window x:Class="Drilling.UI.Popup.CAlignBaseEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Base Edit" Width="1140" Height="860" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="OnClosing" KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="BaseEditValue" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        </Style>
    </Window.Resources>
    <Border Padding="20" Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="(mm)" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel>
                    <TextBlock Text="Base Edit" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RecipeName, StringFormat='CURRENT RECIPE: {0}'}" FontSize="14" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            <Viewbox x:Name="PreviewArea" Grid.Row="1" Stretch="Uniform">
                <Canvas Width="940" Height="{Binding PreviewHeight}">
                    <Image Source="{Binding PreviewImage}" Width="940" Height="{Binding PreviewHeight}" IsHitTestVisible="False" />
                    <ItemsControl ItemsSource="{Binding AlignKeys}" Width="940" Height="{Binding PreviewHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding EditorLeft}" />
                                <Setter Property="Canvas.Top" Value="{Binding EditorTop}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="222" Height="96" Padding="8,6" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{Binding KeyBrush}" Background="{DynamicResource PanelBackgroundBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{Binding KeyBrush}" />
                                        <TextBlock Grid.Row="1" Text="BaseX" FontSize="14" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource BaseEditValue}"
                                                 Text="{Binding BaseX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="X" PreviewMouseLeftButtonDown="OpenCoordinateInput" />
                                        <TextBlock Grid.Row="2" Text="BaseY" FontSize="14" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource BaseEditValue}"
                                                 Text="{Binding BaseY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Y" PreviewMouseLeftButtonDown="OpenCoordinateInput" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding DistortionPairs}" Width="940" Height="{Binding PreviewHeight}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding EditorLeft}" />
                                <Setter Property="Canvas.Top" Value="{Binding EditorTop}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Width="440" Height="120" Padding="8,4" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{Binding KeyBrush}" Background="{DynamicResource PanelBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" /><RowDefinition Height="22" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{Binding KeyBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Left.Name, StringFormat='좌 · {0}'}"
                                               TextAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{Binding KeyBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Right.Name, StringFormat='우 · {0}'}"
                                               TextAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{Binding KeyBrush}" />
                                    <TextBlock Grid.Row="2" Text="BaseX" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" DataContext="{Binding Left}"
                                             Style="{StaticResource BaseEditValue}" Text="{Binding BaseX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="X" PreviewMouseLeftButtonDown="OpenCoordinateInput" />
                                    <TextBox Grid.Row="2" Grid.Column="3" DataContext="{Binding Right}"
                                             Style="{StaticResource BaseEditValue}" Text="{Binding BaseX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="X" PreviewMouseLeftButtonDown="OpenCoordinateInput" />
                                    <TextBlock Grid.Row="3" Text="BaseY" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" DataContext="{Binding Left}"
                                             Style="{StaticResource BaseEditValue}" Text="{Binding BaseY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Y" PreviewMouseLeftButtonDown="OpenCoordinateInput" />
                                    <TextBox Grid.Row="3" Grid.Column="3" DataContext="{Binding Right}"
                                             Style="{StaticResource BaseEditValue}" Text="{Binding BaseY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Y" PreviewMouseLeftButtonDown="OpenCoordinateInput" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Viewbox>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Save를 누르면 현재 레시피에 반영됩니다." FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CancelClicked"
                        Height="40" FontSize="15" Margin="0" Style="{StaticResource SecondaryButton}" />
                <Button x:Name="SaveButton" Grid.Column="3" Content="Save" Click="SaveClicked"
                        Height="40" FontSize="15" Margin="0" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Grid>
    </Border>
</Window>
