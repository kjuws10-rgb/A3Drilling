<Window x:Class="Drilling.UI.Popup.CFineLineDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FINE · Shot Details" Width="1180" Height="640" MinWidth="880" MinHeight="360"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title, StringFormat={}{0} · Shot Details}" FontWeight="SemiBold" FontSize="22" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Row="2" Text="{Binding ResultSummary}" Foreground="{Binding NgBrush}" FontWeight="SemiBold" Margin="0,6,0,12" />
            <DataGrid x:Name="ShotGrid" Grid.Row="3" Style="{StaticResource PlainDataGrid}" ItemsSource="{Binding ShotResults}"
                      IsReadOnly="True" CanUserResizeRows="False" CanUserReorderColumns="False" RowHeight="32" ColumnHeaderHeight="50"
                      FontSize="12" SelectionMode="Single" EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="45" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="HEAD" Binding="{Binding Head}" Width="80" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="CELL" Binding="{Binding Cell}" Width="75" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="SHOT" Binding="{Binding Shot}" Width="70" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="BEAM" Binding="{Binding BeamNo}" Width="60" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="Recv Target−Hole&#10;X" Binding="{Binding ReceivedXText}" Width="*" MinWidth="120" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="Recv Target−Hole&#10;Y" Binding="{Binding ReceivedYText}" Width="*" MinWidth="120" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="Vision Flip Convert&#10;X" Binding="{Binding ConvertedXText}" Width="*" MinWidth="125" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTextColumn Header="Vision Flip Convert&#10;Y" Binding="{Binding ConvertedYText}" Width="*" MinWidth="125" ElementStyle="{StaticResource DetailText}" />
                    <DataGridTemplateColumn Header="JUDGE" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding Judge}" Foreground="{Binding JudgeBrush}" FontWeight="Bold" Style="{StaticResource DetailText}" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="4" Content="닫기" Click="CloseClicked" IsCancel="True" HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}" Width="110" Height="36" Margin="0,12,0,0" />
        </Grid>
    </Border>
</Window>
