<Window x:Class="Drilling.UI.Popup.CCellPlacementWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cell Placement Wizard"
        Width="900"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyDown="WindowKeyDown"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="WizardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="WizardTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="WizardComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ButtonSecondaryBrush}"
            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
            BorderThickness="1"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="CELL PLACEMENT WIZARD"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="16"
                        Background="{DynamicResource GridBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="GRID PATTERN" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="CELL COUNT" Style="{StaticResource WizardLabel}" />
                        <TextBox x:Name="CellCountTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource WizardTextBox}" Margin="0,0,0,8" IsReadOnly="True" Focusable="False" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="COLUMN COUNT" Style="{StaticResource WizardLabel}" />
                        <TextBox x:Name="ColumnCountTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource WizardTextBox}" Margin="0,0,0,8" IsReadOnly="True" Cursor="Hand" TextChanged="GridCountTextChanged" PreviewMouseDown="OpenWizardInputKeypad" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ROW COUNT" Style="{StaticResource WizardLabel}" />
                        <TextBox x:Name="RowCountTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource WizardTextBox}" Margin="0,0,0,8" IsReadOnly="True" Cursor="Hand" TextChanged="GridCountTextChanged" PreviewMouseDown="OpenWizardInputKeypad" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="START X / Y" Style="{StaticResource WizardLabel}" />
                        <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StartXTextBox" Grid.Column="0" Style="{StaticResource WizardTextBox}" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="OpenWizardInputKeypad" />
                            <TextBox x:Name="StartYTextBox" Grid.Column="2" Style="{StaticResource WizardTextBox}" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="OpenWizardInputKeypad" />
                        </Grid>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="CELL PITCH X / Y" Style="{StaticResource WizardLabel}" />
                        <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PitchXTextBox" Grid.Column="0" Style="{StaticResource WizardTextBox}" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="OpenWizardInputKeypad" />
                            <TextBox x:Name="PitchYTextBox" Grid.Column="2" Style="{StaticResource WizardTextBox}" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="OpenWizardInputKeypad" />
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="DIRECTION" Style="{StaticResource WizardLabel}" />
                        <ComboBox x:Name="DirectionComboBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource WizardComboBox}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="DEFAULT MODEL" Style="{StaticResource WizardLabel}" />
                        <ComboBox x:Name="DefaultModelComboBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource WizardComboBox}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="12"
                            Background="{DynamicResource GridBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="ROW MODEL"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,12" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="RowModelItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Style="{StaticResource WizardLabel}" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding ModelOptions}"
                                                          SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource WizardComboBox}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="12"
                            Background="{DynamicResource GridBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="COLUMN MODEL"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,12" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ColumnModelItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Style="{StaticResource WizardLabel}" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding ModelOptions}"
                                                          SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource WizardComboBox}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="CANCEL"
                        Click="CancelClick"
                        Style="{StaticResource WizardButton}"
                        Background="{DynamicResource ButtonSecondaryBrush}"
                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" />
                <Button Grid.Column="2"
                        Content="APPLY"
                        Click="ApplyClick"
                        Style="{StaticResource WizardButton}"
                        Background="{DynamicResource ButtonSuccessBrush}"
                        Foreground="{DynamicResource ButtonTextOnColorBrush}"
                        BorderBrush="{DynamicResource StatusReadyBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
