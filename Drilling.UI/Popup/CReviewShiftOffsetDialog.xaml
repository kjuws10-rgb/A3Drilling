<Window x:Class="Drilling.UI.Popup.CReviewShiftOffsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Shift Offset"
        Width="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ButtonSecondaryBrush}"
            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
            BorderThickness="1"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="최근 Manual MOF의 Shift Offset을 적용하여 검사하시겠습니까?"
                       FontSize="22"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ContextText"
                       Grid.Row="1"
                       Margin="0,12,0,0"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    Padding="18"
                    Background="{DynamicResource GridBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MOF 진행 시간" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="CompletedAtText" Grid.Column="1" FontSize="17" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="SHIFT OFFSET X" Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ShiftXText" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" FontSize="19" FontWeight="Bold" />
                    <TextBlock Grid.Row="2" Text="SHIFT OFFSET Y" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ShiftYText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" FontSize="19" FontWeight="Bold" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="적용 검사"
                        Style="{StaticResource ChoiceButton}"
                        Background="{DynamicResource ButtonWarningBrush}"
                        BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                        Click="OnApplyClicked" />
                <Button Grid.Column="2"
                        Content="미적용 검사"
                        Style="{StaticResource ChoiceButton}"
                        Background="{DynamicResource ButtonSuccessBrush}"
                        BorderBrush="{DynamicResource ButtonSuccessBorderBrush}"
                        Click="OnWithoutShiftClicked" />
                <Button Grid.Column="4"
                        Content="취소"
                        Style="{StaticResource ChoiceButton}"
                        Background="{DynamicResource ButtonDangerBrush}"
                        BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                        Click="OnCancelClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
