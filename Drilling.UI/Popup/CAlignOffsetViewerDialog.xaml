<Window x:Class="Drilling.UI.Popup.CAlignOffsetViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ViewerTitle}"
        Width="1520"
        Height="920"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        KeyDown="OnKeyDown"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="OffsetCellButton" TargetType="Button">
            <Setter Property="Background" Value="#F4F7FA" />
            <Setter Property="Foreground" Value="#203446" />
            <Setter Property="BorderBrush" Value="#3F6F98" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#F6C453" />
                    <Setter Property="Foreground" Value="#17212B" />
                    <Setter Property="BorderBrush" Value="#FFF4D6" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="16"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ViewerTitle}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RecipeName, StringFormat='CURRENT RECIPE : {0}'}"
                               FontSize="13"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCellTitle}"
                               HorizontalAlignment="Right"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="{Binding SelectedShotName}"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" MinWidth="430" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="6*" MinWidth="650" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock Text="GLASS-CELL VIEW"
                                           DockPanel.Dock="Left"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Summary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding HeadCards}" Margin="0,0,0,7">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28"
                                                Margin="1"
                                                Background="{Binding Background}"
                                                BorderBrush="{Binding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{Binding Foreground}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="2"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="6">
                                <Grid ClipToBounds="True">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                    <ItemsControl ItemsSource="{Binding CellLabels}"
                                                  Style="{StaticResource CellPreviewLabelItemsControl}"
                                                  IsHitTestVisible="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="{Binding Width}"
                                                        Height="{Binding Height}"
                                                        Content="{Binding CellNo}"
                                                        Style="{StaticResource OffsetCellButton}"
                                                        ToolTip="{Binding DisplayText}"
                                                        Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding CellNo}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CELL SHOT VIEW"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedShotName}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,0,4">
                                <Ellipse Width="7" Height="7" Fill="#2DD4BF" VerticalAlignment="Center" />
                                <TextBlock Text="SHOT" Margin="4,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="×" Foreground="#F87171" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="MASKING / OFF" Margin="3,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="◆" Foreground="#C084FC" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="CHESS / OFF" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                            </WrapPanel>
                            <Border Grid.Row="2"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="4"
                                    ClipToBounds="True">
                                <Grid>
                                    <Viewbox Stretch="Uniform">
                                        <Grid x:Name="ShotMapSurface"
                                              Width="{Binding ShotMapSurfaceWidth}"
                                              Height="{Binding ShotMapSurfaceHeight}"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              MouseLeftButtonDown="SelectShotFromMap">
                                            <Image Source="{Binding ShotMapImage}" Stretch="Fill" IsHitTestVisible="False" />
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="NO CELL SELECTED"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNoSelectedCell}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OFFSET VIEW"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedCellTitle}"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedShotDetail}"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding OffsetDescription}"
                                   Margin="0,0,0,8"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Grid.Row="2">
                            <Border Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="SELECT A CELL FROM GLASS-CELL VIEW"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoSelectedCell}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <DataGrid x:Name="OffsetGrid"
                                      ItemsSource="{Binding Rows}"
                                      SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      RowHeight="48"
                                      ColumnHeaderHeight="38"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectionChanged="OffsetGrid_SelectionChanged">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoSelectedCell}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="ToolTip" Value="{Binding CoordinateDetail}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#566B7E" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#B8D5EA" />
                                                <Setter Property="BorderThickness" Value="2,0,0,1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SHOT" Binding="{Binding ShotName}" Width="82" />
                                    <DataGridTextColumn Header="HEAD" Binding="{Binding Head}" Width="64" />
                                    <DataGridTextColumn Header="DESIGN OFFSET X (mm)" Binding="{Binding DesignOffsetX}" Width="*" />
                                    <DataGridTextColumn Header="DESIGN OFFSET Y (mm)" Binding="{Binding DesignOffsetY}" Width="*" />
                                    <DataGridTemplateColumn Header="SCANNER OFFSET GX (mm)" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ScannerOffsetGx}"
                                                           Foreground="#FFB45C"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="SCANNER OFFSET GY (mm)" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ScannerOffsetGy}"
                                                           Foreground="#FFB45C"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Button Grid.Row="2"
                    Content="닫기"
                    Width="150"
                    Height="40"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="15"
                    Click="OnCloseClicked" />
        </Grid>
    </Border>
</Window>
