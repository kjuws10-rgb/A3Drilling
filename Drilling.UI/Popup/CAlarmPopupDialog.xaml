<Window x:Class="Drilling.UI.Popup.CAlarmPopupDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALARM" Width="1280" Height="600" MinWidth="850" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#FFF1F1" Foreground="#202020" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202020" />
        <SolidColorBrush x:Key="TextInvertedBrush" Color="White" />
        <SolidColorBrush x:Key="GridBackgroundBrush" Color="White" />
        <SolidColorBrush x:Key="GridAltBackgroundBrush" Color="#FFF5F5" />
        <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#B71C1C" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#E2BABA" />
        <SolidColorBrush x:Key="MenuItemSelectedBackgroundBrush" Color="#B71C1C" />
        <SolidColorBrush x:Key="MenuItemSelectedTextBrush" Color="White" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D71920" />
        <Style x:Key="AlarmButton" TargetType="Button">
            <Setter Property="Background" Value="#D71920" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B71C1C" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="3" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="AlarmFrame" BorderBrush="#D71920" BorderThickness="5" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border x:Name="AlarmHeader" Background="#D71920" Padding="16,12" Margin="0,0,0,12" CornerRadius="4">
            <StackPanel><DockPanel>
                <Button DockPanel.Dock="Right" Content="닫기" Click="CloseClicked" Width="90" Height="36" Style="{StaticResource AlarmButton}" Background="White" Foreground="#B71C1C" BorderBrush="White" />
                <TextBlock Text="ALARM" FontSize="30" FontWeight="Bold" Foreground="White" />
            </DockPanel><TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0" />
                <TextBlock Text="{Binding RecoveryStatus}" FontSize="14" Foreground="White" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="90" ToolTip="{Binding RecoveryStatus}" />
            </StackPanel>
        </Border>
        <DataGrid x:Name="AlarmGrid" Grid.Row="1" ItemsSource="{Binding Rows}" Style="{StaticResource PlainDataGrid}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" MinRowHeight="42" ColumnHeaderHeight="34" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="45" />
                <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="70" />
                <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="110" />
                <DataGridTextColumn Header="CAUSE" Binding="{Binding Cause}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="5" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="SOLUTION" Binding="{Binding Solution}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="5" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="155" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="ALARM RESET" Command="{Binding ResetCommand}" Width="180" Height="46" Style="{StaticResource AlarmButton}" />
            <TextBlock Text="원인과 조치 내용을 확인한 후 RESET하세요." VerticalAlignment="Center" FontSize="14" /></DockPanel>
    </Grid>
    </Border>
</Window>
