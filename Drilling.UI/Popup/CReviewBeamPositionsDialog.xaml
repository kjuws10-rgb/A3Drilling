<Window x:Class="Drilling.UI.Popup.CReviewBeamPositionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beam Positions"
        Width="800" Height="800" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource ButtonSecondaryBrush}"
            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
            BorderThickness="1" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Beam Positions" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="ShotSummaryText" Grid.Row="1" Margin="0,6,0,16"
                       FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            <ItemsControl x:Name="BeamItems" Grid.Row="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding GridSize}" Columns="{Binding GridSize}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3" Padding="10" CornerRadius="3" BorderThickness="1"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding BeamNo, StringFormat=Beam {0}}"
                                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Review X (mm)" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReviewXText}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ReviewXText}" />
                                <TextBlock Text="Stage Y (mm)" FontSize="12" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding StageYText}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StageYText}" />
                              </StackPanel>
                            </Viewbox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Row="3" Content="닫기" Click="OnCloseClicked" IsCancel="True"
                    HorizontalAlignment="Right" Width="130" Height="42" Margin="0,16,0,0"
                    FontSize="14" FontWeight="SemiBold"
                    Background="{DynamicResource ButtonSecondaryBrush}"
                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
    </Border>
</Window>
